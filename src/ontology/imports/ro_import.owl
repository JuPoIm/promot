    <!-- http://purl.obolibrary.org/obo/RO_0004013 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004013">
        <obo:IAO_0000115>Relates a gene to condition, such that a mutation in this gene is sufficient to produce the condition and that can be passed on to offspring[modified from orphanet].</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-05T02:56:40Z</oboInOwl:creation_date>
        <rdfs:label>is causal germline mutation in</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.orpha.net/ORDO/Orphanet_317343"/>
