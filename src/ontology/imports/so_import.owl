<http://purl.obolibrary.org/obo/promot/releases/2026-03-12/imports/so_import.owl>
Annotation(dc11:source <http://purl.obolibrary.org/obo/so/2024-11-18/so.owl>)
Annotation(owl:versionInfo "2026-03-12")

Declaration(Class(obo:SO_0001060))
Declaration(Class(obo:SO_0001762))
Declaration(Class(obo:SO_0001775))
Declaration(Class(obo:SO_0001776))
Declaration(Class(obo:SO_0001781))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(dc11:source))
Declaration(AnnotationProperty(oboInOwl:hasDbXref))


############################
#   Classes
############################

# Class: obo:SO_0001060 (sequence_variant)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "SO:ke") obo:IAO_0000115 obo:SO_0001060 "A sequence_variant is a non exact copy of a sequence_feature or genome exhibiting one or more sequence_alteration.")
AnnotationAssertion(rdfs:label obo:SO_0001060 "sequence_variant")

# Class: obo:SO_0001762 (variant_origin)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:17597783") Annotation(oboInOwl:hasDbXref "SO:ke") obo:IAO_0000115 obo:SO_0001762 "A quality inhering in a variant by virtue of its origin.")
AnnotationAssertion(rdfs:label obo:SO_0001762 "variant_origin")

# Class: obo:SO_0001775 (maternal_variant)

AnnotationAssertion(obo:IAO_0000115 obo:SO_0001775 "A variant in the genetic material inherited from the mother.")
AnnotationAssertion(rdfs:label obo:SO_0001775 "maternal_variant")
SubClassOf(obo:SO_0001775 obo:SO_0001762)

# Class: obo:SO_0001776 (paternal_variant)

AnnotationAssertion(obo:IAO_0000115 obo:SO_0001776 "A variant in the genetic material inherited from the father.")
AnnotationAssertion(rdfs:label obo:SO_0001776 "paternal_variant")
SubClassOf(obo:SO_0001776 obo:SO_0001762)

# Class: obo:SO_0001781 (de_novo_variant)

AnnotationAssertion(obo:IAO_0000115 obo:SO_0001781 "A variant arising in the offspring that is not found in either of the parents.")
AnnotationAssertion(rdfs:label obo:SO_0001781 "de_novo_variant")
SubClassOf(obo:SO_0001781 obo:SO_0001762)


)