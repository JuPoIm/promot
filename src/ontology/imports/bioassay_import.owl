AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002182> "molecular quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002182> <http://www.bioassayontology.org/bao#BAO_0002928>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000013> (primary structure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://www.bioassayontology.org/bao#BAO_0000013> "The quality of a biological macromolecule (DNA, RNA or protein), which could either be unmodified' (native) or modified, e.g., methylated, phosphorylated, etc.")
AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000013> "primary structure")
SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000013> <http://www.bioassayontology.org/bao#BAO_0000138>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000138> (molecular structure)

AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000138> "molecular structure")
SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000138> <http://purl.obolibrary.org/obo/PATO_0002182>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000643> (mutated)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://www.bioassayontology.org/bao#BAO_0000643> "Mutation is any alteration in a gene, which may be disease causing or a normal variant. Mutations are introduced into the genes and subsequently, introduced into cells for expression. Different types of mutations include missense, nonsense, deletions, insertions, etc.")
AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000643> "mutated")
SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000643> <http://www.bioassayontology.org/bao#BAO_0000013>)

# Class: <http://www.bioassayontology.org/bao#BAO_0002928> (quality)

AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0002928> "quality")


