        <owl:annotatedTarget xml:lang="fr">Arthrogrypose multiple congénitale</owl:annotatedTarget>
        <babelon:comment>label of HP:0002804 (Arthrogryposis multiplex congenita)  ; abnormality of the musculature ; abnormality of the skeletal system ; abnormality of connective tissue</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
