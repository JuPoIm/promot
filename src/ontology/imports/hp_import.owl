        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Incidents in which a piece of food or other objects get stuck in the upper airway and provoke coughing, gagging, inability to talk, and difficulty breathing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0030878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002795"/>
        <obo:IAO_0000115>Any anomaly measure by pulmonary function testing, which includes spirometry, measures of diffusing capacity, and plethysmography.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0032340</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4280728</oboInOwl:hasDbXref>
