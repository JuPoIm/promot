    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0034198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011461"/>
        <obo:IAO_0000115>This term refers to a phenotypic feature that was first observed prior to birth during the second trimester, which comprises the range of gestational ages from 14 0/7 weeks to 27 6/7 (inclusive).</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-07T16:11:04Z</dc:date>
