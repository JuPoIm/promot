    <!-- http://purl.obolibrary.org/obo/HP_6001152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain worsens with wrist ulnar or radial deviation.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10742"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Ulnar: Triangular fibrocartilage complex tear; Ulnocarpal abutment syndrome Radial: Triangular fibrocartilage complex tear.</rdfs:comment>
