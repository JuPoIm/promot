    <!-- http://purl.obolibrary.org/obo/HP_0040064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-5316-1399"/>
