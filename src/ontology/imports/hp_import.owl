        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-02-25T14:55:46Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasRelatedSynonym>Natural history of disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Clinical course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000153"/>
        <obo:IAO_0000115>A functional anomaly of the mouth (which is also known as the oral cavity).</obo:IAO_0000115>
        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-04-29T14:50:56Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>The physiological functions of the mouth include salivary gland secretory function, mastication (chewing) and preparation of food for swallowing.</rdfs:comment>
        <rdfs:label>Abnormal oral physiology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031816">
