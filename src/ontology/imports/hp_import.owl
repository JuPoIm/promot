    <!-- http://purl.obolibrary.org/obo/HP_0002098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002094"/>
        <obo:IAO_0000115>Respiratory distress is objectively observable as the physical or emotional consequences from the experience of dyspnea. The physical presentation of respiratory distress is generally referred to as labored breathing, while the sensation of respiratory distress is called shortness of breath or dyspnea.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002880</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:230145002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:267036007</oboInOwl:hasDbXref>
