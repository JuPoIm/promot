        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:KI_phemming</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012768 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002795"/>
        <obo:IAO_0000115>Respiratory failure in the newborn.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
