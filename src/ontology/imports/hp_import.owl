    <!-- http://purl.obolibrary.org/obo/HP_0030203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030201"/>
        <obo:IAO_0000115>Lack of improvement of muscle strength in response to administration of an acetylcholine esterase inhibitor.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4022580</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Unfavourable response of muscle weakness to acetylcholine esterase inhibitors</oboInOwl:hasExactSynonym>
        <rdfs:comment>An acetylcholinesterase inhibitor inhibits acetylcholinesterase from breaking down acetylcholine, thereby increasing both the level and duration of action of the neurotransmitter acetylcholine. For instance, edrophonium is a readily reversible acetylcholinesterase inhibitor that can be used to differentiate myasthenia gravis from cholinergic crisis. Edrophonium would improve muscle weakness in myasthenia gravis but not in cholinergic crisis.</rdfs:comment>
        <rdfs:label xml:lang="es">Respuesta desfavorable a la debilidad muscular de los inhibidores de la acetilcolinesterasa</rdfs:label>
        <rdfs:label xml:lang="fr">Réaction défavorable de la faiblesse musculaire aux inhibiteurs de l&apos;acétylcholine estérase.</rdfs:label>
        <rdfs:label>Unfavorable response of muscle weakness to acetylcholine esterase inhibitors</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Lack of improvement of muscle strength in response to administration of an acetylcholine esterase inhibitor.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:UK_rheller</oboInOwl:hasDbXref>
    </owl:Axiom>
