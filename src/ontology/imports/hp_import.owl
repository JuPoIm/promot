        <oboInOwl:hasDbXref>UMLS:C0013404</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0476273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Breathing difficulties</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Labored breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Laboured breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Respiratory difficulties</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002098</oboInOwl:id>
