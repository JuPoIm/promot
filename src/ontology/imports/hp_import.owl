        <owl:annotatedTarget>Pain at night.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37214788</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001608"/>
        <obo:IAO_0000115>Wet voice is a perceptual vocal quality that is gurgly or liquid sounding and is due to the voice being produced through moisture. It is commonly used as an indicator of penetration and/or aspiration in clinical swallowing assessments and bedside screening tests.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10572"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Wet voice</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_6001011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Wet voice is a perceptual vocal quality that is gurgly or liquid sounding and is due to the voice being produced through moisture. It is commonly used as an indicator of penetration and/or aspiration in clinical swallowing assessments and bedside screening tests.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25001523</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Exquisite tenderness in a specific region, beyond what one would surmise from examination.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10695"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>This finding may be observed with several diseases including necrotizing fasciitis and gas gangrene.</rdfs:comment>
        <rdfs:label>Pain disproportionate to abnormality on physical exam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain in extremity that worsens with joint is passively flexed.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10786"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>This feature may be observed in acute compartment syndrome.</rdfs:comment>
        <rdfs:label>Pain exacerbated by passive flexion at joint</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_6001148"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pain in extremity that worsens with joint is passively flexed.</owl:annotatedTarget>
