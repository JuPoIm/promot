        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#abbreviation"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115>A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2014-04-03T12:20:28Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>UMLS:C4022737</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012759</oboInOwl:id>
        <rdfs:comment>This term should be used to describe abnormalities with onset in the developmental period.</rdfs:comment>
        <rdfs:label>Neurodevelopmental abnormality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:KI_phemming</oboInOwl:hasDbXref>
    </owl:Axiom>
    


