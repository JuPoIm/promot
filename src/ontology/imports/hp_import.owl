    <!-- http://purl.obolibrary.org/obo/HP_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001507"/>
        <obo:IAO_0000115 xml:lang="fr">Écart par rapport à la moyenne de la taille d&apos;un individu, la moyenne étant déterminée selon l&apos;âge et le sexe</obo:IAO_0000115>
        <obo:IAO_0000115>Deviation from the norm of height with respect to that which is expected according to age and gender norms.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-02-27T02:20:00Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4025901</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of body height</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000002</oboInOwl:id>
        <rdfs:label xml:lang="fr">Anomalie de la taille corporelle</rdfs:label>
        <rdfs:label xml:lang="es">Anormalidad de la estatura</rdfs:label>
        <rdfs:label>Abnormality of body height</rdfs:label>
    </owl:Class>
