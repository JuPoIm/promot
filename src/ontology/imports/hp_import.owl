    <!-- http://purl.obolibrary.org/obo/HP_0033994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011968"/>
        <obo:IAO_0000115>Inability to ingest sufficient quantities of nutrition by mouth or by tube-feeding with the corresponding requirement for intravenous administration of nutrition.</obo:IAO_0000115>
        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-21T12:07:39Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Dependency on parenteral nutrition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0034045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004303"/>
        <obo:IAO_0000115>Normal muscle fibers are polygonal-shaped in cross section, are multinucleated, and have minimal amounts of endomysial connective tissue. In contrast, angulated (also known as angular) muscle fibers have long and narrow vertices (corners) with sharp edges and a pointed tip.</obo:IAO_0000115>
        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-19T16:38:38Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Angular muscle fibers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Angular muscle fibres</oboInOwl:hasExactSynonym>
        <rdfs:comment>Muscle fibers showing neurogenic atrophy are compressed by neighboring non-atrophic fibers and may show an angulated appearance on a transverse section. See Figure 3A in PMID:32529201.</rdfs:comment>
        <rdfs:label>Angulated muscle fibers</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034045"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Normal muscle fibers are polygonal-shaped in cross section, are multinucleated, and have minimal amounts of endomysial connective tissue. In contrast, angulated (also known as angular) muscle fibers have long and narrow vertices (corners) with sharp edges and a pointed tip.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22938878</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:32529201</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Angular muscle fibres</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#uk_spelling"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0034057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
        <obo:IAO_0000115>Structural or functional abnormalities of the fetus. Note that this section comprises terms that describe abnormalities that are specific to the fetus or differ from the corresponding general terms. A term from anywhere in the Human Phenotype Ontology can be applied to a fetus if appropriate.</obo:IAO_0000115>
        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-27T19:01:00Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Fetal anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0034059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034057"/>
        <obo:IAO_0000115>Any functional anomaly of the fetus.</obo:IAO_0000115>
        <dc11:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-27T19:03:33Z</dc11:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Functional fetal anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Functional foetal anomaly</oboInOwl:hasExactSynonym>
