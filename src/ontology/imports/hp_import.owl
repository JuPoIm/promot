    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115>An abnormality of movement with a neurological basis characterized by changes in coordination and speed of voluntary movements.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-05-28T11:48:50Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0001294</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:60342002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0026650</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">Mouvements anormaux</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">perturbation des mouvements</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">perturbation des mouvements|Mouvements anormaux|trouble de la motricité|troubles de la motricité</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">trouble de la motricité</oboInOwl:hasExactSynonym>
