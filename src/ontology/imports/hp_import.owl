        <oboInOwl:hasAlternativeId>HP:5200275</oboInOwl:hasAlternativeId>
        <oboInOwl:hasRelatedSynonym>Abnormal energy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Abnormal motivation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Abnormal volitional state</rdfs:label>
    </owl:Class>
    


