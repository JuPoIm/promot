        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2008-02-20T11:52:00Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>UMLS:C4025360</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Functional motor problems</oboInOwl:hasExactSynonym>
