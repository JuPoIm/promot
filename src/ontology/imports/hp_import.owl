    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011844"/>
        <obo:IAO_0000115>An abnormality of the bony pelvic girdle, which is a ring of bones connecting the vertebral column to the femurs.</obo:IAO_0000115>
