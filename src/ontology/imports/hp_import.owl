    <!-- http://purl.obolibrary.org/obo/HP_0030842 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011446"/>
        <obo:IAO_0000115>Incidents in which a piece of food or other objects get stuck in the upper airway and provoke coughing, gagging, inability to talk, and difficulty breathing.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4280747</oboInOwl:hasDbXref>
        <rdfs:label>Choking episodes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
