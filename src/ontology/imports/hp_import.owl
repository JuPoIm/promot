        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011461"/>
        <obo:IAO_0000115>This term refers to a phenotypic feature that was first observed prior to birth in the first trimester during the early fetal period, which is defined as 11 0/7 to 13 6/7 weeks of gestation (inclusive).</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-07T16:13:41Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Early fetal onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early foetal onset</oboInOwl:hasExactSynonym>
        <rdfs:label>Late first trimester onset</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034199"/>
