    <!-- http://purl.obolibrary.org/obo/HP_0003403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100285"/>
        <obo:IAO_0000115>A compound muscle action potential (CMAP) is a type of electromyography (EMG). CMAP refers to a group of almost simultaneous action potentials from several muscle fibers in the same area evoked by stimulation of the supplying motor nerve and are recorded as one multipeaked summated action potential. This abnormality refers to a greater than normal decrease in the amplitude during the course of the investigation.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003430</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0003478</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4020841</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4021728</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">EMG: decrement at repetitive stimulation|EMG: decremental response of CMAP to repetitive nerve stimulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>EMG: decremental response of CMAP to repetitive nerve stimulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>EMG: decrement at repetitive stimulation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0003403</oboInOwl:id>
        <rdfs:comment>The result of this test is abnormal if progressively fewer muscle fibers respond to nerve stimulation during a train of stimuli, thereby yielding a decrementing pattern in the CMAP.</rdfs:comment>
        <rdfs:label xml:lang="fr">EMG : Réponse décroissante du potentiel d&apos;action musculaire suite à une stimulation nerveuse répétitive</rdfs:label>
        <rdfs:label xml:lang="es">EMG: respuesta decreciente del potencial de acción muscular compuesto (CMAP) de la estimulación nerviosa repetitiva</rdfs:label>
        <rdfs:label>EMG: decremental response of compound muscle action potential to repetitive nerve stimulation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A compound muscle action potential (CMAP) is a type of electromyography (EMG). CMAP refers to a group of almost simultaneous action potentials from several muscle fibers in the same area evoked by stimulation of the supplying motor nerve and are recorded as one multipeaked summated action potential. This abnormality refers to a greater than normal decrease in the amplitude during the course of the investigation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003403"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">EMG : Réponse décroissante du potentiel d&apos;action musculaire suite à une stimulation nerveuse répétitive</owl:annotatedTarget>
        <babelon:comment>label of HP:0003403 (EMG: decremental response of compound muscle action potential to repetitive nerve stimulation)  ; abnormality of the musculature</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: decremental response of compound muscle action potential to repetitive nerve stimulation</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
