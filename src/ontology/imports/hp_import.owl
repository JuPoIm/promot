        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034241"/>
        <obo:IAO_0000115>A pregnancy that ends at a stage in which the fetus is incapable of surviving on its own, defined as the spontaneous loss of a fetus before the 22th week of pregnancy.</obo:IAO_0000115>
