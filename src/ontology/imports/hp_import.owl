    <!-- http://purl.obolibrary.org/obo/HP_6001203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>A popping or snapping sensation (noise or feeling) at the time of an injury.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/9914"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Sudden snapping or popping at the time of an injury can be a sign of significant damage to muscles, tendons, ligaments, or bones.</rdfs:comment>
        <rdfs:label>Snapping sensation at time of injury</rdfs:label>
    </owl:Class>
