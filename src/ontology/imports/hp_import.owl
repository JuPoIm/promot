    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100729"/>
        <obo:IAO_0000115>Facial height (length) is more than 2 standard deviations above the mean (objective); or, an apparent increase in the height (length) of the face (subjective).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000334</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1836047</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Elongation of face</oboInOwl:hasExactSynonym>
