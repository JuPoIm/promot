     xmlns:void="http://rdfs.org/ns/void#"
     xmlns:CPONT="https://w3id.org/cpont/vocab/CPONT_"
     xmlns:MONDO="http://purl.obolibrary.org/obo/MONDO_"
     xmlns:chebi="http://purl.obolibrary.org/obo/chebi/"
     xmlns:sssom="https://w3id.org/sssom/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:PROMOT="http://purl.obolibrary.org/obo/PROMOT_"
     xmlns:SNOMED="http://snomed.info/id/"
     xmlns:WHOFIC="http://id.who.int/icd/entity/"
     xmlns:schema="http://schema.org/"
     xmlns:BIOLINK="https://w3id.org/biolink/vocab/"
     xmlns:omoprel="https://w3id.org/cpont/omop/relations/"
     xmlns:subsets="http://purl.obolibrary.org/obo/ro/subsets#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:omoptype="https://w3id.org/cpont/omop/types/"
     xmlns:resource="http://semanticscience.org/resource/"
     xmlns:NCBITaxon="http://purl.obolibrary.org/obo/NCBITaxon_"
     xmlns:ncbitaxon="http://purl.obolibrary.org/obo/ncbitaxon#"
     xmlns:omopclass="https://w3id.org/cpont/omop/classes/"
     xmlns:ace_lexicon="http://attempto.ifi.uzh.ch/ace_lexicon#"
     xmlns:uberon_core="http://purl.obolibrary.org/obo/uberon/core#"
     xmlns:CPATH_PERSON="https://w3id.org/cpont/person/"
     xmlns:CPATH_CARE_SITE="https://w3id.org/cpont/care_site/"
     xmlns:CPATH_MEASUREMENT="https://w3id.org/cpont/measurement/"
     xmlns:CPATH_VISIT_OCCURRENCE="https://w3id.org/cpont/visit_occurrence/"
     xmlns:CPATH_CONDITION_OCCURRENCE="https://w3id.org/cpont/condition_occurrence/">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/promot/imports/sio_import.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/promot/releases/2025-12-12/imports/sio_import.owl"/>
        <owl:versionInfo>2025-12-12</owl:versionInfo>
    </owl:Ontology>
    


