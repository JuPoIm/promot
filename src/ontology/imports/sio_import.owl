    <!-- http://semanticscience.org/resource/SIO_000495 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000495">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000272"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000495</dc11:identifier>
        <terms:description xml:lang="en">is dissimilar to is a relation between two entities in which one is considered dissimilar to the other based on some criteria.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is dissimilar to</rdfs:label>
