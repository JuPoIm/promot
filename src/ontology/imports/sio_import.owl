    <!-- http://semanticscience.org/resource/SIO_000475 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000475">
        <dc:identifier>SIO_000475</dc:identifier>
        <terms:description xml:lang="en">A biological quality is a quality held by a biological entity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">biological quality</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000784 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000784">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001405"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_010048"/>
        <dc:identifier>SIO_000784</dc:identifier>
        <terms:description xml:lang="en">hermaphrodite is a biological sex of an individual with both male and female sexual organs.</terms:description>
        <resource:equivalentTo>PATO:0001827</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">hermaphrodite</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000954 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000954">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010058"/>
        <dc:identifier>SIO_000954</dc:identifier>
        <terms:description xml:lang="en">sick is the status of a living organism that is behaving at a sub-optimal level.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">sick</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001012 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001012">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010058"/>
        <dc:identifier>SIO_001012</dc:identifier>
        <terms:description xml:lang="en">healthy is an organismal state of complete physical, mental and social well-being.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">healthy</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001014 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001014">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000475"/>
        <dc:identifier>SIO_001014</dc:identifier>
        <terms:description xml:lang="en">ethnicity is the biological quality of membership in a social group based on a common heritage.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">ethnicity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001405 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001405">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010029"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_010052"/>
        <dc:identifier>SIO_001405</dc:identifier>
        <terms:description xml:lang="en">intersex is a biological sex characterised by birth with genitalia and/or secondary sexual characteristics of indeterminate sex, or which combine features of both sexes.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">intersex</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010029 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010029">
        <dc:identifier>SIO_010029</dc:identifier>
        <terms:description xml:lang="en">biological sex is the quality of a biological organism based on reproductive function or organs.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">biological sex</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010048 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010048">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010029"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_010052"/>
        <dc:identifier>SIO_010048</dc:identifier>
        <terms:description xml:lang="en">male is a biological sex of an individual with male sexual organs.</terms:description>
        <resource:equivalentTo>PATO:0000384</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">male</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010052 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010052">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010029"/>
        <dc:identifier>SIO_010052</dc:identifier>
        <terms:description xml:lang="en">female is a biological sex of an individual with female sexual organs.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">female</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010057 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010057">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
