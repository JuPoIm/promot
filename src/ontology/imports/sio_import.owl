        <dc11:identifier>SIO_000218</dc11:identifier>
        <terms:description xml:lang="en">is quality of is a relation between a quality and the entity that it is a property of.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is quality of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000229 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000229">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc11:identifier>SIO_000229</dc11:identifier>
        <terms:description xml:lang="en">has output is a relation between an process and an entity, where the entity is present at the end of the process.</terms:description>
        <resource:subset>core</resource:subset>
        <resource:subset xml:lang="en">sadi</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000235 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000235">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
