        <dc11:identifier>SIO_000235</dc11:identifier>
        <terms:description xml:lang="en">has disposition is the relation between an entity and a disposition that it bears.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has disposition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000236 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000236">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000646"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <dc11:identifier>SIO_000236</dc11:identifier>
        <terms:description xml:lang="en">is disposition of is a relation between a disposition and the entity that it is a property of.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is disposition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000240 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000240">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000203"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000240</dc11:identifier>
        <terms:description xml:lang="en">is positionally before is a relation between entities placed on a dimensional axis in which the projection of the position of the first entity is numerically less than the projection of the position of the second entity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is positionally before</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000241 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000241">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000211"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000652"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000242"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <dc11:identifier>SIO_000241</dc11:identifier>
        <terms:description xml:lang="en">is directly after is a relation between entities placed on a dimensional axis in which the projection of the position of the first entity is numerically greater than the projection of the position of the second entity, and the entities are adjacent to one another.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is directly after</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000242 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000242">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000240"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000652"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <dc11:identifier>SIO_000242</dc11:identifier>
        <terms:description xml:lang="en">is directly before is a relation between entities placed on a dimensional axis in which the projection of the position of the first entity is numerically less than the projection of the position of the second entity, and the entities are adjacent to one another.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is directly before</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000243 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000243">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000243</dc11:identifier>
        <terms:description xml:lang="en">A transitive, symmetric, temporal relation in which one entity is causally related with another non-identical entity.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is causally related with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000244 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000244">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000352"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000245"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000244</dc11:identifier>
        <terms:description xml:lang="en">A transitive temporal relation in which one entity was materially formed from another non-identical entity.</terms:description>
        <resource:equivalentTo>OBO_REL:derives_from</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is derived from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000245 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000245">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000294"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000245</dc11:identifier>
        <terms:description xml:lang="en">a derives to b if and only if a or some part thereof is consumed in the formation of b.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">derives into</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000246 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000246">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000245"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000247"/>
        <dc11:identifier>SIO_000246</dc11:identifier>
        <terms:description xml:lang="en">a immediately derives into b if and only if a or some significant part thereof is consumed in the formation of b and there are no identifiable intermediate entities between a and b.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">immediately derives into</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000247 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000247">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000244"/>
        <dc11:identifier>SIO_000247</dc11:identifier>
        <terms:description xml:lang="en">A non-transitive temporal relation in which one entity is immediately derived from a non-identical entity such that there are no intermediate entities between them.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is immediately derived from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000248 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000248">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000352"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000249"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000248</dc11:identifier>
        <terms:description xml:lang="en">A transitive, temporal relation in which one process precedes (has occured earlier than) another process.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000249 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000249">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000294"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000249</dc11:identifier>
        <resource:equivalentTo>OBO_REL:preceded_by</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is preceded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000250 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000250">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000248"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000251"/>
        <dc11:identifier>SIO_000250</dc11:identifier>
        <terms:description xml:lang="en">A non-transitive temporal relation in which one process immediately precedes another process, such that there is no interval of time between the two processes.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">immediately precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000251 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000251">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000249"/>
        <dc11:identifier>SIO_000251</dc11:identifier>
        <terms:description xml:lang="en">A non-transitive temporal relation in which one process is immediately preceded by another process, such that there is no interval of time between the two processes.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is immediately preceded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000252 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000252">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000212"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <dc11:identifier>SIO_000252</dc11:identifier>
        <terms:description xml:lang="en">is reference for is a relation between a document that provides information about an entity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is referenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000253 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000253">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <dc11:identifier>SIO_000253</dc11:identifier>
        <terms:description xml:lang="en">has source is a relation between an entity and another entity from which it stems from.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000254 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000254">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000255"/>
        <dc11:identifier>SIO_000254</dc11:identifier>
        <terms:description xml:lang="en">is annotation of is a relation between some textual entity and the entity that it annotates.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is annotation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000255 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000255">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <dc11:identifier>SIO_000255</dc11:identifier>
        <terms:alternative xml:lang="en">is annotated with</terms:alternative>
        <terms:alternative xml:lang="en">was annotated with</terms:alternative>
        <terms:description xml:lang="en">has annotation is a relation between an entity and some textual anntotation.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has annotation</rdfs:label>
        <skos:example xml:lang="en">document x is annotated with the keywords &apos;ontology&apos;,&apos;semantic web&apos;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000272 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000272">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000736"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000272</dc11:identifier>
        <terms:description xml:lang="en">is variant of: a relationship indicating that two entities are different (by some measure), but either achieve the same objectives in different ways or are permutations of one another (temporal, logical or otherwise)</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is variant of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000273 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000273">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000053"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000310"/>
        <dc11:identifier>SIO_000273</dc11:identifier>
        <terms:description xml:lang="en">has direct part is a relation to specify a part at a particular level of granularity</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has direct part</rdfs:label>
        <skos:example xml:lang="en">a car has an engine as a direct part</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000274 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000274">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000244"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000497"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000286"/>
        <dc11:identifier>SIO_000274</dc11:identifier>
        <terms:description xml:lang="en">A is prior version of B iff A is a variant of B and B derives from A.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is prior version of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000277 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000277">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000631"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000278"/>
        <dc11:identifier>SIO_000277</dc11:identifier>
        <terms:description xml:lang="en">cites is a relation to refer to by way of example, authority or proof.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">cites</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000278 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000278">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000252"/>
        <dc11:identifier>SIO_000278</dc11:identifier>
        <terms:description xml:lang="en">is cited by is a relation from an object that is referred to by way of example, authority or proof.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is cited by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000283 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000283">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000272"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000283</dc11:identifier>
        <terms:description xml:lang="en">is similar to is a relation between two entities that share one or more features.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is similar to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000286 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000286">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000497"/>
        <dc11:identifier>SIO_000286</dc11:identifier>
        <terms:description xml:lang="en">A is subsequent version of B iff A is a variant of B and A derives from B.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is subsequent version of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000288 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000288">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000203"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000288</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is covalently connected to (transitive)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000291 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000291">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000230"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000292"/>
        <dc11:identifier>SIO_000291</dc11:identifier>
        <terms:description xml:lang="en">has target is a relation between a process and an entity, where the entity is present at the beginning  of the process and undergoes a change or transformation in the process.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has target</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000292 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000292">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000231"/>
        <dc11:identifier>SIO_000292</dc11:identifier>
        <terms:description xml:lang="en">is target in is a relation between an entity and a process, where the entity is present at the beginning  of the process and undergoes a change or transformation in the process.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is target in</rdfs:label>
        <skos:example xml:lang="en">glucose is a target in the hexokinase-mediated conversion of glucose to glucose-6-phosphate.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000293 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000293">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000203"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000293</dc11:identifier>
        <terms:description xml:lang="en">is weakly interacting with is a symmetric relation between two molecular entities (or any part thereof) that are interacting through some weak force (van der waals, hydrogen bonds, electrostatic interactions)</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is weakly interacting with (transitive)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000294 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000294">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000243"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000352"/>
        <dc11:identifier>SIO_000294</dc11:identifier>
        <terms:description xml:lang="en">a is causally related to b iff there is a causal chain of events from a to b</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is causally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000310 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000310">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <dc11:identifier>SIO_000310</dc11:identifier>
        <terms:description xml:lang="en">is direct part of is a relation between a specific part (at some level of granularity) and its whole.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is direct part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000311 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000311">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000232"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000312"/>
        <dc11:identifier>SIO_000311</dc11:identifier>
        <terms:description xml:lang="en">is product of is a relation between an entity and a process, where the entity is present at the end  of the process as a result of a transformation in the process target.</terms:description>
        <resource:subset xml:lang="en">sadi</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is product of</rdfs:label>
        <skos:example xml:lang="en">glucose-6-phosphate is the product of the hexokinase-mediated conversion of glucose to glucose-6-phosphate.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000312 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000312">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000229"/>
        <dc11:identifier>SIO_000312</dc11:identifier>
        <terms:description xml:lang="en">has product is a relation between an process and an entity, where a new entity exists at the end of the process.</terms:description>
        <resource:subset xml:lang="en">sadi</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000313 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000313">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000310"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000369"/>
        <dc11:identifier>SIO_000313</dc11:identifier>
        <terms:description xml:lang="en">is component part of is a relation between a component and a whole, where the component is instrinsic to the whole, and loss of the part would change the kind that the whole is.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is component part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000322 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000322">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000322</dc11:identifier>
        <terms:description xml:lang="en">A is spatiotemporally related to B iff A is in the spatial or temporal vicinity of B</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is spatiotemporally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000323 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000323">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000128"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000324"/>
        <dc11:identifier>SIO_000323</dc11:identifier>
        <terms:description xml:lang="en">A &apos;is surrounded by&apos; B iff the A &apos;is contained by&apos; B and A &apos;is adjacent to&apos; B or A &apos;is directly connected to&apos; B.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is surrounded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000324 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000324">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000202"/>
        <dc11:identifier>SIO_000324</dc11:identifier>
        <terms:description xml:lang="en">A &apos;surrounds&apos; B iff the A &apos;contains&apos; B and A &apos;is adjacent to&apos; B or A &apos;is directly connected to&apos; B.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">surrounds</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000325 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000325">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000325"/>
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000068"/>
        </owl:propertyChainAxiom>
        <dc11:identifier>SIO_000325</dc11:identifier>
        <terms:description xml:lang="en">A overlaps with B iff there is some C that is part of both A and B. [S][R]</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">overlaps with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000332 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000332">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000563"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000629"/>
        <dc11:identifier>SIO_000332</dc11:identifier>
        <terms:description xml:lang="en">is about is a relation between an information content entity and the entity that its primary subject.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000334 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000334">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000288"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000652"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000334</dc11:identifier>
        <terms:description xml:lang="en">is covalently connected to is a relation between an atom and another atom.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is covalently connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000335 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000335">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000293"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000652"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000335</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is weakly interacting with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000338 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000338">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000243"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000563"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000339"/>
        <dc11:identifier>SIO_000338</dc11:identifier>
        <terms:description xml:lang="en">A relation between an information content entity and a product that it (directly/indirectly) specifies</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">specifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000339 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000339">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000243"/>
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000557"/>
        <dc11:identifier>SIO_000339</dc11:identifier>
        <terms:description xml:lang="en">a relation between a product and the information content entity that specifies it.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is specified by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000341 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000341">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000425"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000426"/>
        <dc11:identifier>SIO_000341</dc11:identifier>
        <terms:description xml:lang="en">is manifested as is a relation between an expression and its manifestations.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is manifested as</rdfs:label>
        <skos:example xml:lang="en">the english language version of &apos;war of the worlds&apos; is manifested as a collection of english language versions of the book.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000352 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000352">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000243"/>
        <dc11:identifier>SIO_000352</dc11:identifier>
        <terms:description xml:lang="en">a is causally related from b iff there is a causal chain of events from b to a</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is causally related from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000355 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000355">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000229"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000356"/>
        <dc11:identifier>SIO_000355</dc11:identifier>
        <terms:description xml:lang="en">realizes is a relation between a process and a realizable entity (role, function, disposition).</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">realizes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000356 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000356">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000062"/>
        <dc11:identifier>SIO_000356</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is realized in</rdfs:label>
        <skos:example xml:lang="en">the role of a patient is realized in medical examination</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000362 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000362">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000363"/>
        <dc11:identifier>SIO_000362</dc11:identifier>
        <terms:description xml:lang="en">satisfies is a relation between an entity and the specification or objective that it conforms to.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">satisfies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000363 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000363">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <dc11:identifier>SIO_000363</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is satisfied by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000364 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000364">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000253"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000365"/>
        <dc11:identifier>SIO_000364</dc11:identifier>
        <terms:alternative xml:lang="en">is created by</terms:alternative>
        <terms:alternative xml:lang="en">was created by</terms:alternative>
        <terms:description xml:lang="en">has creator is a relation between an entity and that which created it.</terms:description>
        <resource:equivalentTo>dc:creator</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has creator</rdfs:label>
        <skos:example xml:lang="en">the iPhone was created by Apple Inc</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000365 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000365">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000219"/>
        <dc11:identifier>SIO_000365</dc11:identifier>
        <terms:alternative xml:lang="en">is created by</terms:alternative>
        <terms:description xml:lang="en">is creator of is a relation between a creator and an entity..</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is creator of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000369 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000369">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000273"/>
        <dc11:identifier>SIO_000369</dc11:identifier>
        <terms:description xml:lang="en">has component part is a relation between a whole and a component part where the component is instrinsic to the whole, and loss of the part would change the kind that it is.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has component part</rdfs:label>
        <skos:example xml:lang="en">a human has blood as a component part</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000420 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000420">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000425"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000421"/>
        <dc11:identifier>SIO_000420</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has expression</rdfs:label>
        <skos:example xml:lang="en">the story &apos;war of worlds&apos; is expressed as every language edition of the book &apos;war of the worlds&apos;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000421 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000421">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000425"/>
        <dc11:identifier>SIO_000421</dc11:identifier>
        <terms:description xml:lang="en">is expression of is a relation between more concrete expression of some conceptualization.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is expression of</rdfs:label>
        <skos:example xml:lang="en">every language edition of &apos;war of the worlds&apos; are expressions of the story of &apos;war of the worlds&apos;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000422 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000422">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000283"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000424"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000422</dc11:identifier>
        <terms:description xml:lang="en">A is broader than B (t) iff for A is broader than B.</terms:description>
        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#narrowerTransitive</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is broader than (t)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000424 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000424">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000283"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc11:identifier>SIO_000424</dc11:identifier>
        <terms:description xml:lang="en">A is narrower than B (t) iff for A is narrower than B.</terms:description>
        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#broaderTransitive</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is narrower than (t)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000425 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000425">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc11:identifier>SIO_000425</dc11:identifier>
        <terms:description xml:lang="en">A is generically related with B iff A is an abstract entity or an information content entity and B is a information content entity or a physical entity, respectively.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is generically related with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000426 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000426">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000425"/>
        <dc11:identifier>SIO_000426</dc11:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is manifestation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000427 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000427">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000424"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000477"/>
        <dc11:identifier>SIO_000427</dc11:identifier>
        <terms:description xml:lang="en">A is narrower than B iff the meaning of term A is narrower in scope than the meaning of term B</terms:description>
        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#broader</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is narrower than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000477 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000477">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000422"/>
        <dc11:identifier>SIO_000477</dc11:identifier>
        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#narrower</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is broader than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000482 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000482">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000283"/>
