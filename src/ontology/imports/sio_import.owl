        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#relatedMatch</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is match to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000484 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000484">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000482"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc11:identifier>SIO_000484</dc11:identifier>
        <resource:equivalentTo>http://www.w3.org/2004/02/skos/core#exactMatch</resource:equivalentTo>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is exact match to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000490 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000490">
