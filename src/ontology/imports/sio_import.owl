    <!-- http://semanticscience.org/resource/SIO_000475 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000475">
        <dc11:identifier>SIO_000475</dc11:identifier>
        <terms:description xml:lang="en">A biological quality is a quality held by a biological entity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">biological quality</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000954 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000954">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010058"/>
        <dc11:identifier>SIO_000954</dc11:identifier>
        <terms:description xml:lang="en">sick is the status of a living organism that is behaving at a sub-optimal level.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">sick</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001012 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001012">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010058"/>
        <dc11:identifier>SIO_001012</dc11:identifier>
        <terms:description xml:lang="en">healthy is an organismal state of complete physical, mental and social well-being.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">healthy</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001268 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001268">
        <dc11:identifier>SIO_001268</dc11:identifier>
        <terms:description>parental transmition is the quality of a biological organism in which the (genetic) material is transmitted from a parental unit.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">parental transmission</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001269 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001269">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001268"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_001270"/>
        <dc11:identifier>SIO_001269</dc11:identifier>
        <terms:description>maternally transmitted is the quality of a biological organism in which the (genetic) material is transmitted from the maternal line.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">maternally transmitted</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001270 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001270">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001268"/>
        <dc11:identifier>SIO_001270</dc11:identifier>
        <terms:description>paternally transmitted is the quality of a biological organism in which the (genetic) material is transmitted from the paternal line.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">paternally transmitted</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010000 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010000">
        <dc11:identifier>SIO_010000</dc11:identifier>
        <terms:description xml:lang="en">A biological organisn is a biological entity that consists of one or more cells and is capable of genomic replication (independently or not).</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">organism</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010057 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010057">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010058"/>
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010059"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <dc11:identifier>SIO_010057</dc11:identifier>
        <terms:description xml:lang="en">life status is the quality of whether something is alive or dead.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">life status</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010058 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010058">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010057"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_010059"/>
        <dc11:identifier>SIO_010058</dc11:identifier>
        <terms:description xml:lang="en">alive is the state of a biological organism that exhibits biological functions.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">alive</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_010059 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_010059">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010057"/>
        <dc11:identifier>SIO_010059</dc11:identifier>
        <terms:description xml:lang="en">dead is the quality of an object in which there is a cessation of all biological functions.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">dead</rdfs:label>
    </owl:Class>
