        <schema:exclusion xml:lang="en">Drinking</schema:exclusion>
        <schema:exclusion xml:lang="en">Preparing meals</schema:exclusion>
        <skos:definition xml:lang="en">Carrying out the coordinated tasks and actions of eating food that has been served, bringing it to the mouth and consuming it in culturally acceptable ways, cutting or breaking food into pieces, opening containers and packets, using eating implements, having meals, feasting or dining.</skos:definition>
        <skos:prefLabel xml:lang="en">Eating</skos:prefLabel>
    </owl:Class>
