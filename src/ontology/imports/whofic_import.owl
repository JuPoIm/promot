    <!-- http://id.who.int/icd/entity/1090716697 -->

    <owl:Class rdf:about="http://id.who.int/icd/entity/1090716697">
        <rdfs:subClassOf rdf:resource="http://id.who.int/icd/entity/2031311308"/>
        <schema:browserUrl rdf:resource="https://icd.who.int/dev11/f/en#/http%3A%2F%2Fid.who.int%2Ficd%2Fentity%2F1090716697"/>
        <schema:inclusion xml:lang="en">cooperation of both eyes</schema:inclusion>
        <schema:inclusion xml:lang="en">fixation of the eye</schema:inclusion>
        <schema:inclusion xml:lang="en">tracking movements of the eye</schema:inclusion>
        <schema:inclusion xml:lang="en">voluntary movements of the eye</schema:inclusion>
        <schema:narrowerTerm xml:lang="en">cooperation of both eyes</schema:narrowerTerm>
        <schema:narrowerTerm xml:lang="en">fixation of the eye</schema:narrowerTerm>
        <schema:narrowerTerm xml:lang="en">tracking movements of the eye</schema:narrowerTerm>
        <schema:narrowerTerm xml:lang="en">voluntary movements of the eye</schema:narrowerTerm>
        <rdfs:label xml:lang="en">Functions of external muscles of the eye</rdfs:label>
        <skos:definition xml:lang="en">Functions of the muscles that are used to look in different directions, to follow an object as it moves across the visual field, to produce saccadic jumps to catch up with a moving target, and to fix the eye.</skos:definition>
    </owl:Class>
    


