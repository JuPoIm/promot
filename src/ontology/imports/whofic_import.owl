    <!-- http://id.who.int/icd/entity/1328675264 -->

    <owl:Class rdf:about="http://id.who.int/icd/entity/1328675264">
        <rdfs:subClassOf rdf:resource="http://id.who.int/icd/entity/1394728112"/>
        <rdfs:subClassOf rdf:resource="http://id.who.int/icd/entity/861284911"/>
