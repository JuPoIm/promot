        <schema:narrowerTerm xml:lang="en">righting reactions</schema:narrowerTerm>
        <schema:narrowerTerm xml:lang="en">supporting reactions</schema:narrowerTerm>
        <skos:definition xml:lang="en">Functions of involuntary contractions of large muscles or the whole body induced by body position, balance and threatening stimuli.</skos:definition>
        <skos:prefLabel xml:lang="en">Involuntary movement reaction functions</skos:prefLabel>
    </owl:Class>
