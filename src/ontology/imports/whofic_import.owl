        <schema1:narrowerTerm xml:lang="en">righting reactions</schema1:narrowerTerm>
        <schema1:narrowerTerm xml:lang="en">supporting reactions</schema1:narrowerTerm>
        <obo:IAO_0000115 xml:lang="en">Functions of involuntary contractions of large muscles or the whole body induced by body position, balance and threatening stimuli.</obo:IAO_0000115>
