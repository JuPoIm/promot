        <schema1:inclusion xml:lang="en">righting reactions</schema1:inclusion>
        <schema1:inclusion xml:lang="en">supporting reactions</schema1:inclusion>
        <schema1:narrowerTerm xml:lang="en">balance reactions</schema1:narrowerTerm>
        <schema1:narrowerTerm xml:lang="en">body adjustment reactions</schema1:narrowerTerm>
