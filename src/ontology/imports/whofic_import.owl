        <skos:altLabel xml:lang="en">performance restriction, not applicable </skos:altLabel>
        <skos:altLabel xml:lang="en">problem, not applicable </skos:altLabel>
        <skos:altLabel xml:lang="en">restriction, not applicable </skos:altLabel>
