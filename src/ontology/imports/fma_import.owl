    <!-- http://purl.org/sig/ont/fma/fma7501 -->

    <owl:Class rdf:about="http://purl.org/sig/ont/fma/fma7501">
        <rdfs:subClassOf rdf:resource="http://purl.org/sig/ont/fma/fma7490"/>
        <fma:FMAID rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7501</fma:FMAID>
        <fma:definition>Joint in which the articulating bones or cartilages are connected by an articular capsule which encloses a synovial membrane and a synovial cavity. Examples: Temporomandibular joint, knee joint.</fma:definition>
        <fma:non-English_equivalent>Articulation synoviale</fma:non-English_equivalent>
        <fma:non-English_equivalent>Diarthrosis</fma:non-English_equivalent>
        <fma:non-English_equivalent>Junctura synovialis</fma:non-English_equivalent>
        <fma:preferred_name>Synovial joint</fma:preferred_name>
        <fma:synonym>Articulatio synoviale</fma:synonym>
        <rdfs:label xml:lang="en">Synovial joint</rdfs:label>
