    <!-- http://purl.org/sig/ont/fma/fma7490 -->

    <owl:Class rdf:about="http://purl.org/sig/ont/fma/fma7490">
        <rdfs:subClassOf rdf:resource="http://purl.org/sig/ont/fma/fma305751"/>
        <fma:FMAID rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7490</fma:FMAID>
        <fma:definition>Anatomical junction which consists of parts of two or more adjacent bones or cartilages which are interconnected by organs and/or organ parts that consist of various types of connective tissue. Together with other joints and bones, a joint constitutes the skeletal system. Examples: pubic symphysis, knee joint, temporomandibular joint.</fma:definition>
        <fma:non-English_equivalent>Jointure</fma:non-English_equivalent>
        <fma:non-English_equivalent>Junctura</fma:non-English_equivalent>
        <fma:non-English_equivalent>Kasu-kasuan</fma:non-English_equivalent>
        <fma:preferred_name>Joint</fma:preferred_name>
        <rdfs:label xml:lang="en">Joint</rdfs:label>
    </owl:Class>
