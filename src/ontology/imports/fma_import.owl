    <!-- http://purl.org/sig/ont/fma/fma67498 -->

    <owl:Class rdf:about="http://purl.org/sig/ont/fma/fma67498">
        <rdfs:subClassOf rdf:resource="http://purl.org/sig/ont/fma/fma305751"/>
        <fma:FMAID rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">67498</fma:FMAID>
        <fma:definition>Anatomical structure, each instance of which has a maximal complement of instances of  two or more types of tissue or one or more types of essential morphologic unit, a predominantly bona fide boundary and intrinsic vasculature and neural network. Examples: liver, lung, kidney, stomach, urinary bladder, gall bladder.</fma:definition>
        <fma:non-English_equivalent>Organe</fma:non-English_equivalent>
        <fma:non-English_equivalent>Organo</fma:non-English_equivalent>
        <fma:non-English_equivalent>Órgano</fma:non-English_equivalent>
        <fma:preferred_name>Organ</fma:preferred_name>
        <rdfs:comment>Old definition: Anatomical structure which has as its direct parts portions of two or more types of tissue or two or more types of cardinal organ part which constitute a maximally connected anatomical structure demarcated predominantly by a bona fide anatomical surface. Examples: femur, biceps brachii, liver, heart, skin, tracheobronchial tree, ovary.</rdfs:comment>
        <rdfs:label xml:lang="en">Organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/sig/ont/fma/fma67498"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/sig/ont/fma/non-English_equivalent"/>
        <owl:annotatedTarget>Organe</owl:annotatedTarget>
        <fma:Date_entered_modified>Thu Dec 09 13:48:42 GMT-08:00 2004</fma:Date_entered_modified>
