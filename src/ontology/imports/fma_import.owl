    <!-- http://purl.obolibrary.org/obo/FMA_7490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7490">
        <obo:IAO_0000115>Heterogeneous cluster which consists of two or more adjacent bones or cartilages, parts of  which are interconnected by organ parts that consist of various types of connective tissue. Together with other joints and bones, a joint constitutes the skeletal system. Examples: pubic symphysis, knee joint, temporomandibular joint.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7490</oboInOwl:id>
        <rdfs:label>Joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7490"/>
        <obo:IAO_0000115>Joint in which the articulating bones or cartilages are connected by ligaments or fibrocartilage without an intervening synovial cavity. Examples: sagittal suture, inferior tibiofibular syndesmosis, costochondral joint, pubic symphysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Solid joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7491</oboInOwl:id>
        <rdfs:label>Nonsynovial joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7491"/>
        <obo:IAO_0000115>Nonsynovial joint in which the articulating bones or cartilages are connected by ligaments. Examples: sagittal suture, inferior tibiofibular syndesmosis, gomphosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Articulatio fibrosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7492</oboInOwl:id>
        <rdfs:label>Fibrous joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7492"/>
        <obo:IAO_0000115>Fibrous joint in which the articulating bones or cartilages of the skull are connected by sutural ligaments (scant amount of collagenous dense connective tissue). Examples: sagittal suture, frontal suture.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7493</oboInOwl:id>
        <rdfs:label>Suture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7492"/>
        <obo:IAO_0000115>Fibrous joint in which the articulating bones or cartilages of the vertebral column and the limbs as well as articulating ossicles, are connected by skeletal ligaments or membranes. Examples: Intervertebral syndesmosis, inferior tibiofibular joint.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7494</oboInOwl:id>
        <rdfs:label>Syndesmosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7495 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7492"/>
        <obo:IAO_0000115>Fibrous joint in which the periodontal ligament connects a tooth to the alveolar bone of the maxilla or mandible. Examples: Dento-alveolar joint of incisor tooth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dento-alveolar syndesmosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peg-and-socket joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Socket</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7495</oboInOwl:id>
        <rdfs:label>Dento-alveolar joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7491"/>
        <obo:IAO_0000115>Nonsynovial joint in which the articulating bones or cartilages are connected by cartilage. Examples: Spheno-occipital synchondrosis, first sternocostal joint, pubic symphysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Articulatio cartilaginea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7496</oboInOwl:id>
        <rdfs:label>Cartilaginous joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7496"/>
        <obo:IAO_0000115>Cartilaginous joint in which the articulating bones or cartilages are connected by hyaline cartilage. Examples: spheno-occipital synchondrosis, first sternocostal joint.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Epiphysial cartilage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary cartilaginous joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7497</oboInOwl:id>
        <rdfs:label>Synchondrosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7496"/>
        <obo:IAO_0000115>Cartilaginous joint in which the articulating bones or cartilages are connected by fibrocartilage. Examples: pubic symphysis, intervertebral symphysis, manubriosternal joint.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Secondary cartilaginous joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7498</oboInOwl:id>
        <rdfs:label>Symphysis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7491"/>
        <obo:IAO_0000115>Nonsynovial joint in which the articulating bones are connected by bone. Examples: epiphyseal junction, manubriosternal synostosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bony union</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7499</oboInOwl:id>
        <rdfs:label>Synostosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7490"/>
        <obo:IAO_0000115>Joint in which the articulating bones or cartilages are connected by an articular capsule which encloses a synovial membrane and a synovial cavity. Examples: Temporomandibular joint, knee joint.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Articulatio synoviale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7501</oboInOwl:id>
        <rdfs:label>Synovial joint</rdfs:label>
    </owl:Class>
    


