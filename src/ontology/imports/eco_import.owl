    <!-- http://purl.obolibrary.org/obo/ECO_0006151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006151">
        <obo:IAO_0000115>A type of evidence in which information is recorded in some documentation system, for example, but not limited to a publication, survey, or medical record.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006151</oboInOwl:id>
        <rdfs:label>documented statement evidence</rdfs:label>
    </owl:Class>
