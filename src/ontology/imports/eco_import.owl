    <!-- http://purl.obolibrary.org/obo/ECO_0006152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006151"/>
        <obo:IAO_0000115>A type of documented statement evidence in which information is stated by a health care professional, for example, but not limited to a doctor, nurse, or psychologist.</obo:IAO_0000115>
