    <!-- http://purl.obolibrary.org/obo/HP_0031815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000153"/>
        <obo:IAO_0000115>A functional anomaly of the mouth (which is also known as the oral cavity).</obo:IAO_0000115>
