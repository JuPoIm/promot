        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011008"/>
        <obo:IAO_0000115>Applies to an abnormality that occurs in or is exacerbated during the night.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-20T12:30:06Z</dc:date>
