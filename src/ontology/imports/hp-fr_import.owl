        <oboInOwl:hasDbXref>UMLS:C4021776</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the voice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Voice abnormality</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001608</oboInOwl:id>
        <rdfs:comment>This term describes any abnormality of the voice, i.e., of the sounds produced by humans by the passage of air through the larynx and over the vocal cords, and then modified by the resonance organs, the nasopharynx, and the mouth.</rdfs:comment>
        <rdfs:label xml:lang="fr">Anomalie de la voix</rdfs:label>
    </owl:Class>
    <owl:Axiom>
