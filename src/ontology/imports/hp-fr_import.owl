    <!-- http://purl.obolibrary.org/obo/HP_0001387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001376"/>
        <obo:IAO_0000115>Joint stiffness is a perceived sensation of tightness in a joint or joints when attempting to move them after a period of inactivity. Joint stiffness typically subsides over time.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002775</oboInOwl:hasAlternativeId>
