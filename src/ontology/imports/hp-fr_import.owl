    <!-- http://purl.obolibrary.org/obo/HP_0025031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-08-27T13:44:32Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Any anomaly of the digestive system, a collection of organs that is made up of the gastrointestinal tract and the liver, pancreas, and gallbladder. The gastrointestinal tract is a series of hollow organs joined in a long, twisting tube from the mouth to the anus, including the mouth, esophagus, stomach, small intestine, large intestine and anus.</rdfs:comment>
        <rdfs:label xml:lang="fr">Anomalie de l&apos;appareil digestif</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025031"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de l&apos;appareil digestif</owl:annotatedTarget>
        <babelon:comment>label of HP:0025031 (Abnormality of the digestive system)  ; abnormality of the digestive system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the digestive system</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    


