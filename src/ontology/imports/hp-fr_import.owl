    <!-- http://purl.obolibrary.org/obo/HP_0000508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115 xml:lang="fr">Le bord de la paupière supérieure est positionné 3 mm ou plus plus bas que d&apos;habitude et couvre la partie supérieure de l&apos;iris (objectif) ; ou le bord de la paupière supérieure obscurcit au moins une partie de la pupille (subjectif).</obo:IAO_0000115>
        <obo:IAO_0000115>The upper eyelid margin is positioned 3 mm or more lower than usual and covers the superior portion of the iris (objective); or, the upper lid margin obscures at least part of the pupil (subjective).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:11934000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0005745</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Blepharoptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Drooping upper eyelid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Eyelid ptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Palpebral ptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Eye drop</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000508</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Ptosis</rdfs:label>
        <rdfs:label xml:lang="fr">Ptosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Le bord de la paupière supérieure est positionné 3 mm ou plus plus bas que d&apos;habitude et couvre la partie supérieure de l&apos;iris (objectif) ; ou le bord de la paupière supérieure obscurcit au moins une partie de la pupille (subjectif).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000508 (Ptosis)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
