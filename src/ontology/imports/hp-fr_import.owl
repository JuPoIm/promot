        <obo:IAO_0000115>Pain improves or worsens with changes in body position.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-19T16:44:38Z</dc:date>
        <oboInOwl:hasExactSynonym>Positional nature to pain</oboInOwl:hasExactSynonym>
        <rdfs:label>Positionally dependent pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_5200241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_5200241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000708"/>
        <obo:IAO_0000115>A repeating behavior that is either immediately unproductive or has negative long-term consequences. This includes harmful coping mechanisms such as addictive behavior and failure to control impulses and compulsions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6624-2975"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2984-1124"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4691-7362"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6581-7754"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7674-1767"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2598-6622"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4014-4490"/>
        <rdfs:label>Recurrent maladaptive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Neuropathic pain is triggered by lesions to the somatosensory nervous system that alter its structure and function so that pain occurs spontaneously and responses to noxious and innocuous stimuli are pathologically amplified.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10141"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-6714-5727"/>
        <rdfs:comment>Neuropathic pain can be characterized by pain that is triggered when clothes touch the skin, spontaneous burning that feels like boiling water, bursts of pins and needles(paresthesias) in the feet upon walking , a continuous crushing pain after an amputation as if your phantom foot is being squeezed, or a band of searing pain around the body at the level at whichsensation was lost after a spinal cord injury.</rdfs:comment>
        <rdfs:label>Neuropathic pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Discomfort in the chest described as pressure, heaviness, or tightness.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10135"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Chest pain described as pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Chest pain described as a tearing or ripping sensation.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10136"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>The pain of aortic dissection may be described as tearing or ripping and does not improve with nitroglycerin.</rdfs:comment>
        <rdfs:label>Chest pain described as ripping or tearing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011008"/>
        <obo:IAO_0000115>Refers to symptomatology that begins in the proximal limbs and subsequently affects the distal limbs.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/9922"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Proximal to distal progression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003674"/>
        <obo:IAO_0000115>Onset of signs or symptoms of disease during the period of a woman&apos;s life shortly before the occurrence of the menopause.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/7603"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Perimenopausal onset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003674"/>
        <obo:IAO_0000115>Onset of signs or symptoms of disease during the period of a woman&apos;s life after the occurrence of the menopause.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/7603"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Postmenopausal onset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001547"/>
        <obo:IAO_0000115>The anteroposterior dimension of the chest on the lateral radiograph is often relatively narrow compared with the chest width on the frontal radiograph.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/7791"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Flat chest</oboInOwl:hasExactSynonym>
        <rdfs:label>Thoracic cage flatness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain that is perceived to extend or spread out from one area of the body to another.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/9933"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Radiating pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6000707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain at night.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10488"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8612-1062"/>
        <rdfs:label>Noctural pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001608"/>
        <obo:IAO_0000115>Wet voice is a perceptual vocal quality that is gurgly or liquid sounding and is due to the voice being produced through moisture. It is commonly used as an indicator of penetration and/or aspiration in clinical swallowing assessments and bedside screening tests.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10572"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Wet voice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Exquisite tenderness in a specific region, beyond what one would surmise from examination.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10695"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>This finding may be observed with several diseases including necrotizing fasciitis and gas gangrene.</rdfs:comment>
        <rdfs:label>Pain disproportionate to abnormality on physical exam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain in extremity that worsens with joint is passively flexed.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10786"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>This feature may be observed in acute compartment syndrome.</rdfs:comment>
        <rdfs:label>Pain exacerbated by passive flexion at joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Pain worsens with wrist ulnar or radial deviation.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10742"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Ulnar: Triangular fibrocartilage complex tear; Ulnocarpal abutment syndrome Radial: Triangular fibrocartilage complex tear.</rdfs:comment>
        <rdfs:label>Pain exacerbated by wrist deviation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>A popping or snapping sensation (noise or feeling) at the time of an injury.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/9914"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Sudden snapping or popping at the time of an injury can be a sign of significant damage to muscles, tendons, ligaments, or bones.</rdfs:comment>
        <rdfs:label>Snapping sensation at time of injury</rdfs:label>
    </owl:Class>
</rdf:RDF>



