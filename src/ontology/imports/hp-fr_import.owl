        <owl:annotatedTarget xml:lang="fr">Anomalie des mouvements prénataux</owl:annotatedTarget>
        <babelon:comment>label of HP:0001557 (Prenatal movement abnormality)  ; abnormality of prenatal development or birth</babelon:comment>
