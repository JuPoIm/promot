    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011842"/>
        <obo:IAO_0000115>An abnormal structure or form of the joints, i.e., one or more of the articulations where two bones join.</obo:IAO_0000115>
