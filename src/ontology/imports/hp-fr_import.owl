    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034059"/>
        <obo:IAO_0000115>An abnormality of fetal movement.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007629</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1849510</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal intrauterine movements</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001557</oboInOwl:id>
        <rdfs:comment>Fetal movements generally become apparent during the second trimester of pregnancy around the 20th week but occasionally up to the 25th week. The initiation of perceptible fetal movements is referred to as &apos;quickening&apos;.</rdfs:comment>
        <rdfs:label xml:lang="fr">Anomalie des mouvements prénataux</rdfs:label>
    </owl:Class>
