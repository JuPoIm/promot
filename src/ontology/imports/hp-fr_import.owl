    <!-- http://purl.obolibrary.org/obo/HP_0030884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008872"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033454"/>
        <obo:IAO_0000115>Feeding problem necessitating gastrojejunal tube feeding.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4280681</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gastro-jejunal tube feeding in infancy</oboInOwl:hasExactSynonym>
        <rdfs:comment>The rationale for gastrojejunal tube feeding is that placing the tip of the tube beyond the ligament of Treitz prevented duodenogastric reflux or gastro-esophageal reflux. Gastrojejunal feeding tubes have since been used in children who are deemed too unfit for antireflux surgery or where fundoplication has failed.</rdfs:comment>
        <rdfs:label xml:lang="fr">Alimentation par sonde gastro-jéjunale dans la petite enfance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030884"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Alimentation par sonde gastro-jéjunale dans la petite enfance</owl:annotatedTarget>
        <babelon:comment>label of HP:0030884 (Gastrojejunal tube feeding in infancy)  ; abnormality of the digestive system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gastrojejunal tube feeding in infancy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    


