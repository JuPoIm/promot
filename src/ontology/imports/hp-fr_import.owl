        <owl:annotatedTarget xml:lang="fr">Anomalie de la physiologie du système digestif</owl:annotatedTarget>
        <babelon:comment>label of HP:0025032 (Abnormality of digestive system physiology)  ; abnormality of the digestive system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of digestive system physiology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
