        <babelon:comment>label of HP:0004303 (Abnormality of muscle fibers)  ; abnormality of the musculature</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal muscle fiber morphology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
