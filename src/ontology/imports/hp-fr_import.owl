        <obo:IAO_0000115>An abnormality of the genital system.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une anomalie du système génital</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C0281966</oboInOwl:hasDbXref>
