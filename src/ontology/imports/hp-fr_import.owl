        <babelon:comment>label of HP:0012759 (Neurodevelopmental abnormality)  ; abnormality of the nervous system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neurodevelopmental abnormality</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    


