    <!-- http://purl.obolibrary.org/obo/HP_0100022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115>An abnormality of movement with a neurological basis characterized by changes in coordination and speed of voluntary movements.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <oboInOwl:creation_date>2010-05-28T11:48:50Z</oboInOwl:creation_date>
