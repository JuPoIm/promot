        <oboInOwl:hasDbXref>UMLS:C0333068</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1850530</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Flexed joint that cannot be straightened</oboInOwl:hasExactSynonym>
