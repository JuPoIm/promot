    <!-- http://purl.obolibrary.org/obo/HP_0005268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034241"/>
        <obo:IAO_0000115>A pregnancy that ends at a stage in which the fetus is incapable of surviving on its own, defined as the spontaneous loss of a fetus before the 22th week of pregnancy.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:17369002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0000786</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Early fetal demise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early foetal demise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spontaneous abortion</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0005268</oboInOwl:id>
        <rdfs:comment>The age at which fetal demise is legally classified asa a miscarriage varies between countries with the US being 20 gestational weeks and the UK being 24 gestational weeks. The HPO chooses the average of these age ranges.</rdfs:comment>
        <rdfs:label xml:lang="fr">Risque accru d&apos;avortement spontané</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005268"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Early foetal demise</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#uk_spelling"/>
    </owl:Axiom>
    <owl:Axiom>
