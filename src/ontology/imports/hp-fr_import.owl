        <oboInOwl:hasExactSynonym>Extraocular muscle paralysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Weakness of extraocular eye movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Weakness of muscles controlling eye movement</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000597</oboInOwl:id>
        <rdfs:label xml:lang="fr">Parésie oculaire</rdfs:label>
