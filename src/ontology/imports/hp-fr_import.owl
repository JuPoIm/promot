        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Début congénital</owl:annotatedTarget>
        <babelon:comment>label of HP:0003577 (Congenital onset)  ; clinicalcourse</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital onset</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
