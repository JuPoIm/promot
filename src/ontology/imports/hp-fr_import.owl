    <!-- http://purl.obolibrary.org/obo/HP_0003547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001435"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003325"/>
        <obo:IAO_0000115>The shoulder, or pectoral, girdle is composed of the clavicles and the scapulae. Shoulder-girdle weakness refers to lack of strength of the muscles attaching to these bones, that is, lack of strength of the muscles around the shoulders.</obo:IAO_0000115>
