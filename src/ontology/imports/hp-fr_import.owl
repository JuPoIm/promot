    <!-- http://purl.obolibrary.org/obo/HP_0003236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0040081"/>
        <obo:IAO_0000115>An elevation of the level of the enzyme creatine kinase (also known as creatine phosphokinase (CK; EC 2.7.3.2) in the blood. CK levels can be elevated in a number of clinical disorders such as myocardial infarction, rhabdomyolysis, and muscular dystrophy.</obo:IAO_0000115>
