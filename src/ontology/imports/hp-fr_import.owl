        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011008"/>
        <obo:IAO_0000115>Applies to a sign, symptom, or other abnormality that occurs in or is exacerbated in the day time.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-20T12:31:12Z</dc:date>
