    <!-- http://purl.obolibrary.org/obo/HP_0001371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034392"/>
        <obo:IAO_0000115>A flexion contracture is a bent (flexed) joint that cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement of joints.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001372</oboInOwl:hasAlternativeId>
