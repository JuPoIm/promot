    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001608"/>
        <obo:IAO_0000115>A type of speech characterized by the presence of an abnormally increased nasal airflow during speech associated with structural abnormality of the nasal passages.</obo:IAO_0000115>
