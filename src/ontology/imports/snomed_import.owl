        <skos:altLabel xml:lang="fr">stature</skos:altLabel>
        <skos:altLabel xml:lang="fr">taille</skos:altLabel>
        <skos:definition xml:lang="es">La distancia desde el piso hasta el vértice del cráneo del cuerpo de un individuo.</skos:definition>
        <skos:definition xml:lang="en">The distance from the base to the top of a subject&apos;s entire body.</skos:definition>
