    <!-- http://snomed.info/id/1153637007 -->

    <owl:Class rdf:about="http://snomed.info/id/1153637007">
        <sct-ext:definitionStatus>Défini</sct-ext:definitionStatus>
        <sct-ext:fsn xml:lang="en">Body height (observable entity)</sct-ext:fsn>
        <dc11:type>observable entity</dc11:type>
        <rdfs:label xml:lang="en">Body height</rdfs:label>
        <rdfs:label xml:lang="en">Body height (observable entity)</rdfs:label>
        <rdfs:label xml:lang="es">altura corporal (entidad observable)</rdfs:label>
        <rdfs:label xml:lang="fr">taille corporelle</rdfs:label>
