    <!-- http://snomed.info/id/266731002 -->

    <owl:Class rdf:about="http://snomed.info/id/266731002">
        <sct-ext:definitionStatus>Primitif</sct-ext:definitionStatus>
        <sct-ext:fsn xml:lang="en">Walking frame (physical object)</sct-ext:fsn>
        <dc11:type>physical object</dc11:type>
        <rdfs:label xml:lang="en">Walking frame</rdfs:label>
        <rdfs:label xml:lang="en">Walking frame (physical object)</rdfs:label>
        <rdfs:label xml:lang="es">dispositivo para andador (objeto físico)</rdfs:label>
        <rdfs:label xml:lang="fr">marchette</rdfs:label>
        <skos:altLabel xml:lang="en">WF - Walking frame</skos:altLabel>
        <skos:altLabel xml:lang="fr">cadre de marche</skos:altLabel>
        <skos:altLabel xml:lang="es">dispositivo para andador</skos:altLabel>
        <skos:definition xml:lang="en">A frame consisting of 3 or 4 legs which aids a person with walking. Some walking frames come with wheels at the front to help move the frame. The frame is moved by either lifting the entire frame or by tilting the frame off the back legs and onto the front wheels.</skos:definition>
        <skos:definition xml:lang="es">Un andador de 3 o 4 patas que asiste a la persona en la marcha. Algunos andadores tienen ruedas en la parte delantera para facilitar la movilidad del dispositivo. El andador se desplaza levantándolo por completo o levantando las patas traseras e inclinándolo sobre las ruedas delanteras.</skos:definition>
        <skos:notation>266731002</skos:notation>
        <skos:prefLabel xml:lang="en">Walking frame</skos:prefLabel>
        <skos:prefLabel xml:lang="es">dispositivos para andar</skos:prefLabel>
    </owl:Class>
    


