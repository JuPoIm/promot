        <skos:prefLabel xml:lang="en">Body height</skos:prefLabel>
        <skos:prefLabel xml:lang="es">altura corporal</skos:prefLabel>
    </owl:Class>
    


    <!-- http://snomed.info/id/1255320005 -->

    <owl:Class rdf:about="http://snomed.info/id/1255320005">
        <rdfs:subClassOf rdf:resource="http://snomed.info/id/224899006"/>
        <sct-ext:definitionStatus>Primitif</sct-ext:definitionStatus>
        <sct-ext:fsn xml:lang="en">Wheeled walker (physical object)</sct-ext:fsn>
        <dc11:type>physical object</dc11:type>
        <rdfs:label xml:lang="en">Wheeled walker</rdfs:label>
        <rdfs:label xml:lang="en">Wheeled walker (physical object)</rdfs:label>
        <rdfs:label xml:lang="es">andador con ruedas (objeto físico)</rdfs:label>
        <rdfs:label xml:lang="fr">déambulateur à roues</rdfs:label>
        <skos:altLabel xml:lang="en">Mobilator</skos:altLabel>
        <skos:altLabel xml:lang="en">Rollator</skos:altLabel>
        <skos:definition xml:lang="en">A walking aid that consists of a frame with 3 or 4 wheels that allow the walker to move freely without lifting or tilting.</skos:definition>
        <skos:definition xml:lang="es">Un dispositivo de apoyo para la marcha que consiste en una estructura con 3 o 4 ruedas que permite al caminante moverse con libertad sin necesidad de levantarlo o inclinarlo.</skos:definition>
        <skos:notation>1255320005</skos:notation>
        <skos:prefLabel xml:lang="en">Wheeled walker</skos:prefLabel>
        <skos:prefLabel xml:lang="es">andador con ruedas</skos:prefLabel>
    </owl:Class>
    


