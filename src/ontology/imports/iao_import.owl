AnnotationAssertion(obo:IAO_0000117 obo:IAO_0000412 "PERSON:Melanie Courtot"@en)
AnnotationAssertion(obo:IAO_0000119 obo:IAO_0000412 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en)
