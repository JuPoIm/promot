    <!-- http://purl.obolibrary.org/obo/HP_0002058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004673"/>
        <obo:IAO_0000115 xml:lang="cs">Charakteristický výzor tváře (obličeje) u myopatií. Tvážře je byz výrazu, s probadlými tvářemi, bilaterální ptózou, a neschopností zvednout koutky úst z důvodu svalové slabosti</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Miyopatik durumların bir yüz görünümü karakteristiği. Yüz, kas zayıflığı nedeniyle çökük yanaklar, bilateral pitozis ve ağız köşelerini kaldırma acizliği ile birlikte ifadesiz görünür</obo:IAO_0000115>
        <obo:IAO_0000115>A facial appearance characteristic of myopathic conditions. The face appears expressionless with sunken cheeks, bilateral ptosis, and inability to elevate the corners of the mouth, due to muscle weakness.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0004647</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:26432009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0332615</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="tr">Miyopatik yüz</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Miyopatik yüz görünümü</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Myopathic face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Myopathic facial appearance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">facies myopathica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">faciès myopathique</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">myopatická tvář</oboInOwl:hasExactSynonym>
