    <!-- http://purl.obolibrary.org/obo/HP_0012825 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012824"/>
        <obo:IAO_0000115>Having a relatively minor degree of severity. For quantitative traits, a deviation of between two and three standard deviations from the appropriate population mean.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Nispeten küçük derecede (hastalık) şiddettine sahip olma durumu. Niceliksel özellikler için, uygun populasyon ortalamasından 2 ve 3 arasında bir sapmaya denk gelir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">S relativně malým stupněm závažnosti. U kvantitativních znaků se jedná o odchylku mezi dvěma a třemi směrodatnými odchylkami od příslušného populačního průměru.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2014-06-06T06:41:33Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:446411000124101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1513302</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Mild</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012825</oboInOwl:id>
        <rdfs:comment>PATO:0000394, mild.</rdfs:comment>
        <rdfs:label xml:lang="tr">Hafif</rdfs:label>
        <rdfs:label xml:lang="es">Leve</rdfs:label>
        <rdfs:label xml:lang="pt">Leve</rdfs:label>
        <rdfs:label xml:lang="fr">Légère</rdfs:label>
        <rdfs:label>Mild</rdfs:label>
        <rdfs:label xml:lang="nl">Mild</rdfs:label>
        <rdfs:label xml:lang="cs">Mírný</rdfs:label>
        <rdfs:label xml:lang="zh">轻度</rdfs:label>
    </owl:Class>
