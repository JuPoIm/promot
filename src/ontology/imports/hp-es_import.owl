    <!-- http://purl.obolibrary.org/obo/HP_0012759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115 xml:lang="tr">Bir çocuğun nörolojik gelişiminin normalden sapması, onun kişisel, sosyal, kaba veya ince motor ve bilişsel yeteneklerin gelişiminin herhangi birini veya tüm yönlerini içerebilir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normálního neurologického vývoje dítěte, která může postihovat všechny nebo jenom část aspektů vývoje. Jedná se o vývoj osobnosti, sociální vývoj, vývoj hrubé nebo jemné motoriky a kognitivní schopnosti</obo:IAO_0000115>
        <obo:IAO_0000115>A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2014-04-03T12:20:28Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>UMLS:C4022737</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012759</oboInOwl:id>
        <rdfs:comment>This term should be used to describe abnormalities with onset in the developmental period.</rdfs:comment>
        <rdfs:label xml:lang="nl">Afwijking in neurologische ontwikkeling</rdfs:label>
        <rdfs:label xml:lang="it">Anomalia del neurosviluppo</rdfs:label>
        <rdfs:label xml:lang="pt">Anomalia do desenvolvimento neurológico</rdfs:label>
        <rdfs:label xml:lang="fr">Anomalie du développement neurologique</rdfs:label>
        <rdfs:label xml:lang="de">Anomalie in der Neuroentwicklung</rdfs:label>
        <rdfs:label xml:lang="es">Anomalía en el desarrollo neurológico</rdfs:label>
        <rdfs:label xml:lang="cs">Neurovývojová abnormalita</rdfs:label>
        <rdfs:label xml:lang="tr">Nörogelişimsel anormallik</rdfs:label>
        <rdfs:label xml:lang="ja">神経発生異常</rdfs:label>
        <rdfs:label xml:lang="zh">神经发育异常</rdfs:label>
        <rdfs:label>Neurodevelopmental abnormality</rdfs:label>
    </owl:Class>
