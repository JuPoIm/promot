    <!-- http://purl.obolibrary.org/obo/HP_0000508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115 xml:lang="fr">Le bord de la paupière supérieure est positionné 3 mm ou plus plus bas que d&apos;habitude et couvre la partie supérieure de l&apos;iris (objectif) ; ou le bord de la paupière supérieure obscurcit au moins une partie de la pupille (subjectif).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Vrchní oční víčko je umístěné 3 mm a níž než obvykle a zakrývá vrchní část duhovky (objektivně), nebo okraj vrchního víčka zakrývá alespoň část čočky (subjektivně)</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Üst göz kapağı sınırı normalden 3 mm veya daha fazla aşağıya yerleşmiş ve irisin üst kısmını kapatmakta (nesnel); veya üst kapak sınırı en azından pupilin bir kısımını kapatır (öznel)</obo:IAO_0000115>
        <obo:IAO_0000115>The upper eyelid margin is positioned 3 mm or more lower than usual and covers the superior portion of the iris (objective); or, the upper lid margin obscures at least part of the pupil (subjective).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:11934000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0005745</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="tr">Bilefaropitozis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Blefaroptóza</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Blepharoptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Drooping upper eyelid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Eye drop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Eyelid ptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Göz düşmesi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Göz kapağı pitozisi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Pokles víčka</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Pokleslé horní víčko</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Ptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Ptóza víčka</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">blépharoptose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">blépharoptose|chute des paupières</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">chute des paupières</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Üst göz kapağı düşüklüğü</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Blepharoptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Drooping upper eyelid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Eyelid ptosis</oboInOwl:hasExactSynonym>
