        <oboInOwl:hasExactSynonym xml:lang="tr">Eklem kontraktürü</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Eklemlerin fleksiyon kontraktürleri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Fleksiyon kontraktürleri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Flektovaný kloub, který nelze natáhnout</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Flekční kontraktury</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Flekční kontraktury kloubů</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Flexed joint that cannot be straightened</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Flexion contractures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Flexion contractures of joints</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Konraktür</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Kontraktürler</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">contracture articulaire</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">contracture péri-articulaire</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">contractures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">raideur articulaire par contracture</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">raideur articulaire par contracture|contracture péri-articulaire|contracture articulaire|contractures articulaires tardives|contractures articulaires débutant à l&apos;âge scolaire</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flexed joint that cannot be straightened</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flexion contractures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flexion contractures of joints</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001371</oboInOwl:id>
        <rdfs:label xml:lang="de">Beugekontraktur</rdfs:label>
        <rdfs:label xml:lang="es">Contractura en flexión</rdfs:label>
        <rdfs:label xml:lang="fr">Contractures de flexion</rdfs:label>
        <rdfs:label xml:lang="it">Contrazione della flessione</rdfs:label>
        <rdfs:label xml:lang="tr">Fleksiyon kontraktürü</rdfs:label>
        <rdfs:label xml:lang="cs">Flekční kontraktura</rdfs:label>
        <rdfs:label xml:lang="nl">Flexiecontractuur</rdfs:label>
        <rdfs:label xml:lang="ja">屈曲拘縮</rdfs:label>
        <rdfs:label xml:lang="zh">屈曲挛缩</rdfs:label>
        <rdfs:label>Flexion contracture</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001371"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fleksiyon kontraktürü aktif veya pasif olarak düzleştirilemeyen bükülmüş (fleks halde) bir eklemdir. Bu yüzdendir ki eklemlerin normal hareketlerini engelleyen kas, tendon, ligament veya derideki yapısal değişiklikler kronik eklem hareket kaybına neden olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A flexion contracture is a bent (flexed) joint that cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement of joints.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001371"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Flekční kontraktura je flektovaný kloub který nelze extendovat aktivně ani pasivně. Jedná se o chronickou ztrátu pohyblivosti kloubu pro strukturální změny ve svalech, šlachách, vazech nebo kůži které znemožňují normální pohyb kloubu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A flexion contracture is a bent (flexed) joint that cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement of joints.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
