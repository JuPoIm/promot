    <!-- http://purl.obolibrary.org/obo/HP_0005268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034241"/>
        <obo:IAO_0000115>A pregnancy that ends at a stage in which the fetus is incapable of surviving on its own, defined as the spontaneous loss of a fetus before the 22th week of pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Gebeliğin 20. haftasından önce fetüsün kendiliğinden kaybedilmesi olarak tanımlanan, fetüsün kendi başına hayatta kalamayacağı bir aşamada sona eren bir gebelik</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Těhotenství, které končí ve fázi, ve které plod není samostatně životaschopný, definované jako spontánní ztráta plodu před 22. týdnem těhotenství.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:17369002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0000786</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="tr">Düşük</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early fetal demise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Early fetal demise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early foetal demise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Fausse couche</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Miscarriage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spontaneous abortion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Spontaneous abortion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Spontánní potrat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Včasné odumření plodu</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0005268</oboInOwl:id>
        <rdfs:comment>The age at which fetal demise is legally classified asa a miscarriage varies between countries with the US being 20 gestational weeks and the UK being 24 gestational weeks. The HPO chooses the average of these age ranges.</rdfs:comment>
        <rdfs:label xml:lang="es">Aborto espontáneo</rdfs:label>
        <rdfs:label>Miscarriage</rdfs:label>
        <rdfs:label xml:lang="cs">Potrat</rdfs:label>
        <rdfs:label xml:lang="fr">Risque accru d&apos;avortement spontané</rdfs:label>
        <rdfs:label xml:lang="tr">Spontan düşük</rdfs:label>
        <rdfs:label xml:lang="nl">Spontane abortus</rdfs:label>
        <rdfs:label xml:lang="zh">流产</rdfs:label>
        <rdfs:label xml:lang="ja">自然流産</rdfs:label>
    </owl:Class>
