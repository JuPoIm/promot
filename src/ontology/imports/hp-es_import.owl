    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011799"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011805"/>
        <obo:IAO_0000115 xml:lang="fr">Anomalie d&apos;un muscle innervé par le nerf facial (septième nerf crânien)</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Anomálie svalů obličeje inervovaných nervus facialis (sedmý hlavový nerv)</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Fasyal sinir (yedinci kraniyal sinir) tarafından inerve edilen bir kasın anormalliği</obo:IAO_0000115>
        <obo:IAO_0000115>An anomaly of a muscle that is innervated by the facial nerve (the seventh cranial nerve).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4025865</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="cs">Abnormalita obličejových svalů</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Abnormality of facial muscles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Anomálie faciálních svalů</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Facial muscle issue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Yüz kaslarının anormalliği</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Yüz kası sorunu</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">anomalie de la musculature de la face|anomalie des muscles de la face|anomalie des muscles faciaux</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of facial muscles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Facial muscle issue</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000301</oboInOwl:id>
        <rdfs:comment>Facial muscles control facial expression and are innervated by the seventh cranial nerve. Facial muscles around the eye are responsible for eye blink and eyelid closure.</rdfs:comment>
        <rdfs:label xml:lang="cs">Abnormality svalů obličeje</rdfs:label>
        <rdfs:label xml:lang="de">Abnormität der Gesichtsmuskulatur</rdfs:label>
