        <oboInOwl:hasExactSynonym xml:lang="tr">Prenatal başlangıç</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Symptom přítomen při narození</oboInOwl:hasExactSynonym>
