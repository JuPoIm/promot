        <oboInOwl:hasExactSynonym xml:lang="tr">Huni göğüs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Vpáčený hrudník</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">thorax en entonnoir</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">thorax en entonnoir|léger Pectus excavatum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Funnel chest</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000767</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
