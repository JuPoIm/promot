    <!-- http://purl.obolibrary.org/obo/HP_0025303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031796"/>
        <obo:IAO_0000115 xml:lang="cs">Aplikuje se na příznak, symptom nebo jiný projev, který se vyskytuje vícekrát v obvykle nepravidelných intervalech. Výskyty jsou odděleny intervalem, ve kterém není přítomen znak, symptom nebo projev</obo:IAO_0000115>
        <obo:IAO_0000115>Applied to a sign, symptom, or other manifestation that occurs multiple times at usually irregular intervals. The occurrences are separated by an interval in which the sign, symptom, or manifestation is not present.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">En az iki kere ve potansiyel olarak birden çok meydana gelmiş fakat belirti, bulgu veya ortaya çıkışların mevcut olmadığı bir aralık tarafından ayrılan bir bulgu, belirti ve ortaya çıkışlar için geçerlidir</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-21T00:51:43Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym xml:lang="tr">Aralıklı</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Intermittant|Now and then</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Now and then</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Now and then</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Nyní a potom</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Tekrarlayan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Şimdi ve sonra</oboInOwl:hasExactSynonym>
        <rdfs:comment>In our definition, episodic is synonymous with intermittent and recurrent. The term does not imply any particular temporal pattern of the recurrence.</rdfs:comment>
        <rdfs:label>Episodic</rdfs:label>
        <rdfs:label xml:lang="nl">Episodisch</rdfs:label>
        <rdfs:label xml:lang="es">Episódico</rdfs:label>
        <rdfs:label xml:lang="cs">Epizodický</rdfs:label>
        <rdfs:label xml:lang="tr">Epizodik</rdfs:label>
        <rdfs:label xml:lang="fr">Épisodique</rdfs:label>
        <rdfs:label xml:lang="zh">不规则复发的</rdfs:label>
        <rdfs:label xml:lang="ja">汎発性</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025303"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Aplikuje se na příznak, symptom nebo jiný projev, který se vyskytuje vícekrát v obvykle nepravidelných intervalech. Výskyty jsou odděleny intervalem, ve kterém není přítomen znak, symptom nebo projev</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applied to a sign, symptom, or other manifestation that occurs multiple times at usually irregular intervals. The occurrences are separated by an interval in which the sign, symptom, or manifestation is not present.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025303"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">En az iki kere ve potansiyel olarak birden çok meydana gelmiş fakat belirti, bulgu veya ortaya çıkışların mevcut olmadığı bir aralık tarafından ayrılan bir bulgu, belirti ve ortaya çıkışlar için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applied to a sign, symptom, or other manifestation that occurs multiple times at usually irregular intervals. The occurrences are separated by an interval in which the sign, symptom, or manifestation is not present.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
