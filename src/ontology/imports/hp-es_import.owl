    <!-- http://purl.obolibrary.org/obo/HP_0001328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012759"/>
        <obo:IAO_0000115 xml:lang="cs">Zhoršení určitých dovedností, jako je čtení nebo psaní, koordinace, sebeovládání, nebo pozornost, které interferují se schopností učit se. Onemocnění nesouvisí s globální nedostatečností intelektu</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Öğrenme ile ilgili okuma veya yazma, koordinasyon, kendini kontrol etme veya dikkat gibi belirli becerilerin bozulması. Bozukluk global zeka eksikliği ile ilişkili değildir</obo:IAO_0000115>
        <obo:IAO_0000115>Impairment of certain skills such as reading or writing, coordination, self-control, or attention that interfere with the ability to learn. The impairment is not related to a global deficiency of intelligence.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007234</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4025790</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">Trouble d&apos;apprentissage</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001328</oboInOwl:id>
        <rdfs:comment>The term learning disability is used with different meanings in different contexts. Significant impairments of mental functioning with a reduction in IQ below 70 should be coded as mental retardation.</rdfs:comment>
        <rdfs:label xml:lang="es">Discapacidad de aprendizaje específica</rdfs:label>
        <rdfs:label xml:lang="it">Disturbo specifico dell&apos;apprendimento</rdfs:label>
        <rdfs:label xml:lang="cs">Specifická porucha učení</rdfs:label>
        <rdfs:label xml:lang="nl">Specifieke leerstoornis</rdfs:label>
        <rdfs:label xml:lang="de">Spezifische Lernbehinderung</rdfs:label>
        <rdfs:label xml:lang="fr">Trouble spécifique d&apos;apprentissage</rdfs:label>
        <rdfs:label xml:lang="tr">Özel öğrenme bozukluğu</rdfs:label>
        <rdfs:label xml:lang="zh">特定的学习障碍</rdfs:label>
        <rdfs:label xml:lang="ja">特異的学習障害</rdfs:label>
        <rdfs:label>Specific learning disability</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001328"/>
