    <!-- http://purl.obolibrary.org/obo/HP_0025156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025032"/>
        <obo:IAO_0000115 xml:lang="tr">Hidrasyon durumu (idrar çıkışı, kan üre nitrojeni, kreatinin, idrar sodyum konsantrasyonu), kilonun korunması, dışkı çıkışı ve serum elektrolit durumu ile değerlendirilen intravenöz (parenteral) beslenmeden ayrılamama</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Neschopnost odpojení od intravenózní (parenterální) výživy, která se posuzuje podle stavu hydratace (výdej moči, dusík močoviny v krvi, kreatinin, koncentrace sodíku v moči), schopnosti udržet si hmotnost, výdeje stolice a stavu elektrolytů v séru.</obo:IAO_0000115>
        <obo:IAO_0000115>Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-04T12:14:59Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym xml:lang="nl">Dependency on IV nutrition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Dependency on IV nutrition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Závislost na intravenózní výživě</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dependency on IV nutrition</oboInOwl:hasExactSynonym>
        <rdfs:comment>Total parenteral nutrition (TPN) refers to the application of an intravenous nutritional solution in individuals with gastrointestinal disorders that prevent them from absorbing a sufficient amount of nutrients from the gut to maintain health. The solution contains protein, carbohydrates (in the form of glucose), glucose, fat, vitamins, and minerals. Dependency on TPN is essentially a manifestation of the continued severity of a gastrointestinal disorder.</rdfs:comment>
        <rdfs:label xml:lang="nl">Afhankelijkheid van intraveneuze voeding</rdfs:label>
        <rdfs:label xml:lang="es">Dependencia de nutrición parenteral</rdfs:label>
        <rdfs:label xml:lang="fr">Dépendance à la nutrition intraveineuse</rdfs:label>
        <rdfs:label xml:lang="cs">Závislost na intravenózní výživě</rdfs:label>
        <rdfs:label xml:lang="tr">İntravenöz beslenmeye bağımlılık</rdfs:label>
        <rdfs:label xml:lang="ja">静脈栄養への依存</rdfs:label>
        <rdfs:label xml:lang="zh">静脉营养依赖</rdfs:label>
        <rdfs:label>Dependency on intravenous nutrition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hidrasyon durumu (idrar çıkışı, kan üre nitrojeni, kreatinin, idrar sodyum konsantrasyonu), kilonun korunması, dışkı çıkışı ve serum elektrolit durumu ile değerlendirilen intravenöz (parenteral) beslenmeden ayrılamama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost odpojení od intravenózní (parenterální) výživy, která se posuzuje podle stavu hydratace (výdej moči, dusík močoviny v krvi, kreatinin, koncentrace sodíku v moči), schopnosti udržet si hmotnost, výdeje stolice a stavu elektrolytů v séru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status.</babelon:source_value>
