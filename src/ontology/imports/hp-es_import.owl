    <!-- http://purl.obolibrary.org/obo/HP_0025153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011008"/>
        <obo:IAO_0000115 xml:lang="cs">Krátkodobé a ne trvalé. Tento termín se vztahuje na fenotypovou abnormalitu, která je dočasná a krátkodobá.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Kısa ömürlü ve kalıcı olmayan. Bu terim geçici ve kısa süreli bir fenotipik anormallik için geçerlidir</obo:IAO_0000115>
        <obo:IAO_0000115>Short-lived and not permanent. This term applies to a phenotypic abnormality that is temporary and of short duration.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-03T22:19:26Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
