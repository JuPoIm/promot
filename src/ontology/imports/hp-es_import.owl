        <rdfs:label xml:lang="fr">Anomalie de la musculature faciale</rdfs:label>
        <rdfs:label xml:lang="es">Anomalía de la musculatura facial</rdfs:label>
        <rdfs:label xml:lang="tr">Yüz kası anormalliği</rdfs:label>
        <rdfs:label xml:lang="zh">面部肌肉异常</rdfs:label>
        <rdfs:label xml:lang="ja">顔面筋異常</rdfs:label>
        <rdfs:label>Abnormality of facial musculature</rdfs:label>
