    <!-- http://purl.obolibrary.org/obo/HP_0030205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030006"/>
        <obo:IAO_0000115 xml:lang="cs">&quot;Kolísání časového intervalu mezi dvěma akčními potenciály téže motorické jednotky se nazývá &quot;&quot;jitter&quot;&quot; (chvění). Tento termín se tedy vztahuje na zvýšenou variabilitu intervalu mezi po sobě jdoucími akčními potenciály téže motorické jednotky, která se měří pomocí elektromyografie (EMG).&quot;</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Aynı motor ünitesinin iki aksiyon potansiyeli arasındaki zaman aralığındaki değişime jitter denir. Bu nedenle bu terim, elektromiyografi (EMG) ile ölçülen, aynı motor ünitesinin ardışık eylem potansiyelleri arasındaki aralığın değişkenli artışı için uygulanır</obo:IAO_0000115>
        <obo:IAO_0000115>The variation in the time interval between the two action potentials of the same motor unit is called jitter. This term therefore applies to increased variability in the interval between successive action potentials of the same motor unit, which is measured by electromyography (EMG).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4021045</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="nl">Increased jitter at single fibre EMG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Increased jitter at single fibre electromyography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Increased jitter at single fibre electromyography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Tek fiber elektromyografisinde artmış seğirme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Zvýšené chvění u jednovláknové elektromyografie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased jitter at single fibre EMG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased jitter at single fibre electromyography</oboInOwl:hasExactSynonym>
        <rdfs:comment>Increased jitter values are not pathogonomic for myasthenia, but indicate disturbed neuromuscular transmission.</rdfs:comment>
        <rdfs:label xml:lang="fr">Augmentation de la gigue à l&apos;EMG d&apos;une seule fibre</rdfs:label>
        <rdfs:label xml:lang="es">EMG: aumento de la inestabilidad en una sola fibra</rdfs:label>
        <rdfs:label xml:lang="tr">Tek lif EMG&apos;sinde artmış seğirme</rdfs:label>
        <rdfs:label xml:lang="cs">Zvýšený jitter u jednovláknové EMG</rdfs:label>
        <rdfs:label xml:lang="zh">单纤维肌电图时抖动增加</rdfs:label>
        <rdfs:label xml:lang="ja">単繊維筋電図におけるジッターの増加</rdfs:label>
        <rdfs:label>Increased jitter at single fiber EMG</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030205"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Kolísání časového intervalu mezi dvěma akčními potenciály téže motorické jednotky se nazývá &quot;&quot;jitter&quot;&quot; (chvění). Tento termín se tedy vztahuje na zvýšenou variabilitu intervalu mezi po sobě jdoucími akčními potenciály téže motorické jednotky, která se měří pomocí elektromyografie (EMG).&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The variation in the time interval between the two action potentials of the same motor unit is called jitter. This term therefore applies to increased variability in the interval between successive action potentials of the same motor unit, which is measured by electromyography (EMG).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
