    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003674"/>
        <obo:IAO_0000115>A phenotypic abnormality that is present at birth.</obo:IAO_0000115>
