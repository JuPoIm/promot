        <oboInOwl:hasExactSynonym xml:lang="tr">Yürüyüş anormallikleri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Yürüyüş bozukluğu</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Yürüyüş zorlukları</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">anomalie de la demarche</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">démarche anormale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">démarche anormale|anomalie de la demarche|anomalies de la marche pouvant arriver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">troubles de la demarche</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal gait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Difficulty in walking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gait abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gait difficulties</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gait disturbances</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Impaired gait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Walking disability</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001288</oboInOwl:id>
        <rdfs:comment>Gait disturbances can be caused by neurological or muscular diseases but also fractures or other sources of pain that is triggered upon walking.</rdfs:comment>
        <rdfs:label xml:lang="es">Alteración en la marcha</rdfs:label>
        <rdfs:label xml:lang="fr">Anomalie de la démarche</rdfs:label>
        <rdfs:label xml:lang="it">Disturbo dell&apos;andatura</rdfs:label>
        <rdfs:label xml:lang="de">Gangstörung</rdfs:label>
        <rdfs:label xml:lang="nl">Loopstoornis</rdfs:label>
        <rdfs:label xml:lang="cs">Porucha chůze</rdfs:label>
        <rdfs:label xml:lang="tr">Yürüme bozukluğu</rdfs:label>
        <rdfs:label xml:lang="zh">步态异常</rdfs:label>
        <rdfs:label xml:lang="ja">歩行障害</rdfs:label>
        <rdfs:label>Gait disturbance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Termín porucha chůze znamená jakékoliv narušení schopnosti chodit. Obecně se může jednat o neurologickou nemoc ale i fraktury či jiné zdroje bolestí spouštěné chůzí. V tomto kontextu je tím však myšlena porucha chůze neurologického či svalového původu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The term gait disturbance can refer to any disruption of the ability to walk.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yürüme bozukluğu yürüme yeteneğindeki herhangi bir bozulmaya işaret eden bir terimdir. Genel olarak, nörolojik hastalıklara işaret etse de kırıklara veya yürüme ile tetiklenen diğer ağrı kaynaklarına da işaret eder. Bununla birlikte, mevcut bağlamda yürüme bozukluğu nörolojik hastalığa veya kas hastalığı temelinde yürümedeki zorluğa işaret eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The term gait disturbance can refer to any disruption of the ability to walk.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
