    <!-- http://purl.obolibrary.org/obo/HP_0002878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002093"/>
        <obo:IAO_0000115 xml:lang="tr">Ciddi solunum yetmezliği; yetersiz hava değişimi yani oksijen veya karbondioksit seviyelerinin normal limitler içinde bulunmaması olarak tanımlanır</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Těžká forma respirační nedostatečnosti charakterizovaná nedostatečnou výměnou plynů, takže hladinu kyslíku nebo oxidu uhličitého nelze udržet v normálních mezích</obo:IAO_0000115>
        <obo:IAO_0000115>A severe form of respiratory insufficiency characterized by inadequate gas exchange such that the levels of oxygen or carbon dioxide cannot be maintained within normal limits.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0004877</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:409622000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1145670</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">insuffisance respiratoire précoce</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Respiratory failure</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002878</oboInOwl:id>
        <rdfs:comment>Respiratory failure is classified as type 1 with hypoxemia (arterial partial pressure of oxygen less than 60 mmHg) without hypercapnea, and type 2 with hypoxemia in the present of hypercapnea (partial pressure of carbon dioxide over 50 mmHg).</rdfs:comment>
        <rdfs:label xml:lang="de">Atemstillstand</rdfs:label>
        <rdfs:label xml:lang="es">Fallo respiratorio</rdfs:label>
        <rdfs:label xml:lang="it">Insufficienza respiratoria</rdfs:label>
        <rdfs:label xml:lang="fr">Insuffisance respiratoire</rdfs:label>
        <rdfs:label xml:lang="pt">Insuficiência respiratória</rdfs:label>
        <rdfs:label xml:lang="nl">Respiratoire insufficiëntie</rdfs:label>
        <rdfs:label xml:lang="cs">Respirační selhání</rdfs:label>
        <rdfs:label xml:lang="tr">Solunum yetmezliği</rdfs:label>
        <rdfs:label xml:lang="ja">呼吸不全</rdfs:label>
        <rdfs:label xml:lang="zh">呼吸衰竭</rdfs:label>
        <rdfs:label>Respiratory failure</rdfs:label>
    </owl:Class>
