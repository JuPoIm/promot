    <!-- http://purl.obolibrary.org/obo/HP_0001260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002167"/>
        <obo:IAO_0000115 xml:lang="tr">Disartrik konuşma, kötü telafuz ile karakterize bir nörolojik konuşma hastalığına işaret eden genel bir tanımdır. Dahil olan nörolojik yapılara bağlı olarak, disartri spastik, gevşek, ataksik ve hipokinetik veya karışık olarak sınıflandırılabilir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Dysartrická řeč je všeobecný popis označující neurologickou poruchu řeči charakterizovanou špatnou artikulací. V závislosti na příslušné neurologické struktuře může být dysartrie dále klasifikována jako spastická, chabá, ataktická, hyperkinetická a hypokinetická nebo smíšená</obo:IAO_0000115>
        <obo:IAO_0000115>Dysarthric speech is a general description referring to a neurological speech disorder characterized by poor articulation. Depending on the involved neurological structures, dysarthria may be further classified as spastic, flaccid, ataxic, hyperkinetic and hypokinetic, or mixed.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002327</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:8011004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0013362</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="nl">Difficulty articulating speech</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Difficulty articulating speech|Dysarthric speech</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Disartrik konuşma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Dysarthric speech</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Dysarthrie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Dysartrická řeč</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Konuşma telafuzunda zorluk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Obtížný slovní projev</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Difficulty articulating speech</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dysarthric speech</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001260</oboInOwl:id>
