    <!-- http://purl.obolibrary.org/obo/HP_0003134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030177"/>
        <obo:IAO_0000115 xml:lang="cs">Abnormalita vedení elektrických impulsů periferními (motorickými nebo senzorickými) nervy zjištěná vyšetřením nervové vodivosti.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Periferik (motor veya duysal) sinirler tarafından elektriksel uyarıların iletilmesinde bir anormallik. Bu bulgu bir sinir iletim çalışmasıdır (NCS)</obo:IAO_0000115>
        <obo:IAO_0000115>An abnormality of the conduction of electrical impulses by peripheral (motor or sensory) nerves. This finding is elicited by a nerve conduction study (NCS).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006832</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007186</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4020690</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="nl">Abnormal peripheral nerve transmission</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Abnormální přenos periferními nervy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Anormal periferik sinir iletimi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Anormality vedení senzorických a motorických nervů</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Duyusal ve motor sinir iletim anormallikleri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Sensory and motor nerve conduction abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">neuropathie héréditaire motrice et sensorielle de type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">neuropathie héréditaire motrice et sensorielle de type I|neuropathie sensitivo-motrice de type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sensory and motor nerve conduction abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Abnormal peripheral nerve transmission</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0003134</oboInOwl:id>
        <rdfs:comment>A nerve conduction study (NCS) is commonly conducted together with electromyography in order to evaluate muscle disorders. For the NCS, dermal electrodes are placed at intervals over the nerve to be examined, and a low-intensity current is introduced to generate action potentials. The velocity of the action potential is related to the diameter of the nerve fiber and the presence of a myelin sheath. Diseases of the myelin sheath characteristically reduce the nerve conduction velocity (NCV). The amplitude of the response is also measured.</rdfs:comment>
        <rdfs:label xml:lang="cs">Abnormalita vedení v periferních nervech</rdfs:label>
        <rdfs:label xml:lang="nl">Afwijking van de perifere zenuw voortgeleiding</rdfs:label>
        <rdfs:label xml:lang="es">Alteración en la conducción nerviosa periférica</rdfs:label>
        <rdfs:label xml:lang="pt">Anomalia da condução nervosa periférica</rdfs:label>
        <rdfs:label xml:lang="fr">Neuropathie sensitivo-motrice de type II</rdfs:label>
        <rdfs:label xml:lang="tr">Periferal sinir iletimi anormalliği</rdfs:label>
        <rdfs:label xml:lang="zh">周围神经传导异常</rdfs:label>
        <rdfs:label xml:lang="ja">末梢神経伝導の異常</rdfs:label>
        <rdfs:label>Abnormality of peripheral nerve conduction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita vedení elektrických impulsů periferními (motorickými nebo senzorickými) nervy zjištěná vyšetřením nervové vodivosti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the conduction of electrical impulses by peripheral (motor or sensory) nerves. This finding is elicited by a nerve conduction study (NCS).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
