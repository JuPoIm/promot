    <!-- http://purl.obolibrary.org/obo/HP_0031146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002015"/>
        <obo:IAO_0000115 xml:lang="cs">Porucha polykání charakterizovaná sníženou koordinací jazyka při tvorbě bolusu po žvýkání. Potravní materiál se rozprostře po ústní dutině, místo aby se soustředil do bolusu, který se snadno polyká.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Çiğneme sonrası bolus oluşturmak için azalmış dil koordinasyonu ile karakterize anormal bir yutkunma. Besin maddeleri kolay olarak yutulan bir bolus içine yoğunlaşacağı yere ağız boşluğunda dağılır</obo:IAO_0000115>
        <obo:IAO_0000115>An abnormality of swallowing characterized by reduced tongue coordination to form bolus after chewing. Food material spreads over the oral cavity instead of being concentrated into a bolus that is easily swallowed.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-06-11T20:31:50Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="fr">Altération de la formation du bolus oral</rdfs:label>
        <rdfs:label xml:lang="tr">Bozulmuş oral bolus formasyonu</rdfs:label>
        <rdfs:label xml:lang="es">Formación de bolo oral alterado</rdfs:label>
        <rdfs:label xml:lang="cs">Zhoršená tvorba perorálního bolusu</rdfs:label>
        <rdfs:label xml:lang="zh">口腔内食物成团状能力受损</rdfs:label>
        <rdfs:label xml:lang="ja">経口ボーラス形成障害</rdfs:label>
        <rdfs:label>Impaired oral bolus formation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031146"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha polykání charakterizovaná sníženou koordinací jazyka při tvorbě bolusu po žvýkání. Potravní materiál se rozprostře po ústní dutině, místo aby se soustředil do bolusu, který se snadno polyká.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of swallowing characterized by reduced tongue coordination to form bolus after chewing. Food material spreads over the oral cavity instead of being concentrated into a bolus that is easily swallowed.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
