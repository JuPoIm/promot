    <!-- http://purl.obolibrary.org/obo/HP_0008872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0008872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011968"/>
        <obo:IAO_0000115 xml:lang="tr">Bir bebeğin zayıf ve etkisiz emme, kısa süreli emme buruşmaları ve emme sırasında uyku gibi zorluklarla kendini gösteren beslenme performansında bozulma. Dikkati korumak veya çiğnemek ile zorluklar oluşabilir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Zhoršená schopnost kojence při krmení, která se projevuje obtížemi, jako je slabé a neefektivní sání, krátkodobé sání a usínání během sání. Mohou se vyskytnout potíže se žvýkáním nebo udržením pozornosti.</obo:IAO_0000115>
        <obo:IAO_0000115>Impaired feeding performance of an infant as manifested by difficulties such as weak and ineffective sucking, brief bursts of sucking, and falling asleep during sucking. There may be difficulties with chewing or maintaining attention.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002016</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002022</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002568</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C2674608</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">Mauvaise alimentation due à une faiblesse musculaire</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0008872</oboInOwl:id>
        <rdfs:label xml:lang="tr">Bebeklikte beslenme güçlükleri</rdfs:label>
        <rdfs:label xml:lang="it">Difficoltà di alimentazione nella prima infanzia</rdfs:label>
        <rdfs:label xml:lang="es">Dificultades para alimentarse durante la lactancia</rdfs:label>
        <rdfs:label xml:lang="de">Fütterungsschwierigkeiten im Säuglingsalter</rdfs:label>
        <rdfs:label xml:lang="cs">Potíže s krmením u kojenců</rdfs:label>
        <rdfs:label xml:lang="fr">Troubles alimentaires chez l&apos;enfant</rdfs:label>
        <rdfs:label xml:lang="nl">Voedingsproblemen in de kindertijd</rdfs:label>
        <rdfs:label xml:lang="zh">婴儿期喂养困难</rdfs:label>
        <rdfs:label xml:lang="ja">食餌摂取障害 in infancy</rdfs:label>
        <rdfs:label>Feeding difficulties in infancy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008872"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir bebeğin zayıf ve etkisiz emme, kısa süreli emme buruşmaları ve emme sırasında uyku gibi zorluklarla kendini gösteren beslenme performansında bozulma. Dikkati korumak veya çiğnemek ile zorluklar oluşabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired feeding performance of an infant as manifested by difficulties such as weak and ineffective sucking, brief bursts of sucking, and falling asleep during sucking. There may be difficulties with chewing or maintaining attention.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008872"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená schopnost kojence při krmení, která se projevuje obtížemi, jako je slabé a neefektivní sání, krátkodobé sání a usínání během sání. Mohou se vyskytnout potíže se žvýkáním nebo udržením pozornosti.</owl:annotatedTarget>
