    <!-- http://purl.obolibrary.org/obo/HP_0034198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011461"/>
        <obo:IAO_0000115 xml:lang="cs">Tento termín označuje fenotypový znak, který byl poprvé pozorován před porodem během druhého trimestru, který zahrnuje rozmezí gestačního stáří od 14 0/7 týdne do 27 6/7 (včetně).</obo:IAO_0000115>
        <obo:IAO_0000115>This term refers to a phenotypic feature that was first observed prior to birth during the second trimester, which comprises the range of gestational ages from 14 0/7 weeks to 27 6/7 (inclusive).</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-07T16:11:04Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="es">Inicio en el segundo trimestre de la gestación</rdfs:label>
        <rdfs:label xml:lang="pt">Início no segundo trimestre</rdfs:label>
        <rdfs:label xml:lang="cs">Nástup ve druhém trimestru</rdfs:label>
        <rdfs:label>Second trimester onset</rdfs:label>
        <rdfs:label xml:lang="ja">妊娠第2期発症</rdfs:label>
        <rdfs:label xml:lang="zh">孕中期起病</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034198"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento termín označuje fenotypový znak, který byl poprvé pozorován před porodem během druhého trimestru, který zahrnuje rozmezí gestačního stáří od 14 0/7 týdne do 27 6/7 (včetně).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This term refers to a phenotypic feature that was first observed prior to birth during the second trimester, which comprises the range of gestational ages from 14 0/7 weeks to 27 6/7 (inclusive).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034198"/>
