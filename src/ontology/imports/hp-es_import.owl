    <!-- http://purl.obolibrary.org/obo/HP_0001387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001376"/>
        <obo:IAO_0000115 xml:lang="tr">Eklem katılığı hareketsizlik dönemi sonrası hareket ettirmeye çalışıldığında eklemde veya eklemlerde gerginlik hissi algılanmasıdır. Eklem katılığı tipik olarak zamanla hafifler</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Kloubní ztuhlost je pociťovaná tuhost v kloubu nebo kloubech při pokusu o pohyb nebo po období inaktivity. Typicky se časem zvolňuje</obo:IAO_0000115>
        <obo:IAO_0000115>Joint stiffness is a perceived sensation of tightness in a joint or joints when attempting to move them after a period of inactivity. Joint stiffness typically subsides over time.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002775</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0003033</oboInOwl:hasAlternativeId>
