    <!-- http://purl.obolibrary.org/obo/HP_0031826 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <obo:IAO_0000115 xml:lang="cs">Jakákoli anomálie reflexu, tj. automatické reakce zprostředkované nervovým systémem (reflex nevyžaduje zásah vědomé myšlenky, aby se objevil)</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Sinir sistemi tarafından yönlendirilen otomatik bir yanıt (bir refleks meydana gelmesi için bilinçli düşüncenin araya girmesine gerek duymaz) olan refleksin herhangi bir anomalisi</obo:IAO_0000115>
        <obo:IAO_0000115>Any anomaly of a reflex, i.e., of an automatic response mediated by the nervous system (a reflex does not need the intervention of conscious thought to occur).</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-05-02T01:05:40Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="de">Abnormale Reflexe</rdfs:label>
        <rdfs:label xml:lang="nl">Abnormale reflex</rdfs:label>
