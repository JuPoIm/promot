    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030674"/>
        <obo:IAO_0000115 xml:lang="tr">Gebeliğin 8 haftasına kadar olan hastalık baslangıcı</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Nástup onemocnění do 8 týdnů následujících po oplodnění (což odpovídá 10 týdnům těhotenství).</obo:IAO_0000115>
