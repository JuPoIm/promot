    <!-- http://purl.obolibrary.org/obo/HP_0034199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011461"/>
        <obo:IAO_0000115 xml:lang="cs">Tento termín označuje fenotypový znak, který byl poprvé pozorován před narozením v prvním trimestru v časném fetálním období, které je definováno jako 11 0/7 až 13 6/7 týdne těhotenství (včetně).</obo:IAO_0000115>
        <obo:IAO_0000115>This term refers to a phenotypic feature that was first observed prior to birth in the first trimester during the early fetal period, which is defined as 11 0/7 to 13 6/7 weeks of gestation (inclusive).</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-07T16:13:41Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Early fetal onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Early fetal onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Early fetal onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early foetal onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Raný nástup u plodu</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="es">Inicio tardío del primer trimestre de la gestación</rdfs:label>
        <rdfs:label xml:lang="pt">Início no final do primeiro trimestre</rdfs:label>
        <rdfs:label>Late first trimester onset</rdfs:label>
        <rdfs:label xml:lang="cs">Pozdní nástup v prvním trimestru</rdfs:label>
        <rdfs:label xml:lang="ja">妊娠後期の発症</rdfs:label>
        <rdfs:label xml:lang="zh">孕早期晚期起病</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034199"/>
