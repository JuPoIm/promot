    <!-- http://purl.obolibrary.org/obo/HP_0025283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Applied to pain that is tender, i.e., elicited by touching the affected body part.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Etkilenmiş vücut kısmına dokunmak ile ortaya çıkan, hassas ağrı için geçerlidir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Týká se bolesti spojené se zvýšenou citlivostí, tj. vyvolané dotykem postižené části těla.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-18T15:25:03Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="es">Dolor al tacto</rdfs:label>
        <rdfs:label xml:lang="tr">Hassas</rdfs:label>
        <rdfs:label xml:lang="cs">Jemná</rdfs:label>
        <rdfs:label xml:lang="fr">Sensible</rdfs:label>
        <rdfs:label xml:lang="nl">Teder</rdfs:label>
        <rdfs:label>Tender</rdfs:label>
        <rdfs:label xml:lang="ja">圧痛</rdfs:label>
        <rdfs:label xml:lang="zh">温柔的</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Etkilenmiş vücut kısmına dokunmak ile ortaya çıkan, hassas ağrı için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
