    <!-- http://purl.obolibrary.org/obo/HP_0001761 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001760"/>
        <obo:IAO_0000115 xml:lang="tr">Alışılmadık biçimde yüksek plantar ark varlığı. Yüksek tarak olarak da adlandırılır, pes kavus ağırlığa maruz kaldığında ayak tabanında açıkça boşluk olmasına denir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Přítomnost nadměrně elevované klenby nožní. Noha je nadměrně vyklenutá, má vysoký nárt, nazývá se též noha lukovitá.</obo:IAO_0000115>
        <obo:IAO_0000115>An increase in height of the medial longitudinal arch of the foot that does not flatten on weight bearing (i.e., a distinctly hollow form of the sole of the foot when it is bearing weight).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0008075</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MEDDRA:10034743</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:205091006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0728829</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="fr">High-arched foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">High-arched foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Vysoký klenutý nárt</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Yüksek kemerli ayak</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cavus foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>High-arched foot</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001761</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label xml:lang="tw">Kontonkurowi fa a  εsoa biribi  /tↄte,awerε,bↄwer ε</rdfs:label>
        <rdfs:label xml:lang="cs">Pes cavus</rdfs:label>
        <rdfs:label xml:lang="de">Pes cavus</rdfs:label>
        <rdfs:label xml:lang="it">Pes cavus</rdfs:label>
        <rdfs:label xml:lang="nl">Pes cavus</rdfs:label>
        <rdfs:label xml:lang="tr">Pes kavus</rdfs:label>
        <rdfs:label xml:lang="es">Pie cavo</rdfs:label>
