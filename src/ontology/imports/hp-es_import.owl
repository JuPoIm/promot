        <oboInOwl:hasExactSynonym xml:lang="nl">Symptoms present at birth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">d&apos;appararition in utéro</oboInOwl:hasExactSynonym>
