    <!-- http://purl.obolibrary.org/obo/HP_0025304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031796"/>
        <obo:IAO_0000115>Applies to a sign, symptom, or other manifestation that recurs with a fixed time interval, i.e., the symptom-free periods are always of the same length.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Semptomsuz periyotların aynı uzunlukta olduğu yani sabit zaman aralıklı epizodik bir bulgu, belirti veya diğer ortaya çıkış şekli için geçerlidir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se na příznak, symptom nebo jiný projev, který se opakuje s pevným časovým intervalem, tj. období bez symptomů jsou vždy stejně dlouhé</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-21T00:55:09Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Cyclic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Cyclic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Cyclic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cyclical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Cyclical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Cyclical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Cyklický</oboInOwl:hasExactSynonym>
        <rdfs:label>Periodic</rdfs:label>
        <rdfs:label xml:lang="cs">Periodický</rdfs:label>
        <rdfs:label xml:lang="nl">Periodiek</rdfs:label>
        <rdfs:label xml:lang="tr">Periyodik</rdfs:label>
        <rdfs:label xml:lang="es">Periódico</rdfs:label>
        <rdfs:label xml:lang="fr">Périodique</rdfs:label>
        <rdfs:label xml:lang="ja">周期性</rdfs:label>
        <rdfs:label xml:lang="zh">周期性的</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Semptomsuz periyotların aynı uzunlukta olduğu yani sabit zaman aralıklı epizodik bir bulgu, belirti veya diğer ortaya çıkış şekli için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to a sign, symptom, or other manifestation that recurs with a fixed time interval, i.e., the symptom-free periods are always of the same length.</babelon:source_value>
