    <!-- http://purl.obolibrary.org/obo/HP_0031915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011008"/>
        <obo:IAO_0000115 xml:lang="tr">Bu düzenleyici, zamanla ciddiyette veya miktarda değişmeyen fenotipik bir özellik için kullanılır</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Tento modifikátor lze použít na fenotypový znak, jehož závažnost nebo množství se v čase nemění.</obo:IAO_0000115>
        <obo:IAO_0000115>This modifier can be applied to a phenotypic feature that does not vary in severity or amount over time.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-07-01T21:31:19Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="es">Estable</rdfs:label>
        <rdfs:label xml:lang="tr">Sabit</rdfs:label>
