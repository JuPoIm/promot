        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025142"/>
        <obo:IAO_0000115 xml:lang="cs">Obtíže při provádění jedné nebo více činností, které se běžně provádějí denně, jako je stravování, koupání, oblékání, péče o tělo, práce, péče o domácnost a volný čas</obo:IAO_0000115>
