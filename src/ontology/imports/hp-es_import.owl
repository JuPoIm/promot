    <!-- http://purl.obolibrary.org/obo/HP_0009027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003690"/>
        <obo:IAO_0000115 xml:lang="tr">Ayakların dorsifleksiyonundan sorumlu olan kasların zayıflığı, yani, parmak uçlarının ayak parmağına doğru hareketi. Ayak dorsifleksörleri, tibialis anterior, ekstansör hallucis longus, ekstansör digitorum longus ve peroneus tersius kaslar</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Slabost svalů odpovědných za dorzální flexi nohy, tedy pohyb prstů směrem k bérci. Mezi dorziflexory nohy patří m. tibialis anterior, m. extensor hallucis longus, m. extensor digitorum longus a m. peroneus tertius.</obo:IAO_0000115>
        <obo:IAO_0000115>Weakness of the muscles responsible for dorsiflexion of the foot, that is, of the movement of the toes towards the shin. The foot dorsiflexors include the tibialis anterior, the extensor hallucis longus, the extensor digitorum longus, and the peroneus tertius muscles.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003377</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:6077001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0085684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1866141</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="tr">Ayak ekstansör zayıflığı</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Düşük ayak</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Foot drop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Foot drop|Foot extensor weakness|Footdrop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Foot extensor weakness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Footdrop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Inability to heel walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Inability to walk on heels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Ochablé chodidlo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Pokleslá noha</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Slabost extenzoru chodidla</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Foot drop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Foot extensor weakness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Footdrop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inability to heel walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inability to walk on heels</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0009027</oboInOwl:id>
        <rdfs:comment>Dorsiflexion of the foot extends the foot superiorly, as if taking the foot off the gas pedal.</rdfs:comment>
        <rdfs:label xml:lang="tr">Ayak dorsifleksör zayıflığı</rdfs:label>
        <rdfs:label xml:lang="es">Debilidad en dorsiflexión del pie</rdfs:label>
        <rdfs:label xml:lang="it">Debolezza dei dorsiflessori del piede</rdfs:label>
        <rdfs:label xml:lang="fr">Faiblesse musculaire de la dorsiflexion du pied</rdfs:label>
        <rdfs:label xml:lang="de">Schwäche der Fußrückenmuskulatur</rdfs:label>
        <rdfs:label xml:lang="cs">Slabost dorziflexorů chodidla</rdfs:label>
        <rdfs:label xml:lang="nl">Voet dorsiflexor zwakte</rdfs:label>
        <rdfs:label xml:lang="zh">足背屈无力</rdfs:label>
        <rdfs:label xml:lang="ja">足背屈筋虚弱</rdfs:label>
        <rdfs:label>Foot dorsiflexor weakness</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayakların dorsifleksiyonundan sorumlu olan kasların zayıflığı, yani, parmak uçlarının ayak parmağına doğru hareketi. Ayak dorsifleksörleri, tibialis anterior, ekstansör hallucis longus, ekstansör digitorum longus ve peroneus tersius kaslar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Weakness of the muscles responsible for dorsiflexion of the foot, that is, of the movement of the toes towards the shin. The foot dorsiflexors include the tibialis anterior, the extensor hallucis longus, the extensor digitorum longus, and the peroneus tertius muscles.</babelon:source_value>
