    <!-- http://purl.obolibrary.org/obo/HP_0001288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <obo:IAO_0000115 xml:lang="cs">Termín porucha chůze znamená jakékoliv narušení schopnosti chodit. Obecně se může jednat o neurologickou nemoc ale i fraktury či jiné zdroje bolestí spouštěné chůzí. V tomto kontextu je tím však myšlena porucha chůze neurologického či svalového původu</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Yürüme bozukluğu yürüme yeteneğindeki herhangi bir bozulmaya işaret eden bir terimdir. Genel olarak, nörolojik hastalıklara işaret etse de kırıklara veya yürüme ile tetiklenen diğer ağrı kaynaklarına da işaret eder. Bununla birlikte, mevcut bağlamda yürüme bozukluğu nörolojik hastalığa veya kas hastalığı temelinde yürümedeki zorluğa işaret eder</obo:IAO_0000115>
        <obo:IAO_0000115>The term gait disturbance can refer to any disruption of the ability to walk.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002355</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006953</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007101</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0009030</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:22325002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0575081</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="nl">Abnormal gait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Abnormal walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Abnormalita chůze</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Abnormální chůze</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Anormal duruş</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Anormal yürüyüş</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Bozulmuş yürüyüş</oboInOwl:hasExactSynonym>
