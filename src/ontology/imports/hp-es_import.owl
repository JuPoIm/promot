    <!-- http://purl.obolibrary.org/obo/HP_0012535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115 xml:lang="cs">Anomálie v komunikaci od neuronu k cíli přes synapsi. Jedná se o čtyřstupňový proces, který zahrnuje (i) syntézu a ukládání neurotransmiterů; (ii) uvolňování neurotransmiteru; (iii) aktivace postsynaptických receptorů neurotransmiterem; a (iv) inaktivaci neurotransmiteru. Tento termín je tedy definován jako anomálie metabolického procesu neurotransmiterů.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Sinir boyunca bir nörondan bir hedef sinapsının iletişimindeki bir anomali. Bu, (i) nörotransmitterlerin sentezi ve depolanması; (ii) nörotransmitter salınımı; (iii) nörotransmitter tarafından postsinaptik reseptörlerin aktivasyonu; ve (iv) nörotransmitterin inaktivasyonu olarak dört adımlı bir süreçtir. Dolayısıyla bu terim, nörotransmitter metabolik süreç anomalisi olarak tanımlanmaktadır</obo:IAO_0000115>
        <obo:IAO_0000115>An anomaly in the communication from a neuron to a target across a synapse. This is a four step process, comprising (i) synthesis and storage of neurotransmitters; (ii) neurotransmitter release; (iii) activation of postsynaptic receptors by the neurotransmitter; and (iv) inactivation of the neurotransmitter. Thus, this term is defined as an anomaly of neurotransmitter metabolic process.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2013-12-15T10:12:31Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>UMLS:C4021083</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="cs">Abnormalita metabolismu neurotransmiterů</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Abnormality of neurotransmitter metabolism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Abnormality of neurotransmitter metabolism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Nörotransmiter metabolizması anormalliği</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of neurotransmitter metabolism</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012535</oboInOwl:id>
        <rdfs:label xml:lang="cs">Abnormální synaptický přenos</rdfs:label>
        <rdfs:label xml:lang="nl">Afwijkende synaptische transmissie</rdfs:label>
        <rdfs:label xml:lang="tr">Anormal sinaptik iletim</rdfs:label>
        <rdfs:label xml:lang="es">Transmisión sináptica anormal</rdfs:label>
        <rdfs:label xml:lang="fr">Transmission synaptique anormale</rdfs:label>
        <rdfs:label xml:lang="pt">Transmissão sináptica anormal</rdfs:label>
        <rdfs:label xml:lang="ja">異常なシナプス伝達</rdfs:label>
        <rdfs:label xml:lang="zh">突触传递异常</rdfs:label>
        <rdfs:label>Abnormal synaptic transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012535"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie v komunikaci od neuronu k cíli přes synapsi. Jedná se o čtyřstupňový proces, který zahrnuje (i) syntézu a ukládání neurotransmiterů; (ii) uvolňování neurotransmiteru; (iii) aktivace postsynaptických receptorů neurotransmiterem; a (iv) inaktivaci neurotransmiteru. Tento termín je tedy definován jako anomálie metabolického procesu neurotransmiterů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly in the communication from a neuron to a target across a synapse. This is a four step process, comprising (i) synthesis and storage of neurotransmitters; (ii) neurotransmitter release; (iii) activation of postsynaptic receptors by the neurotransmitter; and (iv) inactivation of the neurotransmitter. Thus, this term is defined as an anomaly of neurotransmitter metabolic process.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
