        <rdfs:label xml:lang="tr">Davranışsal anormallik</rdfs:label>
        <rdfs:label xml:lang="nl">Gedragsabnormaliteit</rdfs:label>
        <rdfs:label xml:lang="fr">Troubles psychiatriques ou comportementaux</rdfs:label>
        <rdfs:label xml:lang="ja">行動異常</rdfs:label>
        <rdfs:label xml:lang="zh">非典型行为</rdfs:label>
        <rdfs:label>Atypical behavior</rdfs:label>
