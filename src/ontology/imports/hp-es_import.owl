    <!-- http://purl.obolibrary.org/obo/HP_0031108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008997"/>
        <obo:IAO_0000115 xml:lang="cs">Nedostatek síly v tricepsovém svalu, který je normálně zodpovědný za natažení (narovnání) lokte a zprostředkování určitých pohybů ramena</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Normal olarak dirseğim uzatılması (düzelmesi) ve belli başlı omuz hareketlerinin gerçekleştirilmesini sağlayan triseps kasında güç eksikliği</obo:IAO_0000115>
        <obo:IAO_0000115>A lack of strength in the triceps muscle, which normally is responsible for extending (straightening) the elbow and mediating certain shoulder movements.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-06-09T10:13:45Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="es">Debilidad del tríceps</rdfs:label>
        <rdfs:label xml:lang="fr">Faiblesse du triceps</rdfs:label>
        <rdfs:label xml:lang="cs">Slabost tricepsu</rdfs:label>
        <rdfs:label xml:lang="nl">Triceps zwakte</rdfs:label>
        <rdfs:label xml:lang="tr">Triseps güçsüzlüğü</rdfs:label>
        <rdfs:label xml:lang="ja">上腕三頭筋の筋力低下</rdfs:label>
        <rdfs:label xml:lang="zh">肱三头肌无力</rdfs:label>
        <rdfs:label>Triceps weakness</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nedostatek síly v tricepsovém svalu, který je normálně zodpovědný za natažení (narovnání) lokte a zprostředkování určitých pohybů ramena</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A lack of strength in the triceps muscle, which normally is responsible for extending (straightening) the elbow and mediating certain shoulder movements.</babelon:source_value>
