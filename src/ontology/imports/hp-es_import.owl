    <!-- http://purl.obolibrary.org/obo/HP_0012829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012824"/>
        <obo:IAO_0000115 xml:lang="tr">Fazlasıyla ağır bir derecede (hastalık) şiddetine sahip olma durumu. Niceliksel özellikler için, uygun populasyon ortalamasından 5 standart sapmadan daha fazla bir sapmaya denk gelir</obo:IAO_0000115>
        <obo:IAO_0000115>Having an extremely high degree of severity. For quantitative traits, a deviation of more than five standard deviations from the appropriate population mean.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">S extrémně vysokým stupněm závažnosti. U kvantitativních znaků se jedná o odchylku větší než pět směrodatných odchylek od příslušného populačního průměru.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:creation_date>2014-06-06T07:05:46Z</oboInOwl:creation_date>
