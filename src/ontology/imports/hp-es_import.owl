    <!-- http://purl.obolibrary.org/obo/HP_0025282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025280"/>
        <obo:IAO_0000115>Applied to pain that is dull, i.e., not severe but that continues over a long period of time.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="tr">Ciddi olmayan ancak uzun bir süredir devam eden, sıradan ağrı için geçerlidir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Používá se pro bolest, která je tupá, tj. není silná, ale přetrvává po dlouhou dobu.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-18T15:23:43Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Dull pain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Dull pain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="nl">Dull pain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="tr">Hafif ağrı</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="cs">Tupá bolest</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="es">Dolor sordo persistente</rdfs:label>
