    <!-- http://purl.obolibrary.org/obo/HP_0031177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030237"/>
        <obo:IAO_0000115 xml:lang="tr">Parmakların azalmış esneme(bükme) kapasitesi. Bu durum parmak fleksiyonundaki zayıflığa bağlı olarak elin tam olmayan kapanışı şeklinde ortaya çıkabilir</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost flektovat (ohýbat) prsty. To se může projevit jako neúplné uzavření ruky v důsledku slabé flexe prstů</obo:IAO_0000115>
        <obo:IAO_0000115>Reduced ability to flex (bend) the fingers. This can manifest as incomplete closure of the hand due to weakness in finger flexion.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-06-18T20:25:24Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label xml:lang="es">Debilidad del flexor de los dedos</rdfs:label>
        <rdfs:label xml:lang="it">Debolezza dei flessori delle dita</rdfs:label>
        <rdfs:label xml:lang="fr">Faiblesse des fléchisseurs des doigts</rdfs:label>
        <rdfs:label xml:lang="tr">Parmak fleksör zayıflığı</rdfs:label>
        <rdfs:label xml:lang="de">Schwäche der Fingerbeuger</rdfs:label>
        <rdfs:label xml:lang="cs">Slabost flexorů prstu na ruce</rdfs:label>
        <rdfs:label xml:lang="nl">Vinger flexor zwakte</rdfs:label>
        <rdfs:label xml:lang="ja">指屈筋の筋力低下</rdfs:label>
        <rdfs:label xml:lang="zh">指屈肌无力</rdfs:label>
        <rdfs:label>Finger flexor weakness</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Parmakların azalmış esneme(bükme) kapasitesi. Bu durum parmak fleksiyonundaki zayıflığa bağlı olarak elin tam olmayan kapanışı şeklinde ortaya çıkabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced ability to flex (bend) the fingers. This can manifest as incomplete closure of the hand due to weakness in finger flexion.</babelon:source_value>
