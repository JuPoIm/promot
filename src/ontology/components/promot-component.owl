AnnotationAssertion(rdfs:label obo:PROMOT_0000106 "Double anomalie du CMAP"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_0000106 "Double compound motor action potential abnormality"@en)
SubClassOf(obo:PROMOT_0000106 obo:HP_0033580)

