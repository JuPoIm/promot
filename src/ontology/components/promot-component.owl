AnnotationAssertion(rdfs:comment obo:PROMOT_2000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between a device and a patient, where the patient uses an assistive equipment in order to move or to accomplish something, such as a task or an activity."@en) Annotation(obo:IAO_0000115 "Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad."@es) Annotation(obo:IAO_0000115 "Une relation entre un appareil et un patient où le patient utilise l’appareil pour se déplacer, effectuer une action ou une activité."@fr) Annotation(rdfs:label "es utilizado por"@es) Annotation(rdfs:label "est utilisé par"@fr) Annotation(rdfs:label "is used by"@en) rdfs:label obo:PROMOT_2000001 "is used by"@en)
ObjectPropertyRange(obo:PROMOT_2000001 obo:PROMOT_0000025)

# Object Property: obo:PROMOT_2000002 (assesses)

