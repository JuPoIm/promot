SubClassOf(obo:PROMOT_0000114 ObjectMinCardinality(0 obo:PROMOT_2000002 obo:HP_0031177))
SubClassOf(obo:PROMOT_0000114 ObjectMinCardinality(0 obo:PROMOT_2000002 obo:HP_0033466))

# Class: obo:PROMOT_0000115 (Stair Climb Test)

AnnotationAssertion(Annotation(obo:IAO_0000119 "Definititon of the test provided by the Groupe de Recherche Interdisciplinaire sur les Maladies Neuromusculaires (GRIMN).") obo:IAO_0000115 obo:PROMOT_0000115 "Le test de 10 marches évalue la capacité à monter et descendre un bloc de 10 marches pour deux conditions différentes, soit à la vitesse confortable et à la vitesse maximale. Ce test s’adressent aux participants qui ont la capacité d’utiliser les escaliers."@fr)
AnnotationAssertion(Annotation(obo:IAO_0000119 "Definition translated from French to English from a Reverso’s suggestion.") obo:IAO_0000115 obo:PROMOT_0000115 "The Stair Climb Test evaluates a subject’s ability to climb and descend a 10 steps stair following two different conditions, at comfortable speed and at maximum speed. This test is intended for participants who have the ability to use stairs."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:PROMOT_0000115 "http://snomed.info/id/252482003")
AnnotationAssertion(rdfs:label obo:PROMOT_0000115 "Stair Climb Test"@en)
AnnotationAssertion(rdfs:label obo:PROMOT_0000115 "Test de 10 marches"@fr)
SubClassOf(obo:PROMOT_0000115 <http://snomed.info/id/12894003>)
SubClassOf(obo:PROMOT_0000115 ObjectMinCardinality(0 obo:PROMOT_2000002 obo:HP_0003551))
