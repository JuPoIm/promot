# Object Property: obo:PROMOT_2000001 (is used by)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "A relation between a device and a patient, where the patient uses an assistive equipment in order to move or to accomplish something, such as a task or an activity."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Une relation entre un appareil et un patient où le patient utilise l’appareil pour se déplacer, effectuer une action ou une activité."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000001 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "es utilizado por"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "est utilisé par"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "is used by"@en)
ObjectPropertyRange(obo:PROMOT_2000001 obo:PROMOT_0000025)

# Object Property: obo:PROMOT_2000002 (évalue)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "A relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "Une relation entre une procédure et un patient où la procédure évalue le patient au moyen, par exemple, d’un test, d’un questionnaire ou d’une échelle."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000002 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000002 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "assesses"@en)
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "evalúa"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "évalue"@fr)
