AnnotationAssertion(rdfs:comment obo:PROMOT_2000002 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale."@en) Annotation(obo:IAO_0000115 "Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala."@es) Annotation(obo:IAO_0000115 "Une relation entre une procédure et un patient où la procédure évalue le patient au moyen, par exemple, d’un test, d’un questionnaire ou d’une échelle."@fr) Annotation(rdfs:label "assesses"@en) Annotation(rdfs:label "evalúa"@es) Annotation(rdfs:label "évalue"@fr) rdfs:label obo:PROMOT_2000002 "assesses"@en)
ObjectPropertyDomain(obo:PROMOT_2000002 <http://snomed.info/id/128927009>)

# Object Property: obo:PROMOT_2000003 (measures)

AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation."@en) Annotation(rdfs:label "measures"@en) Annotation(rdfs:label "mesure"@fr) rdfs:label obo:PROMOT_2000003 "measures"@en)

