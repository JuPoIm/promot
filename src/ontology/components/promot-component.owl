############################
#   Annotation Properties
############################

# Annotation Property: obo:PROMOT_1000001 (est trouvé avec)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "An annotation property that indicates the source that supports the need to integrate the class in the ontology."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "La anotación indica la fuente que justifica la presencia de la clase en el modelo."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "Une annotation qui indique la source justifiant la présence de la classe dans le modèle."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_1000001 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_1000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "encontrado gracias a"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "est trouvé avec"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "found in"@en)
AnnotationPropertyRange(obo:PROMOT_1000001 xsd:string)


############################
#   Object Properties
############################

# Object Property: obo:PROMOT_2000001 (is used by)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "A relation between an assistive device and a patient, where the patient uses the device in order to accomplish something, such as a task or an activity (e.g. moving, reading)."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Une relation entre un appareil et un patient où le patient utilise l’appareil pour effectuer une action ou une activité, comme, par exemple, pour se déplacer ou pour lire."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000001 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "es utilizado por"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "est utilisé par"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "is used by"@en)
ObjectPropertyRange(obo:PROMOT_2000001 obo:PROMOT_0000025)

# Object Property: obo:PROMOT_2000002 (évalue)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive)."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000002 "Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000002 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000002 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "assesses"@en)
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "evalúa"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_2000002 "évalue"@fr)
ObjectPropertyDomain(obo:PROMOT_2000002 <http://snomed.info/id/128927009>)

# Object Property: obo:PROMOT_2000003 (mesure)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000003 "A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000003 "Une relation entre une procédure d’évaluation et l’entité qu’elle mesure, comme, par exemple, une structure organique, une fonction biologique ou une activité ou une participation."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000003 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(oboInOwl:hasDbXref obo:PROMOT_2000003 "SCDO:1000194")
AnnotationAssertion(rdfs:label obo:PROMOT_2000003 "measures"@en)
AnnotationAssertion(rdfs:label obo:PROMOT_2000003 "mesure"@fr)
ObjectPropertyDomain(obo:PROMOT_2000003 <http://snomed.info/id/128927009>)

# Object Property: obo:PROMOT_2000004 (has genetic mutation)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000004 "A relation between an organism and a specific gene mutation that exists in the genome of that organism."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000004 "Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000004 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(oboInOwl:hasDbXref obo:PROMOT_2000004 "VO:0001039")
AnnotationAssertion(rdfs:label obo:PROMOT_2000004 "est porteur de la mutation"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000004 "has genetic mutation"@en)
ObjectPropertyDomain(obo:PROMOT_2000004 <http://semanticscience.org/resource/SIO_010000>)
ObjectPropertyRange(obo:PROMOT_2000004 obo:PROMOT_0000001)

# Object Property: obo:PROMOT_2000005 (affecte)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000005 "A relation between two entity where the first entity affects the state of the second entity."@en)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000005 "Une relation entre deux entités où l’existence de la première affecte l’état de la seconde."@fr)
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000005 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(oboInOwl:hasDbXref obo:PROMOT_2000005 "BIOLINK:affects")
AnnotationAssertion(oboInOwl:hasDbXref obo:PROMOT_2000005 "SIO:001158")
AnnotationAssertion(rdfs:label obo:PROMOT_2000005 "affecte"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000005 "affects"@en)
