AnnotationAssertion(rdfs:comment obo:PROMOT_1000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Indicates the source from which we found the class."@en) Annotation(obo:IAO_0000115 "La anotación indica la fuente que justifica la presencia de la clase en el modelo."@es) Annotation(obo:IAO_0000115 "L’annotation indique la source qui justifie la présence de la classe dans le modèle."@fr) Annotation(rdfs:label "encontrado gracias a"@es) Annotation(rdfs:label "est trouvé avec"@fr) rdfs:label obo:PROMOT_1000001 "found in")
