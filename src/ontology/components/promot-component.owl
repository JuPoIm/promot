############################
#   Annotation Properties
############################

# Annotation Property: obo:PROMOT_1000001 (est trouvé avec)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_1000001 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_1000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "La anotación indica la fuente que justifica la presencia de la clase en el modelo."@es) rdfs:label obo:PROMOT_1000001 "encontrado gracias a"@es)
AnnotationAssertion(Annotation(obo:IAO_0000115 "L’annotation indique la source qui justifie la présence de la classe dans le modèle."@fr) rdfs:label obo:PROMOT_1000001 "est trouvé avec"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "Indicates the source from which we found the class."@en) rdfs:label obo:PROMOT_1000001 "found in")
AnnotationPropertyRange(obo:PROMOT_1000001 xsd:string)


############################
#   Object Properties
############################

# Object Property: obo:PROMOT_2000001 (es utilizado por)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000001 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad."@es) rdfs:label obo:PROMOT_2000001 "es utilizado por"@es)
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre un appareil et un patient où le patient utilise l’appareil pour se déplacer, effectuer une action ou une activité."@fr) rdfs:label obo:PROMOT_2000001 "est utilisé par"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an assistive device and a patient, where the patient uses the device in order to move or to accomplish something, such as a task or an activity."@en) rdfs:label obo:PROMOT_2000001 "is used by")
ObjectPropertyRange(obo:PROMOT_2000001 obo:PROMOT_0000025)

# Object Property: obo:PROMOT_2000002 (evalúa)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000002 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000002 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala."@es) rdfs:label obo:PROMOT_2000002 "evalúa"@es)
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre une procédure d’évaluation et une entité, tel qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté."@fr) rdfs:label obo:PROMOT_2000002 "évalue"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale."@en) rdfs:label obo:PROMOT_2000002 "assesses")
ObjectPropertyDomain(obo:PROMOT_2000002 <http://snomed.info/id/128927009>)

# Object Property: obo:PROMOT_2000003 (measures)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000003 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre une procédure d’évaluation et l’entité qu’elle mesure"@fr) rdfs:label obo:PROMOT_2000003 "mesure"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation."@en) rdfs:label obo:PROMOT_2000003 "measures")

# Object Property: obo:PROMOT_2000004 (est porteur d’une mutation)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000004 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme."@fr) rdfs:label obo:PROMOT_2000004 "est porteur d’une mutation"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between an organism and a specific gene mutation existing in the organism genome."@en) rdfs:label obo:PROMOT_2000004 "has genetic mutation")
ObjectPropertyDomain(obo:PROMOT_2000004 <http://semanticscience.org/resource/SIO_010000>)
ObjectPropertyRange(obo:PROMOT_2000004 obo:PROMOT_0000001)

# Object Property: obo:PROMOT_2000005 (affecte)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000005 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre deux entités ou l’existence de la première affecte l’état de la seconde."@fr) rdfs:label obo:PROMOT_2000005 "affecte"@fr)
AnnotationAssertion(Annotation(obo:IAO_0000115 "A relation between two entity where the first entity affects the state of the second entity."@en) rdfs:label obo:PROMOT_2000005 "affects")
ObjectPropertyDomain(obo:PROMOT_2000005 obo:HP_0000118)

# Object Property: obo:PROMOT_2000006 (est l’identifiant unique pour)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000006 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000006 "Xref SIO:000674")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Une relation entre un identifiant et l’entité qu’il identifie. Il ne peut identifier que l’entité en question."@fr) rdfs:label obo:PROMOT_2000006 "est l’identifiant unique pour"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000006 "is unique identifier for")

# Object Property: obo:PROMOT_2000007 (a comme résultat)

AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000007 "https://orcid.org/0009-0000-5160-7927")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000007 "Xref SIO:000229")
AnnotationAssertion(Annotation(obo:IAO_0000115 "Un relation entre un process et le résultat produit par celui-ci."@fr) rdfs:label obo:PROMOT_2000007 "a comme résultat"@fr)
