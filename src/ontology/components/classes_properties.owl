#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/PROMOT_2000001> (is location of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PROMOT_2000001> "a relation between a phenotypically related anatomical entity and a phenotype, where the phenotype is located in the phenotypically related anatomical entity.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/PROMOT_2000001> "Juliette Potier")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PROMOT_2000001> "is location of")
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_2000001> <http://purl.obolibrary.org/obo/PROMOT_7000001>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_2000001> <http://purl.obolibrary.org/obo/HP_0000118>)

# Object Property: <http://purl.obolibrary.org/obo/PROMOT_2000002> (is used by)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PROMOT_2000002> "a relation between a device and a patient, where the patient uses an assistive equipment in order to move or to accomplish something, such as a task or an activity.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/PROMOT_2000002> "Juliette Potier")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PROMOT_2000002> "is used by")
ObjectPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_2000002> <http://snomed.info/id/360296002>)

# Object Property: <http://purl.obolibrary.org/obo/PROMOT_2000003> (assesses)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PROMOT_2000003> "a relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/PROMOT_2000003> "Juliette Potier")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PROMOT_2000003> "assesses")
ObjectPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_2000003> <http://snomed.info/id/386053000>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002351> (<http://purl.obolibrary.org/obo/RO_0002351>)

