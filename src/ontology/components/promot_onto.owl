# Annotation Property: obo:PROMOT_1000001 (est trouvé avec)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "La anotación indica la fuente que justifica la presencia de la clase en el modelo."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "L’annotation indique la source qui justifie la présence de la classe dans le modèle."@fr)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_1000001 "Indicates the source from which we found the class.")
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_1000001 "Juliette Potier")
AnnotationAssertion(rdfs:comment obo:PROMOT_1000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "encontrado gracias a"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "est trouvé avec"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_1000001 "found in"@en)
AnnotationPropertyRange(obo:PROMOT_1000001 xsd:string)


############################
#   Object Properties
############################

# Object Property: obo:PROMOT_2000001 (es la localización de)

AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Una relación entre una entidad anatómica y un fenotipo donde el fenotipo está localizado en el nivel de la entidad anatómica."@es)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "Une relation entre une entité anatomique et un phénotype où le phénotype est localisé au niveau de l’entité anatomique."@fr)
AnnotationAssertion(obo:IAO_0000115 obo:PROMOT_2000001 "A relation between a phenotypically related anatomical entity and a phenotype, where the phenotype is located in the phenotypically related anatomical entity.")
AnnotationAssertion(obo:IAO_0000117 obo:PROMOT_2000001 "Juliette Potier")
AnnotationAssertion(rdfs:comment obo:PROMOT_2000001 "JP: Translated to spanish using Bing Translator")
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "es la localización de"@es)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "est la localisation de"@fr)
AnnotationAssertion(rdfs:label obo:PROMOT_2000001 "is location of"@en)
ObjectPropertyDomain(obo:PROMOT_2000001 obo:PROMOT_7000001)
ObjectPropertyRange(obo:PROMOT_2000001 obo:HP_0000118)

# Object Property: obo:PROMOT_2000002 (is used by)

