Import(<http://purl.obolibrary.org/obo/promot/imports/obi_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/ro_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/scdo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/sio_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/snomed_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/vo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/whofic_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/patterns/definitions.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-18/imports/bfo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-18/imports/iao_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-18/imports/ro_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-18/imports/scdo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-18/imports/vo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-06-25/imports/mondo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-03/imports/sio_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-03/imports/snomed_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-03/imports/whofic_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-30/components/classes_properties.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-04/imports/fma_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-30/imports/hp_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-04/imports/obi_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-07-30/patterns/definitions.owl>)
Annotation(dce:contributor "Anita Burgun MD, PhD")
Annotation(dce:contributor "Carole Faviez PhD")
Annotation(dce:contributor "Cynthia Gagnon PhD")
Annotation(dce:contributor "ERDERA — European Rare Diseases Research Alliance")
Annotation(dce:contributor "Elizabeth Angelevski")
Annotation(dce:contributor "Mansoore Gholizade MD")
Annotation(dce:contributor "Daniel Natera De Benito MD, PhD")
Annotation(dce:contributor "Hanns Lochmuller MD, PhD")
Annotation(dce:creator "Juliette Potier MSc")
Annotation(dce:creator "Paul Fabry MD, PhD student")
Annotation(dcterms:description "Ontology for building the relational database of the PROMOT project")
Annotation(dcterms:title "PROMOT Common Data Model ontology")

Declaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0000000>))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/FMA_5022> (Muscle organ)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_5022> <http://purl.obolibrary.org/obo/FMA_62955>)

# Class: <http://purl.obolibrary.org/obo/FMA_7490> (Joint)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_7490> <http://purl.obolibrary.org/obo/FMA_62955>)

# Class: <http://purl.obolibrary.org/obo/HP_0031797> (Clinical course)

SubClassOf(<http://purl.obolibrary.org/obo/HP_0031797> <http://purl.obolibrary.org/obo/HP_0000118>)

# Class: <http://purl.obolibrary.org/obo/NCBITaxon_9606> (<http://purl.obolibrary.org/obo/NCBITaxon_9606>)

