Prefix(:=<http://purl.obolibrary.org/obo/promot.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<http://purl.obolibrary.org/obo/promot.owl>
Import(<http://purl.obolibrary.org/obo/promot/components/pheno_with_relations.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/bfo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/efo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/fma_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/hp_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/mondo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/ncit_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/obi_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/orcidio_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/ro_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/snomed_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/whofic_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-05-20/imports/bfo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-05-20/imports/fma_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-05-20/imports/mondo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-05-20/imports/ro_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/releases/2025-05-26/imports/hp_import.owl>)
Annotation(dcterms:description "Ontology for building the relational database of the PROMOT project")
Annotation(dcterms:license <https://creativecommons.org/licenses/unspecified>)
Annotation(dcterms:title "PROMOT Common Data Model ontology")

Declaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0000000>))
Declaration(AnnotationProperty(dce:creator))
Declaration(AnnotationProperty(dce:date))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/RO_0001015> (location of)

ObjectPropertyDomain(<http://purl.obolibrary.org/obo/RO_0001015> <http://purl.obolibrary.org/obo/FMA_62955>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0001025> (located in)

ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0001025> <http://purl.obolibrary.org/obo/FMA_62955>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002200> (has phenotype)

ObjectPropertyDomain(<http://purl.obolibrary.org/obo/RO_0002200> <http://purl.obolibrary.org/obo/MONDO_0000001>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002201> (phenotype of)

ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0002201> <http://purl.obolibrary.org/obo/MONDO_0000001>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0004013> (is causal germline mutation in)

ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0004013> <http://purl.obolibrary.org/obo/MONDO_0000001>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0004029> (disease has feature)

ObjectPropertyDomain(<http://purl.obolibrary.org/obo/RO_0004029> <http://purl.obolibrary.org/obo/MONDO_0000001>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0004030> (disease arises from alteration in structure)

ObjectPropertyDomain(<http://purl.obolibrary.org/obo/RO_0004030> <http://purl.obolibrary.org/obo/MONDO_0000001>)



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/FMA_23133> (Anatomical coordinate)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_23133> <http://purl.obolibrary.org/obo/BFO_0000141>)

# Class: <http://purl.obolibrary.org/obo/FMA_5022> (Muscle organ)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_5022> <http://purl.obolibrary.org/obo/FMA_62955>)

# Class: <http://purl.obolibrary.org/obo/FMA_52549> (Anatomical laterality)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_52549> <http://purl.obolibrary.org/obo/BFO_0000141>)

# Class: <http://purl.obolibrary.org/obo/FMA_62955> (Anatomical entity)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_62955> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/FMA_7490> (Joint)

SubClassOf(<http://purl.obolibrary.org/obo/FMA_7490> <http://purl.obolibrary.org/obo/FMA_62955>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0000001> (disease)

SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0000001> <http://purl.obolibrary.org/obo/BFO_0000016>)

# Class: <http://purl.obolibrary.org/obo/PROMOT_0000000> (root node)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PROMOT_0000000> "root node"@en)


)