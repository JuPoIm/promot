Import(<http://purl.obolibrary.org/obo/promot/imports/ro_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/scdo_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/sio_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/snomed_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/so_import.owl>)
Import(<http://purl.obolibrary.org/obo/promot/imports/vo_import.owl>)
