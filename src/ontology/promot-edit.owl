Annotation(dcterms:description "Ontology for modeling the three following neuromuscular diseases : OPMD, Congenital myopathies and Congenital myastenic syndroms. It aims to be also an ontology for building the PROMOT project relational database.")
Annotation(dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0/>)
Annotation(dcterms:title "PROMOT ontology")
