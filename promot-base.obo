[Typedef]
id: PROMOT:2000002
name: assesses
def: "A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive)." []
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
domain: SNOMED:128927009
inverse_of: PROMOT:2000005 ! is assessed by

[Typedef]
id: PROMOT:2000005
name: is assessed by
def: "A relation between an entity and the evaluation procedure that assesses the entity." []

[Typedef]
id: PROMOT:2000006
name: is measured by
def: "A relation between an entity and the evaluation procedure that measures the entity." []

[Typedef]
id: PROMOT:2000007
name: is related to
def: "A relation between two organisms where the two organisms share a biological bond." []
xref: SIO:000709
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

[Typedef]
id: PROMOT:2000008
name: is used by
def: "A relation between an assistive device and a patient, where the patient uses the device in order to accomplish something, such as a task or an activity (e.g. moving, reading)." []
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
range: NCIT:C16960

