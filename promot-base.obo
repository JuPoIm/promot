domain: PROMOT:7000001 ! Phenotypically related anatomical entity
range: HP:0000118

[Typedef]
id: PROMOT:2000002
name: is used by
def: "a relation between a device and a patient, where the patient uses an assistive equipment in order to move or to accomplish something, such as a task or an activity." []
property_value: IAO:0000117 "Juliette Potier" xsd:string
domain: http://snomed.info/id/360296002
range: PROMOT:3000001 ! Patient

[Typedef]
id: PROMOT:2000003
name: assesses
def: "a relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale." []
