[Term]
id: PROMOT:0110001
name: Actividad {comment="translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772", babelon:translation_status="OFFICIAL"}
name: Activity
name: Activité
def: "Actividad es la realización de una tarea o acción por parte de una persona. Las limitaciones en la actividad son dificultades que una persona puede tener para realizar una tarea o acción." [] {IAO:0000119="Clasificación Internacional del Funcionamiento, de la Discapacidad y de la Salud, translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772", babelon:translation_status="OFFICIAL"}
def: "An activity is the execution of a task or action by an individual. Activity limitations are difficulties an individual may have in executing activities." [] {IAO:0000119="International Classification of Functioning, Disability and Health (ICF)"}
def: "Une activité signifie l'exécution d'une tâche ou le fait pour une personne de faire quelque chose. Les limitations d'activité désignent les difficultés qu'une personne peut rencontrer pour mener une activité." [] {IAO:0000119="Classification internationale du fonctionnement, du handicap et de la santé"}
is_a: BFO:0000015 ! process
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
property_value: seeAlso ICF:1394728112

[Term]
id: PROMOT:0120002
name: Participación {comment="translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772", babelon:translation_status="OFFICIAL"}
name: Participation
def: "A participation is an involvement in a life situation. Participation restrictions are problems an individual may experience in involvement in life situations." [] {IAO:0000119="International Classification of Functioning, Disability and Health (ICF)"}
def: "La participation signifie le fait de prendre part à une situation de la vie réelle. Les restrictions de participation désignent les problèmes qu'une personne peut rencontrer pour participer à une situation réelle." [] {IAO:0000119="Classification internationale du fonctionnement, du handicap et de la santé"}
def: "Participación es involucrarse en una situación de la vida cotidiana. Las restricciones en la participación son problemas que una persona puede experimentar al involucrarse en situaciones de la vida cotidiana." [] {IAO:0000119="Clasificación Internacional del Funcionamiento, de la Discapacidad y de la Salud, translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772", babelon:translation_status="OFFICIAL"}
is_a: BFO:0000015 ! process
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
property_value: seeAlso ICF:1394728112

