[Typedef]
id: PROMOT:2000002
name: assesses
name: evalúa {babelon:translation_status="CANDIDATE"}
name: évalue {babelon:translation_status="CANDIDATE"}
def: "A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive)." []
def: "Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala." [] {babelon:translation_status="CANDIDATE", IAO:0000119="JP: Translated to spanish using Bing Translator"}
def: "Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté." [] {babelon:translation_status="CANDIDATE"}
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
domain: SNOMED:128927009 ! Procedure by method
inverse_of: PROMOT:2000005 ! est évalué par

[Typedef]
id: PROMOT:2000003
name: est porteur de la mutation {babelon:translation_status="CANDIDATE"}
name: has genetic mutation
def: "A relation between an organism and a specific gene mutation that exists in the genome of that organism." []
def: "Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme." [] {babelon:translation_status="CANDIDATE"}
xref: VO:0001039
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
domain: NCIT:C14250 ! organism
range: SO:0001060 ! sequence_variant

[Typedef]
id: PROMOT:2000004
name: a pour identifiant {babelon:translation_status="CANDIDATE"}
name: has identifier
def: "A relation between an entity and its identifier where the identifier allows to indentify the first entity." []
def: "Une relation entre une entité et son identifiant, où l’identifiant sert à identifier la première entité." [] {babelon:translation_status="CANDIDATE"}
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
