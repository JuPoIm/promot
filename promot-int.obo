[Typedef]
id: PROMOT:2000007
name: est lié à {babelon:translation_status="CANDIDATE"}
name: is related to
def: "A relation between two organisms where the two organisms share a biological bond." []
def: "Une relation entre deux organismes où les organismes partagent un lien de parenté biologique." [] {babelon:translation_status="CANDIDATE"}
xref: SIO:000709
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

[Typedef]
id: PROMOT:2000008
name: es utilizado por {babelon:translation_status="CANDIDATE"}
name: est utilisé par {babelon:translation_status="CANDIDATE"}
name: is used by
def: "A relation between an assistive device and a patient, where the patient uses the device in order to accomplish something, such as a task or an activity (e.g. moving, reading)." []
def: "Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad." [] {babelon:translation_status="CANDIDATE", IAO:0000119="JP: Translated to spanish using Bing Translator"}
def: "Une relation entre un appareil et un patient où le patient utilise l’appareil pour effectuer une action ou une activité, comme, par exemple, pour se déplacer ou pour lire." [] {babelon:translation_status="CANDIDATE"}
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string
range: NCIT:C16960 ! Patient

[Typedef]
id: PROMOT:2000009
name: measures
name: mesure {babelon:translation_status="CANDIDATE"}
def: "A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation." []
def: "Une relation entre une procédure d’évaluation et l’entité qu’elle mesure, comme, par exemple, une structure organique, une fonction biologique ou une activité ou une participation." [] {babelon:translation_status="CANDIDATE"}
xref: SCDO:1000194
