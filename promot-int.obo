name: is assessed by
def: "A relation between an entity and the evaluation procedure that assesses the entity." []
def: "Une relation entre une entité et une procédure d’évaluation, où la procédure sert à évaluer la première entité." [] {babelon:translation_status="CANDIDATE"}

[Typedef]
id: PROMOT:2000006
name: est mesuré par {babelon:translation_status="CANDIDATE"}
