[Term]
id: PROMOT:0032022
name: Fatiga cuando se come {comment="translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772", babelon:translation_status="OFFICIAL"}
name: Fatigue corrélée au fait de manger {comment="translated from English by https://orcid.org/0009-0000-5160-7927 reviewed by https://orcid.org/0000-0003-2829-847", babelon:translation_status="OFFICIAL"}
name: Fatigue while eating
def: "A fatigue that occurs when one is eating. It is due to weakness or fatiguable weakness of chewing muscles." [] {comment="https://orcid.org/0000-0003-2829-8470", IAO:0000119="Clinical experts"}
def: "Fatiga que se produce al momento de comer debida a la debilidad muscular o a la fatiga del músculo involucrados en la masticación." [] {babelon:translation_status="OFFICIAL", IAO:0000119="translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772"}
