name: Anomalie des mouvements {babelon:translation_language="fr", babelon:comment="label of HP:0100022 (Abnormality of movement)  ; abnormality of the nervous system", babelon:translation_status="OFFICIAL", babelon:source_value="Abnormality of movement", babelon:source_language="en"}
