owl-axioms: Prefix(owl:=<http://www.w3.org/2002/07/owl#>)\nPrefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)\nPrefix(xml:=<http://www.w3.org/XML/1998/namespace>)\nPrefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)\nPrefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)\n\n\nOntology(\nDeclaration(Class(<http://id.who.int/icd/entity/1580195090>))\nDeclaration(Class(<http://id.who.int/icd/entity/744367503>))\nDeclaration(Class(<http://id.who.int/icd/entity/923782542>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0000183>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0001324>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0002015>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0003551>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0004325>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0009005>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0009028>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0030237>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0032341>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0033235>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/HP_0033667>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/NCIT_C178992>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/NCIT_C25150>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/NCIT_C25164>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/NCIT_C93511>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/NCIT_C93579>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010001>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010003>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010004>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010005>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010006>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010007>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0010052>))\nDeclaration(Class(<http://purl.obolibrary.org/obo/PROMOT_0032013>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma0328100>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma37370>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma37371>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma37372>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma58274>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma9616>))\nDeclaration(Class(<http://purl.org/sig/ont/fma/fma9617>))\nDeclaration(Class(<http://snomed.info/id/11286003>))\nDeclaration(Class(<http://snomed.info/id/12894003>))\nDeclaration(Class(<http://snomed.info/id/184099003>))\nDeclaration(Class(<http://snomed.info/id/19343003>))\nDeclaration(Class(<http://snomed.info/id/298059007>))\nDeclaration(Class(<http://snomed.info/id/399423000>))\nDeclaration(Class(<http://snomed.info/id/399753006>))\nDeclaration(Class(<http://snomed.info/id/406543005>))\nDeclaration(Class(<http://snomed.info/id/432213005>))\nDeclaration(Class(<http://snomed.info/id/439272007>))\nDeclaration(Class(<http://snomed.info/id/5880005>))\nDeclaration(Class(<http://snomed.info/id/60614009>))\nDeclaration(Class(<http://snomed.info/id/73678001>))\nDeclaration(Class(<http://snomed.info/id/81276006>))\nDeclaration(Class(<http://snomed.info/id/840297006>))\nDeclaration(Class(<http://snomed.info/id/84100007>))\nDeclaration(ObjectProperty(<http://purl.obolibrary.org/obo/PROMOT_2000005>))\nDeclaration(ObjectProperty(<http://purl.obolibrary.org/obo/PROMOT_2000006>))\nDeclaration(ObjectProperty(<http://purl.obolibrary.org/obo/RO_0002351>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000001>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000002>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000003>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000004>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000005>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000006>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000007>))\nDeclaration(DataProperty(<http://purl.obolibrary.org/obo/PROMOT_3000008>))\nDeclaration(AnnotationProperty(<http://purl.obolibrary.org/obo/PROMOT_1000001>))\nDeclaration(Datatype(xsd:date))\nDeclaration(Datatype(xsd:duration))\nDeclaration(Datatype(xsd:gYear))\n############################\n#   Annotation Properties\n############################\n\n# Annotation Property: <http://purl.obolibrary.org/obo/PROMOT_1000001> (<http://purl.obolibrary.org/obo/PROMOT_1000001>)\n\nAnnotationPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_1000001> xsd:string)\n\n\n############################\n#   Object Properties\n############################\n\n# Object Property: <http://purl.obolibrary.org/obo/RO_0002351> (<http://purl.obolibrary.org/obo/RO_0002351>)\n\nIrreflexiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002351>)\n\n\n############################\n#   Data Properties\n############################\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000001> (<http://purl.obolibrary.org/obo/PROMOT_3000001>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000001> <http://purl.obolibrary.org/obo/PROMOT_0010001>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000001> xsd:int)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000002> (<http://purl.obolibrary.org/obo/PROMOT_3000002>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000002> <http://purl.obolibrary.org/obo/NCIT_C25164>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000002> xsd:date)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000003> (<http://purl.obolibrary.org/obo/PROMOT_3000003>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000003> <http://purl.obolibrary.org/obo/PROMOT_0010003>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000003> xsd:decimal)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000004> (<http://purl.obolibrary.org/obo/PROMOT_3000004>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000004> <http://purl.obolibrary.org/obo/PROMOT_0010004>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000004> xsd:duration)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000005> (<http://purl.obolibrary.org/obo/PROMOT_3000005>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000005> <http://purl.obolibrary.org/obo/PROMOT_0010005>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000005> xsd:int)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000006> (<http://purl.obolibrary.org/obo/PROMOT_3000006>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000006> <http://purl.obolibrary.org/obo/PROMOT_0010006>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000006> xsd:token)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000007> (<http://purl.obolibrary.org/obo/PROMOT_3000007>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000007> <http://purl.obolibrary.org/obo/PROMOT_0010007>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000007> xsd:gYear)\n\n# Data Property: <http://purl.obolibrary.org/obo/PROMOT_3000008> (<http://purl.obolibrary.org/obo/PROMOT_3000008>)\n\nDataPropertyDomain(<http://purl.obolibrary.org/obo/PROMOT_3000008> <http://purl.obolibrary.org/obo/PROMOT_0010052>)\nDataPropertyRange(<http://purl.obolibrary.org/obo/PROMOT_3000008> xsd:boolean)\n\n\n\n############################\n#   Classes\n############################\n\n# Class: <http://id.who.int/icd/entity/1580195090> (<http://id.who.int/icd/entity/1580195090>)\n\nSubClassOf(<http://id.who.int/icd/entity/1580195090> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000006> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/840297006>)))\n\n# Class: <http://id.who.int/icd/entity/744367503> (<http://id.who.int/icd/entity/744367503>)\n\nSubClassOf(<http://id.who.int/icd/entity/744367503> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000006> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/840297006>)))\n\n# Class: <http://id.who.int/icd/entity/923782542> (<http://id.who.int/icd/entity/923782542>)\n\nSubClassOf(<http://id.who.int/icd/entity/923782542> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000006> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/840297006>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0000183> (<http://purl.obolibrary.org/obo/HP_0000183>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0000183> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0001324> (<http://purl.obolibrary.org/obo/HP_0001324>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0001324> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0002015> (<http://purl.obolibrary.org/obo/HP_0002015>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0002015> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/840297006> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0003551> (<http://purl.obolibrary.org/obo/HP_0003551>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0003551> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0004325> (<http://purl.obolibrary.org/obo/HP_0004325>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0004325> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/5880005> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0009005> (<http://purl.obolibrary.org/obo/HP_0009005>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0009005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0009028> (<http://purl.obolibrary.org/obo/HP_0009028>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0009028> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0030237> (<http://purl.obolibrary.org/obo/HP_0030237>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0030237> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0032341> (<http://purl.obolibrary.org/obo/HP_0032341>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0032341> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0033235> (<http://purl.obolibrary.org/obo/HP_0033235>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0033235> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://snomed.info/id/84100007>)))\n\n# Class: <http://purl.obolibrary.org/obo/HP_0033667> (<http://purl.obolibrary.org/obo/HP_0033667>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/HP_0033667> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/PROMOT_2000005> ObjectUnionOf(<http://snomed.info/id/12894003> <http://sno