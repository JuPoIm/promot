[Term]
id: HP:0033666
name: Diminished physical functioning
name: Funcionamiento físico disminuido {babelon:source_value="Diminished physical functioning", babelon:translation_status="OFFICIAL", babelon:source_language="en", babelon:translation_language="es"}
def: "A reduction in the ability to perform activities of daily living as compared to previous abilities because of functional deficits due to illness. The 36-item Short Form (SF-36) health survey questionnaire is one of many methods used to measure patients' perceptions of diminished physical functioning." []
synonym: "Decline in physical functional health" EXACT []
synonym: "Diminished physical health" EXACT []
