[Term]
id: HP:0002804
name: Arthrogrypose multiple congénitale {babelon:translation_language="fr", babelon:source_value="Arthrogryposis multiplex congenita", babelon:comment="label of HP:0002804 (Arthrogryposis multiplex congenita)  ; abnormality of the musculature ; abnormality of the skeletal system ; abnormality of connective tissue", babelon:translation_status="OFFICIAL", babelon:source_language="en"}
name: Arthrogryposis multiplex congenita
name: Artrogriposis múltiple congénita {babelon:source_value="Arthrogryposis multiplex congenita", babelon:translation_status="OFFICIAL", babelon:source_language="en", babelon:translation_language="es"}
alt_id: HP:0001389
