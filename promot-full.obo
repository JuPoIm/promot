[Term]
id: HP:0001249
name: Intellectual disability
alt_id: HP:0000730
alt_id: HP:0001261
alt_id: HP:0001267
alt_id: HP:0001286
alt_id: HP:0002122
alt_id: HP:0002192
alt_id: HP:0002316
