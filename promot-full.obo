id: SNOMED:266731002
name: Walking frame
is_a: SNOMED:224899006 ! Walking aid
property_value: dc11:type "physical object" xsd:string
property_value: sct-ext:definitionStatus "Primitif" xsd:string
property_value: sct-ext:fsn "Walking frame (physical object)" xsd:string
property_value: skos:altLabel "cadre de marche" xsd:string
property_value: skos:altLabel "dispositivo para andador" xsd:string
property_value: skos:altLabel "WF - Walking frame" xsd:string
property_value: skos:definition "A frame consisting of 3 or 4 legs which aids a person with walking. Some walking frames come with wheels at the front to help move the frame. The frame is moved by either lifting the entire frame or by tilting the frame off the back legs and onto the front wheels." xsd:string
property_value: skos:definition "Un andador de 3 o 4 patas que asiste a la persona en la marcha. Algunos andadores tienen ruedas en la parte delantera para facilitar la movilidad del dispositivo. El andador se desplaza levantándolo por completo o levantando las patas traseras e inclinándolo sobre las ruedas delanteras." xsd:string
property_value: skos:notation "266731002" xsd:string
property_value: skos:prefLabel "dispositivos para andar" xsd:string
property_value: skos:prefLabel "Walking frame" xsd:string

