property_value: dc11:contributor "Carole Faviez PhD\nhttps://orcid.org/0000-0002-1500-0236" xsd:string
property_value: dc11:contributor "Claudia Côté MD, PhD\nhttps://orcid.org/0000-0003-2508-2500" xsd:string
property_value: dc11:contributor "Daniel Natera De Benito MD, PhD\nhttps://orcid.org/0000-0001-7764-2085" xsd:string
