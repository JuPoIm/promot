property_value: BFO:0000180 "TwoDimensionalContinuantFiatBoundary" xsd:string
property_value: IAO:0000600 "a two-dimensional continuant fiat boundary (surface) is a self-connected fiat surface whose location is defined in relation to some material entity. (axiom label in BFO2 Reference: [033-001])" xsd:string {IAO:0010000="http://purl.obolibrary.org/obo/bfo/axiom/033-001"}
property_value: IAO:0000602 "(iff (TwoDimensionalContinuantFiatBoundary a) (and (ContinuantFiatBoundary a) (exists (b) (and (TwoDimensionalSpatialRegion b) (forall (t) (locatedInAt a b t)))))) // axiom label in BFO2 CLIF: [033-001] " xsd:string {IAO:0010000="http://purl.obolibrary.org/obo/bfo/axiom/033-001"}
