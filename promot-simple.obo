[Term]
id: PROMOT:0000042
name: Age
def: "Elapsed time since birth expressed in years." []
comment: [derived from RD-CDM] Graefe, A.S.L., Hübner, M.R., Rehburg, F. et al. An ontology-based rare disease common data model harmonising international registries, FHIR, and Phenopackets. Sci Data 12, 234 (2025). https://doi.org/10.1038/s41597-025-04558-z
xref: http://purl.obolibrary.org/obo/NCIT_C25150
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

[Term]
id: PROMOT:0000043
name: Age at death
def: "Age à laquelle une personne est décédée. Nombre d’années complètes écoulées depuis la naissance jusqu’à la mort d’une personne." []
xref: http://purl.obolibrary.org/obo/NCIT_C135383
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

