[Typedef]
id: PROMOT:2000001
name: has location
def: "a relation between a phenotype and an anatomical entity, where the anatomical entity is the location of the phenotype." []
property_value: IAO:0000117 "Juliette POTIER" xsd:string

[Typedef]
id: PROMOT:2000002
name: uses assistive equipment
def: "a relation between a human and an device, where the device is an assistive equipment used by the human in order to move or to accomplish something, such as a task or an activity." []
property_value: IAO:0000117 "Juliette POTIER" xsd:string
domain: PROMOT:3000101 ! Patient

[Typedef]
id: PROMOT:2000003
name: is assessed by
def: "a relation between a human and an evaluation procedure, where the human is assessed by an evaluation procedure, such as a test, a questionnaire or a scale." []
property_value: IAO:0000117 "Juliette POTIER" xsd:string
domain: PROMOT:3000101 ! Patient

[Typedef]
id: RO:0002200
name: has phenotype
def: "A relationship that holds between a biological entity and a phenotype. Here a phenotype is construed broadly as any kind of quality of an organism part, a collection of these qualities, or a change in quality or qualities (e.g. abnormally increased temperature). The subject of this relationship can be an organism (where the organism has the phenotype, i.e. the qualities inhere in parts of this organism), a genomic entity such as a gene or genotype (if modifications of the gene or the genotype causes the phenotype), or a condition such as a disease (such that if the condition inheres in an organism, then the organism has the phenotype)." []
subset: ro-eco
property_value: IAO:0000114 IAO:0000125
property_value: IAO:0000117 https://orcid.org/0000-0002-6601-2165
inverse_of: RO:0002201 ! phenotype of

[Typedef]
id: RO:0002201
name: phenotype of
def: "inverse of has phenotype" []
subset: ro-eco
subset: RO:0002259
property_value: IAO:0000114 IAO:0000125
property_value: IAO:0000117 https://orcid.org/0000-0002-6601-2165
is_functional: true

[Typedef]
id: RO:0002351
name: has member
def: "has member is a mereological relation between a collection and an item." []
property_value: IAO:0000119 "SIO" xsd:string
property_value: RO:0001900 RO:0001901
domain: PROMOT:5000001 ! Patient statement

[Typedef]
id: RO:0004013
name: is causal germline mutation in
def: "Relates a gene to condition, such that a mutation in this gene is sufficient to produce the condition and that can be passed on to offspring[modified from orphanet]." []
property_value: seeAlso Orphanet:317343
created_by: https://orcid.org/0000-0002-6601-2165
creation_date: 2017-11-05T02:56:40Z

[Typedef]
id: SCDO:1000194
name: measures
def: "A relation between a diagnostic tool and the diagnostic measurement that it measures." []
property_value: dc:creator "SCDO (Jade Hotchkiss)" xsd:string

[Typedef]
id: VO:0001039
name: has gene mutation
def: "An object property that represents an organism has a mutation of a specific gene from the organism genome." []
property_value: IAO:0000117 "Oliver He" xsd:string

[Typedef]
id: affected:by
name: affected by
def: "describes an entity of which the state or quality is affected by another existing entity. " []
comment: https://bioportal.bioontology.org/ontologies/BIOLINK
property_value: seeAlso https://biolink.github.io/biolink-model/

[Typedef]
id: has_material_basis_in_germline_mutation_in
