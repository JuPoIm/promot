property_value: terms:description "Ontology for modeling the three following neuromuscular diseases : OPMD, Congenital myopathies and Congenital myastenic syndroms. It aims to be also an ontology for building the PROMOT project relational database." xsd:string
property_value: terms:license https://creativecommons.org/licenses/by-nc-sa/4.0/
property_value: terms:title "PROMOT ontology" xsd:string

