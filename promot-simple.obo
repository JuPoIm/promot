xref: http://purl.obolibrary.org/obo/NCIT_C16960
relationship: PROMOT:2000004 PROMOT:0000001 ! est porteur de la mutation genetic mutation
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

[Term]
id: PROMOT:0000026
name: abnormal disposition
def: "A disposition that differs from the norm, such as a disease or a phenotypic abnormality." []
property_value: IAO:0000117 "https://orcid.org/0009-0000-5160-7927" xsd:string

