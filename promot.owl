        <dce:identifier>SIO_001012</dce:identifier>
        <dcterms:description xml:lang="en">healthy is an organismal state of complete physical, mental and social well-being.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">healthy</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001186 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001186">
