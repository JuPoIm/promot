        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000961"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000962"/>
        <dce:identifier>SIO_000960</dce:identifier>
        <dcterms:description xml:lang="en">real is the quality of an entity that exists in real space and time.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">real</rdfs:label>
