        <dce:identifier>SIO_000959</dce:identifier>
        <dcterms:description xml:lang="en">existence quality is the quality of an entity that describe in what environment it is known to exist.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">existence quality</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000960 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000960">
