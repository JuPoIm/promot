        <dce:identifier>SIO_001270</dce:identifier>
        <dcterms:description>paternally transmitted is the quality of a biological organism in which the (genetic) material is transmitted from the paternal line.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">paternally transmitted</rdfs:label>
    </owl:Class>
    


