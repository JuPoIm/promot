        <dce:identifier>SIO_000961</dce:identifier>
        <dcterms:description xml:lang="en">fictional is the quality of an entity that exists only in a creative work of fiction.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">fictional</rdfs:label>
