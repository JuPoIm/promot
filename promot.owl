        <dce:identifier>SIO_000962</dce:identifier>
        <dcterms:description xml:lang="en">virtual is the quality of an entity that exists only in a virtual setting such as a simulation or game environment.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">virtual</rdfs:label>
    </owl:Class>
    


