        <dce:identifier>SIO_001186</dce:identifier>
        <dcterms:description xml:lang="en">hypothetical is the quality of an entity that is conjectured to exist.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">hypothetical</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001209 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001209">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001210"/>
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001211"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <dce:identifier>SIO_001209</dce:identifier>
        <dcterms:description xml:lang="en">An assertional qualifier is the quality of affirmation, either being positive or negative.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">assertional qualifier</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001210 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001210">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001209"/>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_001211"/>
        <dce:identifier>SIO_001210</dce:identifier>
        <dcterms:description xml:lang="en">positive is an assertional qualifier that expresses the validity or truth of a basic assertion.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">positive</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001211 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001211">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001209"/>
        <dce:identifier>SIO_001211</dce:identifier>
        <dcterms:description xml:lang="en">negative is an assertional qualifier that expresses the falsity or lack of truth of a basic assertion.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">negative</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001268 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001268">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000475"/>
        <dce:identifier>SIO_001268</dce:identifier>
        <dcterms:description>parental transmition is the quality of a biological organism in which the (genetic) material is transmitted from a parental unit.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">parental transmission</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_001269 -->

