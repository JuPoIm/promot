    <!-- http://purl.obolibrary.org/obo/HP_0005216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031815"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002201"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008116"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An abnormal reduction in the ability to masticate (chew), i.e., in the ability to crush and ground food in preparation for swallowing.</obo:IAO_0000115>
        <obo:PROMOT_1000001>OPMD Article</obo:PROMOT_1000001>
        <oboInOwl:hasDbXref>SNOMEDCT_US:162020001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0239043</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Chewing difficulties</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chewing difficulty</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Difficulty chewing</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0005216</oboInOwl:id>
        <rdfs:comment>Chewing and swallowing are interrelated. The act of chewing plays a fundamental role in the process of swallowing food. Mastication prepares food for swallowing by breaking it into small particles. Accordingly, loss of teeth has been associated with swallowing difficulties. Chewing difficulties may be caused by loss of teeth, partial dentures, or by tooth pain. Swallowing difficulties, in contrast, are often characterized by difficulties swallowing liquids, reflux, throat spasms, choking on dry food, or dysphagia.</rdfs:comment>
        <rdfs:label>Impaired mastication</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal reduction in the ability to masticate (chew), i.e., in the ability to crush and ground food in preparation for swallowing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:23713640</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005216"/>
