                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0031007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A loss of enjoyment of mealtime due to difficulties while eating.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Perte de la satisfaction ou du plaisir à manger due à des difficultés pour manger.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Pérdida de la satisfacción o del placer de comer debida a las dificultades para comer.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
