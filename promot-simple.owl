    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000053"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>Fetal</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">Age prior to birth but after 8 weeks of embryonic development (corresponding to a gestational age of 10 weeks).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">âge foetal</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0000054 -->

