    <!-- http://purl.obolibrary.org/obo/PROMOT_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A sequence alteration located within the CHRNE gene.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una alteración genética localizada en el gen CHRNE.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une altération génétique située au niveau du gène CHRNE.</obo:IAO_0000115>
