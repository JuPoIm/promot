        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>Late first trimester</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">Category prior to birth in the first trimester during the early fetal period, which is defined as 11 0/7 to 13 6/7 weeks of gestation (inclusive).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">âge vers la fin du premier trimestre de grossesse</rdfs:label>
    </owl:Axiom>
    


