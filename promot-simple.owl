    <!-- http://purl.obolibrary.org/obo/PROMOT_0020002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0020002">
        <obo:IAO_0000115 xml:lang="en">An anatomical entity related to a phenotype such that the anatomical entity is the location of the phenotype. In other words, the phenotype is a disposition of the anatomical entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una entidad anatómica relacionada con un fenotipo, de tal manera que la entidad anatómica es la ubicación del fenotipo. En otras palabras, el fenotipo es una disposición de la entidad anatómica.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une entité anatomique qui peut avoir pour disposition un phénotype. L’entité anatomique est la localisation du phénotype.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-3336-2476, https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="fr">Entité anatomique liée à un phénotype</rdfs:label>
        <rdfs:label xml:lang="en">Phenotypically related anatomical entity</rdfs:label>
        <rdfs:label xml:lang="es">entidad anatómica relacionada con un fenotipo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0020002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una entidad anatómica relacionada con un fenotipo, de tal manera que la entidad anatómica es la ubicación del fenotipo. En otras palabras, el fenotipo es una disposición de la entidad anatómica.</owl:annotatedTarget>
        <obo:IAO_0000119>definition by https://orcid.org/0000-0002-1500-0236</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0020002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="es">entidad anatómica relacionada con un fenotipo</owl:annotatedTarget>
        <rdfs:comment>Frist translated to spanish using Bing Translator then reviewed by https://orcid.org/0000-0002-1500-0236</rdfs:comment>
    </owl:Axiom>
    


