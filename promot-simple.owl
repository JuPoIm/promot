    <!-- http://purl.obolibrary.org/obo/PROMOT_0032006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <obo:IAO_0000115 xml:lang="en">A fatigue that occurs when one is eating. It is due to weakness or fatiguable weakness of chewing muscles.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Fatiga que se produce al momento de comer debida a la debilidad muscular o a la fatiga de los músculos involucrados en la masticación.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Fatigue qui survient au moment de manger du fait de la faiblesse musculaire ou de la fatigabilité des muscles impliqués dans la mastication.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review on dysphagia] Côté C, Gagnon C, Youssof S, et al. The requirement for a disease-specific patient-reported outcome measure of dysphagia in oculopharyngeal muscular dystrophy. Muscle Nerve. 2019;59:445–50. doi: 10.1002/mus.26405</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Fatiga cuando se come</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigue corrélée au fait de manger</rdfs:label>
        <rdfs:label xml:lang="en">Fatigue while eating</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A fatigue that occurs when one is eating. It is due to weakness or fatiguable weakness of chewing muscles.</owl:annotatedTarget>
        <obo:IAO_0000119>Medical experts</obo:IAO_0000119>
        <rdfs:comment>https://orcid.org/0000-0003-2829-8470</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Fatigue qui survient au moment de manger du fait de la faiblesse musculaire ou de la fatigabilité des muscles impliqués dans la mastication.</owl:annotatedTarget>
        <obo:IAO_0000119>translated from English by https://orcid.org/0009-0000-5160-7927 reviewed by https://orcid.org/0000-0003-2829-847</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032004"/>
        <obo:IAO_0000115 xml:lang="en">A difficulty to walk for less than a kilometre, such as walking around rooms or hallways, within a building or for short distances outside. This is distinct from the difficulty of moving around.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Difficulté à avancer à pied, sur une distance de moins d&apos;un kilomètre, comme marcher dans sa chambre ou dans le couloir, dans un bâtiment ou sur de courtes distances à l&apos;extérieur.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Dificultad para andar menos de un kilómetro, como caminar por habitaciones y pasillos, dentro de un edificio o pequeñas distancias en el exterior. Es distinta de la dificultad para desplazarse por el entorno</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review 2026] Bélair N, Gagnon C, Duchesne E. What is known about muscle weakness, balance impairments and indoor mobility limitations in oculopharyngeal muscular dystrophy? A scoping review. J Neuromuscul Dis. 2025 Dec 30:22143602251397052. doi: 10.1177/22143602251397052. Epub ahead of print. PMID: 41467981.</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Difficulty walking short distance</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à marcher sur de courtes distances</rdfs:label>
        <rdfs:label xml:lang="es">Dificultad para andar distancias cortas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A difficulty to walk for less than a kilometre, such as walking around rooms or hallways, within a building or for short distances outside. This is distinct from the difficulty of moving around.</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:555410497</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Difficulté à avancer à pied, sur une distance de moins d&apos;un kilomètre, comme marcher dans sa chambre ou dans le couloir, dans un bâtiment ou sur de courtes distances à l&apos;extérieur.</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:555410497</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Dificultad para andar menos de un kilómetro, como caminar por habitaciones y pasillos, dentro de un edificio o pequeñas distancias en el exterior. Es distinta de la dificultad para desplazarse por el entorno</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:555410497</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0031007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A difficulty to change basic position, i.e. a difficulty getting into and out of a body position and moving from one location to another, such as getting up out of a chair to lie down on a bed, and getting into and out of positions of sitting, standing, kneeling or squatting. This is distinct from the difficulty of transferring oneself.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Difficulté à prendre et quitter une position et/ou à passer d&apos;un endroit à un autre, comme se lever d&apos;un fauteuil pour se coucher sur un lit, et comme prendre et quitter les positions assise, debout, à genoux ou accroupie. Cette difficulté est distincte de la difficulté à se transférrer.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Dificultad para adoptar o abandonar una postura, pasar de un lugar a otro, como levantarse de una silla para tumbarse en una cama, y adoptar o abandonar posiciones determinadas, como arrodillarse o sentarse en cuclillas. Es distinta de la dificultad para transferir el propio cuerpo.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review 2026] Bélair N, Gagnon C, Duchesne E. What is known about muscle weakness, balance impairments and indoor mobility limitations in oculopharyngeal muscular dystrophy? A scoping review. J Neuromuscul Dis. 2025 Dec 30:22143602251397052. doi: 10.1177/22143602251397052. Epub ahead of print. PMID: 41467981.</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Difficulty changing basic position</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à passer d’une position de base à une autre</rdfs:label>
        <rdfs:label xml:lang="es">Dificultad para cambiar las posturas corporales básicas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A difficulty to change basic position, i.e. a difficulty getting into and out of a body position and moving from one location to another, such as getting up out of a chair to lie down on a bed, and getting into and out of positions of sitting, standing, kneeling or squatting. This is distinct from the difficulty of transferring oneself.</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:150502901</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Difficulté à prendre et quitter une position et/ou à passer d&apos;un endroit à un autre, comme se lever d&apos;un fauteuil pour se coucher sur un lit, et comme prendre et quitter les positions assise, debout, à genoux ou accroupie. Cette difficulté est distincte de la difficulté à se transférrer.</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:150502901</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Dificultad para adoptar o abandonar una postura, pasar de un lugar a otro, como levantarse de una silla para tumbarse en una cama, y adoptar o abandonar posiciones determinadas, como arrodillarse o sentarse en cuclillas. Es distinta de la dificultad para transferir el propio cuerpo.</owl:annotatedTarget>
        <obo:IAO_0000119>ICF:150502901</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032001"/>
