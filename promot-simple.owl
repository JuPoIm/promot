    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000002"/>
        <obo:IAO_0000115 xml:lang="en">A sequence alteration located within the DOK7 gene.</obo:IAO_0000115>
