        <terms:description>Ontology for modeling the three following neuromuscular diseases : OPMD, Congenital myopathies and Congenital myastenic syndroms. It aims to be also an ontology for building the PROMOT project relational database.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <terms:title>PROMOT ontology</terms:title>
        <oboInOwl:date>15:06:2026 15:31</oboInOwl:date>
