        <owl:annotatedTarget>This term includes the full 25th year of age up to the completed 40th year of age (i.e., less than the 40th birthday). [from: HP:0025710]</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0025710</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>Antenatal age</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">Age category prior to birth</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une tranche d’âge</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">âge anténatal</rdfs:label>
    </owl:Axiom>
    


