        <dc:creator>SCDO (Jade Hotchkiss)</dc:creator>
        <rdfs:label>measures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/VO_0001039 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/VO_0001039">
