        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>Second trimester</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">Category prior to birth during the second trimester, which comprises the range of gestational ages from 14 0/7 weeks to 27 6/7 (inclusive).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">âge compris dans le second trimestre de grossesse</rdfs:label>
    </owl:Axiom>
    


