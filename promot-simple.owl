        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review 2026] Bélair N, Gagnon C, Duchesne E. What is known about muscle weakness, balance impairments and indoor mobility limitations in oculopharyngeal muscular dystrophy? A scoping review. J Neuromuscul Dis. 2025 Dec 30:22143602251397052. doi: 10.1177/22143602251397052. Epub ahead of print. PMID: 41467981.</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Difficulty walking short distance</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à marcher sur de courtes distances</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0031007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A difficulty to change basic position. E.g. a difficulty to go from a sitting position to a standing position.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Difficulté à passer d’une position de base à une autre, comme par exemple, difficulté à passer de la position assise à la position debout.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review 2026] Bélair N, Gagnon C, Duchesne E. What is known about muscle weakness, balance impairments and indoor mobility limitations in oculopharyngeal muscular dystrophy? A scoping review. J Neuromuscul Dis. 2025 Dec 30:22143602251397052. doi: 10.1177/22143602251397052. Epub ahead of print. PMID: 41467981.</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Difficulty changing basic position</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à passer d’une position de base à une autre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0031007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An anhedonia that occurs when the subject is eating</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Perte de la satisfaction ou du plaisir à manger.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Scoping review on dysphagia] Côté C, Gagnon C, Youssof S, et al. The requirement for a disease-specific patient-reported outcome measure of dysphagia in oculopharyngeal muscular dystrophy. Muscle Nerve. 2019;59:445–50. doi: 10.1002/mus.26405</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Anhedonia while eating</rdfs:label>
        <rdfs:label xml:lang="fr">Anhédonie légère corrélée au fait de manger</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032004"/>
        <obo:IAO_0000115 xml:lang="en">Difficulty in swallowing solid food.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Difficulté à avaler de la nourriture solide.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Clinical Registry Form]</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[OPMD Scoping review on dysphagia] Côté C, Gagnon C, Youssof S, et al. The requirement for a disease-specific patient-reported outcome measure of dysphagia in oculopharyngeal muscular dystrophy. Muscle Nerve. 2019;59:445–50. doi: 10.1002/mus.26405</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Dysphagia for solid</rdfs:label>
        <rdfs:label xml:lang="fr">Dysphagie avec de la nourriture solide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032004"/>
        <obo:IAO_0000115 xml:lang="en">Difficulty in swallowing liquid food. This is distinct from hydrophobia.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Difficulté à avaler de la nourriture liquide, disctincte de l’hydrophobie.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[OPMD Clinical Registry Form]</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[OPMD Scoping review on dysphagia] Côté C, Gagnon C, Youssof S, et al. The requirement for a disease-specific patient-reported outcome measure of dysphagia in oculopharyngeal muscular dystrophy. Muscle Nerve. 2019;59:445–50. doi: 10.1002/mus.26405</obo:PROMOT_1000001>
        <rdfs:label xml:lang="en">Dysphagia for liquid</rdfs:label>
        <rdfs:label xml:lang="fr">Dysphagie avec de la nourriture liquide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <obo:IAO_0000115 xml:lang="en">A type of weakness of the facial musculature (i.e. one or more muscles innervated by the seventh cranial nerve) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the facial musculature with repetitive muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse de la musculature faciale, c.à.d. d’un ou plusieurs muscles inervés par le septième nerf cranial, qui se manifeste quand un groupe musculaire facial est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles faciaux à la suite d’une sollicitation répêtée.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Debilidad fatigable de la musculatura facial</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigabilité de la musculature faciale</rdfs:label>
        <rdfs:label xml:lang="en">Fatiguable weakness of facial musculature</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of weakness of the facial musculature (i.e. one or more muscles innervated by the seventh cranial nerve) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the facial musculature with repetitive muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0003473</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <obo:IAO_0000115 xml:lang="en">A type of weakness of the ocular muscles that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the ocular muscles with repetitive muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse des muscles occulaires qui se manifeste quand un groupe musculaire occulaire est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles occulaires à la suite d’une sollicitation répêtée.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Debilidad fatigable de los músculos oculares</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigabilité des muscles occulaires</rdfs:label>
        <rdfs:label xml:lang="en">Fatiguable weakness of the ocular muscles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of weakness of the ocular muscles that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the ocular muscles with repetitive muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0003473</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032003"/>
        <obo:IAO_0000115 xml:lang="en">A type of weakness of the axial muscles (i.e., of the muscles of the head and neck, spine, and ribs) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the axial muscles with repetitive muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse des muscles axiaux, c.à.d. des muscles de la tête et du coup, de la colonne vertébrale et des côtes, qui se manifeste quand un groupe musculaire axial est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles axiaux à la suite d’une sollicitation répêtée.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Debilidad fatigable muscular axial</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigabilité des muscles axiaux</rdfs:label>
        <rdfs:label xml:lang="en">Fatiguable weakness of axial muscles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of weakness of the axial muscles (i.e., of the muscles of the head and neck, spine, and ribs) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the axial muscles with repetitive muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0003473</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0032015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0031007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A lack of strength in the muscles involved in chewing.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse musculaire des muscles impliqués dans la mastication.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
        <rdfs:label xml:lang="fr">Faiblesse musculaire des muscles de la mastication</rdfs:label>
        <rdfs:label xml:lang="en">Weakness of chewing muscles</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0100001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100001">
        <obo:IAO_0000115 xml:lang="en">A procedure that can assess a phenotype.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une procédure qui évalue un phénotype.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Phenotypically related procedure</rdfs:label>
        <rdfs:label xml:lang="fr">Procédure liée à un phénotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0100002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100002">
