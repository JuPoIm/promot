        <owl:annotatedTarget>Embryonal</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">Category up to 8 weeks following fertilization (corresponding to 10 weeks of gestation).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">âge embryonnaire</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000051"/>
