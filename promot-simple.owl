    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <obo:IAO_0000115 xml:lang="en">A relation between an assistive device and a patient, where the patient uses the device in order to accomplish something, such as a task or an activity (e.g. moving, reading).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un appareil et un patient où le patient utilise l’appareil pour effectuer une action ou une activité, comme, par exemple, pour se déplacer ou pour lire.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label xml:lang="es">es utilizado por</rdfs:label>
        <rdfs:label xml:lang="fr">est utilisé par</rdfs:label>
        <rdfs:label xml:lang="en">is used by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label xml:lang="en">assesses</rdfs:label>
        <rdfs:label xml:lang="es">evalúa</rdfs:label>
        <rdfs:label xml:lang="fr">évalue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure d’évaluation et l’entité qu’elle mesure, comme, par exemple, une structure organique, une fonction biologique ou une activité ou une participation.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>SCDO:1000194</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">measures</rdfs:label>
        <rdfs:label xml:lang="fr">mesure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000004">
        <obo:IAO_0000115 xml:lang="en">A relation between an organism and a specific gene mutation that exists in the genome of that organism.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>VO:0001039</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est porteur de la mutation</rdfs:label>
        <rdfs:label xml:lang="en">has genetic mutation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000005">
        <obo:IAO_0000115 xml:lang="en">A relation between two entity where the first entity affects the state of the second entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux entités où l’existence de la première affecte l’état de la seconde.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BIOLINK:affects</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SIO:001158</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">affecte</rdfs:label>
        <rdfs:label xml:lang="en">affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000006 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000006">
        <obo:IAO_0000115 xml:lang="en">A relation between two organisms where the two organisms share a biological bond.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux organismes où les organismes partagent un lien de parenté biologique.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>SIO:000709 </oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est lié à</rdfs:label>
        <rdfs:label xml:lang="en">is related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000007 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000007">
        <obo:IAO_0000115 xml:lang="en">A relation between an entity and its identifier where the identifier allows to indentify the first entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une entité et son identifiant, où l’identifiant sert à identifier la première entité.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="fr">a pour identifiant</rdfs:label>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000080 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000080">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <obo:IAO_0000112 xml:lang="en">this red color is a quality of this apple</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A quality inheres in its bearer at all times for which the quality exists.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">is quality of</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">quality_of</obo:IAO_0000118>
        <rdfs:comment>This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020.</rdfs:comment>
        <rdfs:label xml:lang="en">quality of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000086 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000086">
        <obo:IAO_0000112 xml:lang="en">this apple has quality this red color</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">has_quality</obo:IAO_0000118>
        <rdfs:label xml:lang="en">has quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000091 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000091">
        <obo:IAO_0000115 xml:lang="en">a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has disposition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001025 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001025">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000111 xml:lang="en">located in</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">my brain is located in my head</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">this rat is located in this cage</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">a relation between two independent continuants, the target and the location, in which the target is entirely within the location</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">located_in</obo:IAO_0000118>
        <obo:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
        <terms:source>http://www.obofoundry.org/ro/#OBO_REL:located_in</terms:source>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_gp2term"/>
        <rdfs:label xml:lang="en">located in</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Located_in</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002200 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002200">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115>A relationship that holds between a biological entity and a phenotype. Here a phenotype is construed broadly as any kind of quality of an organism part, a collection of these qualities, or a change in quality or qualities (e.g. abnormally increased temperature). The subject of this relationship can be an organism (where the organism has the phenotype, i.e. the qualities inhere in parts of this organism), a genomic entity such as a gene or genotype (if modifications of the gene or the genotype causes the phenotype), or a condition such as a disease (such that if the condition inheres in an organism, then the organism has the phenotype).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ro/subsets#ro-eco"/>
        <rdfs:label xml:lang="en">has phenotype</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/promot/components/promot-component.owl#c"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002234 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002234">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115>p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <obo:IAO_0000118>produces</obo:IAO_0000118>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ro/subsets#ro-eco"/>
        <rdfs:label xml:lang="en">has output</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Has_output</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002328 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002328">
        <obo:IAO_0000115>A grouping relationship for any relationship directly involving a function, or that holds because of a function of one of the related entities.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <obo:IAO_0000232>This is a grouping relation that collects relations used for the purpose of connecting structure and function</obo:IAO_0000232>
        <rdfs:label xml:lang="en">functionally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002331 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002331">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <obo:IAO_0000115>c involved_in p if and only if c enables some process p&apos;, and p&apos; is part of p</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <obo:IAO_0000118>actively involved in</obo:IAO_0000118>
        <obo:IAO_0000118>enables part of</obo:IAO_0000118>
        <rdfs:label xml:lang="en">involved in</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Involved_in</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002351 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002351">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <obo:IAO_0000115>has member is a mereological relation between a collection and an item.</obo:IAO_0000115>
        <obo:IAO_0000119>SIO</obo:IAO_0000119>
        <obo:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002614 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002614">
