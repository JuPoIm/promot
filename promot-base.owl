        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000100"/>
        <obo:IAO_0000115 xml:lang="en">A consent given by a person to the reuse of their data.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Un consentement donné par une personne à ce que les données la concernant soient utlilisées à d’autres fins que celles initialement prévues.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[EURO-NMD] Atalia A et al., EURO-NMD registry: federated FAIR infrastructure, innovative technologies and concepts of a patient-centred registry for rare neuromuscular disorders. Orphanet J Rare Dis. 2024 Feb 14;19(1):66. doi: 10.1186/s13023-024-03059-3. PMID: 38355534; PMCID: PMC10865673.</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[RD-CDM] Graefe, A.S.L., Hübner, M.R., Rehburg, F. et al. An ontology-based rare disease common data model harmonising international registries, FHIR, and Phenopackets. Sci Data 12, 234 (2025). https://doi.org/10.1038/s41597-025-04558-z</obo:PROMOT_1000001>
        <rdfs:comment>[PROMOT note] [Derived from RD-CDM] [7.5 Consent to the reuse of data] </rdfs:comment>
        <rdfs:label xml:lang="en">Consent to the reuse of data</rdfs:label>
        <rdfs:label xml:lang="fr">Consentement à la réutilisation des données</rdfs:label>
        <rdfs:label xml:lang="es">Consentimiento para la reutilización de datos</rdfs:label>
        <rdfs:label xml:lang="en">Double compound motor action potential abnormality</rdfs:label>
    </owl:Class>
    


