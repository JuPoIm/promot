        <obo:IAO_0000115 xml:lang="es">Una alteración genética ubicada en el gen PABPN1.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une altération génétique située au niveau du gène PABPN1.</obo:IAO_0000115>
        <rdfs:label xml:lang="es">mutación del gen PAPBN1</rdfs:label>
        <rdfs:label xml:lang="fr">mutation du gène PABPN1</rdfs:label>
    </owl:Axiom>
    


