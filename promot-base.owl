    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/FMA_62955"/>
        <obo:IAO_0000115>a relation between a phenotype and an anatomical entity, where the anatomical entity is the location of the phenotype.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <rdfs:range rdf:resource="http://snomed.info/id/360296002"/>
        <obo:IAO_0000115>a relation between a human and an device, where the device is an assistive equipment used by the human in order to move or to accomplish something, such as a task or an activity.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>uses assistive equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <rdfs:range rdf:resource="http://snomed.info/id/386053000"/>
        <obo:IAO_0000115>a relation between a human and an evaluation procedure, where the human is assessed by an evaluation procedure, such as a test, a questionnaire or a scale.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>is assessed by</rdfs:label>
    </owl:ObjectProperty>
    


