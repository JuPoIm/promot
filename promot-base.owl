    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/PROMOT_7000001"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>A relation between a phenotypically related anatomical entity and a phenotype, where the phenotype is located in the phenotypically related anatomical entity.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <rdfs:domain rdf:resource="http://snomed.info/id/360296002"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PROMOT_3000001"/>
        <obo:IAO_0000115>A relation between a device and a patient, where the patient uses an assistive equipment in order to move or to accomplish something, such as a task or an activity.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>is used by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <rdfs:domain rdf:resource="http://snomed.info/id/386053000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PROMOT_3000001"/>
        <obo:IAO_0000115>A relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale.</obo:IAO_0000115>
        <obo:IAO_0000117>Juliette Potier</obo:IAO_0000117>
        <rdfs:label>assesses</rdfs:label>
    </owl:ObjectProperty>
    


