        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>genetic mutation</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">A sequence alteration that is very rare allele in a population.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una alteración genética que es rara en una población.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une altération génétique qui est rare dans une population.</obo:IAO_0000115>
        <rdfs:label xml:lang="es">mutación genética</rdfs:label>
        <rdfs:label xml:lang="fr">mutation génetique</rdfs:label>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
