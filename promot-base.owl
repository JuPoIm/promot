    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000025"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an assistive device and a patient, where the patient uses the device in order to accomplish something, such as a task or an activity (e.g. moving, reading).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un appareil et un patient où le patient utilise l’appareil pour effectuer une action ou une activité, comme, par exemple, pour se déplacer ou pour lire.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label xml:lang="es">es utilizado por</rdfs:label>
        <rdfs:label xml:lang="fr">est utilisé par</rdfs:label>
        <rdfs:label xml:lang="en">is used by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <rdfs:domain rdf:resource="http://snomed.info/id/128927009"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label xml:lang="en">assesses</rdfs:label>
        <rdfs:label xml:lang="es">evalúa</rdfs:label>
        <rdfs:label xml:lang="fr">évalue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <rdfs:domain rdf:resource="http://snomed.info/id/128927009"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure d’évaluation et l’entité qu’elle mesure, comme, par exemple, une structure organique, une fonction biologique ou une activité ou une participation.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>SCDO:1000194</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">measures</rdfs:label>
        <rdfs:label xml:lang="fr">mesure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000004">
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_010000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an organism and a specific gene mutation that exists in the genome of that organism.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>VO:0001039</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est porteur de la mutation</rdfs:label>
        <rdfs:label xml:lang="en">has genetic mutation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000005">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115 xml:lang="en">A relation between two entity where the first entity affects the state of the second entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux entités où l’existence de la première affecte l’état de la seconde.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BIOLINK:affects</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SIO:001158</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">affecte</rdfs:label>
        <rdfs:label xml:lang="en">affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000006 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000006">
        <obo:IAO_0000115 xml:lang="en">A relation between two entity where the state of the first entity is affected by the existence of the second entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux entités où l’état de la première entité est affecté par l’existence de la seconde.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="fr">est affecté par</rdfs:label>
        <rdfs:label xml:lang="en">is affected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000007 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000007">
        <obo:IAO_0000115 xml:lang="en">A relation between an identifier and the entity that the identifier is the only one to identify.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un identifiant et l’entité qu’il identifie. L’identifiant est le seul à identifier l’entité en question.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>SIO:000674</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est l’identifiant unique pour</rdfs:label>
        <rdfs:label xml:lang="en">is unique identifier for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000008 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000008">
        <obo:IAO_0000115 xml:lang="en">A relation between a process and an entity where the process produce the second entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un processus et une entité qui a été produite par celui-ci.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>SIO:000229</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">a comme résultat</rdfs:label>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000009 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000009">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un indépendant continuant et une disposition, où la disposition dépend spécifiquement de l’indépendant continuant pour exister.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>RO:0000091 </oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">a comme disposition</rdfs:label>
        <rdfs:label xml:lang="en">has disposition</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence.</owl:annotatedTarget>
        <obo:IAO_0000119>RO:0000091</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000010">
        <obo:IAO_0000115 xml:lang="en">A relation between two independent continuants, the target and the location, in which the target is entirely within the location</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux indépendants continuant dans laquelle l’un est la localisation de l’autre.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>RO:0001025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SIO:000061</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est situé dans</rdfs:label>
        <rdfs:label xml:lang="en">located in</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A relation between two independent continuants, the target and the location, in which the target is entirely within the location</owl:annotatedTarget>
        <obo:IAO_0000119>RO:0001025</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000011 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000011">
        <obo:IAO_0000115 xml:lang="en">A generic relation between an entity and a function, where the entity is needed to realize the function.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">une relation générique entre une entité et une fonction, où l’entité est nécessaire à la réalisation de la fonction. Par exemple les muscles extraoculaires sont liés fonctionnellement aux fonctions des muscles extérieurs de l’oeil.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>RO:0002328</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est fonctionnellement lié à</rdfs:label>
        <rdfs:label xml:lang="en">functionally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000012 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000012">
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="en">uses</rdfs:label>
    </owl:ObjectProperty>
    


