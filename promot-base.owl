        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A participation is an involvement in a life situation. Participation restrictions are problems an individual may experience in involvement in life situations.</owl:annotatedTarget>
