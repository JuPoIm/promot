        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>has genetic mutation</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">A relation between an organism and a specific gene mutation existing in the organism genome.</obo:IAO_0000115>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000005">
