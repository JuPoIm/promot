    <!-- http://purl.obolibrary.org/obo/PROMOT_0000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000054"/>
        <obo:IAO_0000115 xml:lang="en">Category prior to birth in the first trimester during the early fetal period, which is defined as 11 to 13 weeks of gestation (inclusive).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une catégorie d’âges regroupant les âges d’un fœtus à partir de 8 semaines après la conception (soit 10 semaines de gestation) jusqu’à la fin du premier trimestre de grossesse.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
