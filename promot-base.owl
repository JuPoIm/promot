        <obo:IAO_0000115 xml:lang="en">Assessment of the strengh of the tongue muscle by using Iowa Oral Performance Instrument.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Ce test permet d’évaluer la force musculaire de la langue à l’aide de l’appareil IOPI.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Assessment of tongue strengh using Iowa Oral Performance Instrument</rdfs:label>
        <rdfs:label xml:lang="fr">Évaluation de la force de la langue avec l’IOPI</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0200006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
