    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/promot/promot-base.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/promot/releases/2026-01-20/promot-base.owl"/>
        <dc11:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:description>Ontology for modeling the three following neuromuscular diseases : OPMD, Congenital myopathies and Congenital myastenic syndroms. It aims to be also an ontology for building the PROMOT project relational database.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <dcterms:title>PROMOT ontology</dcterms:title>
        <oboInOwl:date>20:01:2026 16:30</oboInOwl:date>
        <owl:versionInfo>2026-01-20</owl:versionInfo>
    </owl:Ontology>
    


