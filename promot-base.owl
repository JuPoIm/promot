        <obo:IAO_0000115 xml:lang="fr">Le test mesurant la force de préhension permet de quantifier la force maximale volontaire des muscles de la main et de l’avant-bras, lors d’une action de flexion des doigts. Il s’agit d’un indicateur du niveau de fonction de la main.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">Test measuring the grip force allows quantifying the maximum voluntary force of the muscles of the hand and forearm, during a finger flexion action. This is an indicator of the level of hand function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://snomed.info/id/445993006</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">Assessment using Hand Jamar dynanometer</rdfs:label>
        <rdfs:label xml:lang="fr">Évaluation de la force de préhension</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0200012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Le test mesurant la force de préhension permet de quantifier la force maximale volontaire des muscles de la main et de l’avant-bras, lors d’une action de flexion des doigts. Il s’agit d’un indicateur du niveau de fonction de la main.</owl:annotatedTarget>
        <obo:IAO_0000119>Definititon of the test provided by the Groupe de Recherche Interdisciplinaire sur les Maladies Neuromusculaires (GRIMN).</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0200012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Test measuring the grip force allows quantifying the maximum voluntary force of the muscles of the hand and forearm, during a finger flexion action. This is an indicator of the level of hand function.</owl:annotatedTarget>
        <obo:IAO_0000119>Definition translated from French to English using automatic translation.</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0200013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0200013">
        <rdfs:subClassOf rdf:resource="http://snomed.info/id/12894003"/>
        <rdfs:subClassOf>
