                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/HP_0012735"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A test assessing the subject’s expiratory peak flow when they expirate and when they cough. It assesses the glottis efficiency to clear out the repiratory tract by using an expiratory flowmeter.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Un test de débit expiratoire de pointe à l’expiration (DEP) et à la toux (DEP toux) permet de calculer l’efficacité de la glotte (capacité de dégager les voies aériennes). Le test s’effectue avec un débitmètre expiratoire.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Assessment of expiratory and cough peak flows using an expiratory flowmeter</rdfs:label>
        <rdfs:label xml:lang="fr">Évaluation des débits expiratoires de pointe à l’expiration et à la toux</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0200001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un test de débit expiratoire de pointe à l’expiration (DEP) et à la toux (DEP toux) permet de calculer l’efficacité de la glotte (capacité de dégager les voies aériennes). Le test s’effectue avec un débitmètre expiratoire.</owl:annotatedTarget>
        <obo:IAO_0000119>Definititon of the test provided by the Groupe de Recherche Interdisciplinaire sur les Maladies Neuromusculaires (GRIMN).</obo:IAO_0000119>
    </owl:Axiom>
    


