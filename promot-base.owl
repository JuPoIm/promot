    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115 xml:lang="en">A relation between two entity where the first entity affects the state of the second entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre deux entités où l’existence de la première affecte l’état de la seconde.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>BIOLINK:affects</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SIO:001158</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">affecte</rdfs:label>
        <rdfs:label xml:lang="en">affects</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une relation entre deux entités où l’existence de la première affecte l’état de la seconde.</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">affecte</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <rdfs:domain rdf:resource="http://snomed.info/id/128927009"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity assessed by the procedure that could be a patient or a phenotype. The evaluation procedure could be, for instance, a performance test, a patient reported questionnaire or a scale (non restrictive).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="en">assesses</rdfs:label>
        <rdfs:label xml:lang="es">evalúa</rdfs:label>
        <rdfs:label xml:lang="fr">évalue</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">évalue</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala.</owl:annotatedTarget>
        <obo:IAO_0000119>JP: Translated to spanish using Bing Translator</obo:IAO_0000119>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une relation entre une procédure d’évaluation et une entité, telle qu’un patient ou un phénotype, où la procédure évalue l’entité. La procédure peut par exemple évaluer un patient au moyen d’un test encadré par un ou une professionnelle de santé ou d’un questionnaire autorapporté.</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="es">evalúa</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C14250"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SO_0001060"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an organism and a specific gene mutation that exists in the genome of that organism.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <oboInOwl:hasDbXref>VO:0001039</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="fr">est porteur de la mutation</rdfs:label>
        <rdfs:label xml:lang="en">has genetic mutation</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une relation entre un organisme et une mutation génétique présente dans le génome de cet organisme.</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">est porteur de la mutation</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000004">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an entity and its identifier where the identifier allows to indentify the first entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une entité et son identifiant, où l’identifiant sert à identifier la première entité.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="fr">a pour identifiant</rdfs:label>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une relation entre une entité et son identifiant, où l’identifiant sert à identifier la première entité.</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">a pour identifiant</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000005">
        <obo:IAO_0000115 xml:lang="en">A relation between an entity and the evaluation procedure that assesses the entity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une entité et une procédure d’évaluation, où la procédure sert à évaluer la première entité.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">est évalué par</rdfs:label>
        <rdfs:label xml:lang="en">is assessed by</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une relation entre une entité et une procédure d’évaluation, où la procédure sert à évaluer la première entité.</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000005"/>
