                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_001268"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A sequence alteration that is very rare allele in a population (typically &lt;1%).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una alteración genética que es rara en una población.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une altération génétique qui est rare au sein d’une population.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>EU-CDE</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[EURO-NMD] Atalia A et al., EURO-NMD registry: federated FAIR infrastructure, innovative technologies and concepts of a patient-centred registry for rare neuromuscular disorders. Orphanet J Rare Dis. 2024 Feb 14;19(1):66. doi: 10.1186/s13023-024-03059-3. PMID: 38355534; PMCID: PMC10865673.</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[RD-CDM] Graefe, A.S.L., Hübner, M.R., Rehburg, F. et al. An ontology-based rare disease common data model harmonising international registries, FHIR, and Phenopackets. Sci Data 12, 234 (2025). https://doi.org/10.1038/s41597-025-04558-z</obo:PROMOT_1000001>
        <oboInOwl:hasDbXref>GENO:0000492</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/NCIT_C18093</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://snomed.info/id/106221001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://snomed.info/id/55446002</oboInOwl:hasDbXref>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:comment>[PROMOT NOTE: derived from EURO-NMD] </rdfs:comment>
        <rdfs:comment>[PROMOT note] [Derived from RD-CDM] [6.1.1 Genomic Diagnosis]</rdfs:comment>
        <rdfs:label xml:lang="en">genetic mutation</rdfs:label>
        <rdfs:label xml:lang="es">mutación genética</rdfs:label>
        <rdfs:label xml:lang="fr">mutation génetique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GENO_0000492"/>
    </owl:Class>
