    <!-- http://purl.obolibrary.org/obo/PROMOT_0032018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000508"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A type of ptosis that occurs after the external ocular muscle group is used and lessens if the muscle group has some rest. That is, there is a ptosis apparition with repetitive external ocular muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Tipo de ptosis que aparece tras el uso de la musculatura extrínseca ocular y disminuye con el reposo del grupo muscular. Es decir, se produce la aparición de ptosis con la realización repetida de movimientos de la musculatura extrínseca ocular.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une fatigabilité des muscles extra-occulaires qui provoque une ptose</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[Congenital myasthenic syndrom Scoping review] &quot;Performing a Rare Disease-Oriented Master Observational Trial&quot; initiative, European Joint Programme on Rare Diseases, https://www.promotinitiative.com/</obo:PROMOT_1000001>
        <rdfs:label xml:lang="fr">Fatigabilité des muscles extra-occulaires provoquant une ptose</rdfs:label>
        <rdfs:label xml:lang="en">Fatigable ptosis</rdfs:label>
        <rdfs:label xml:lang="es">Ptosis fatigable</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of ptosis that occurs after the external ocular muscle group is used and lessens if the muscle group has some rest. That is, there is a ptosis apparition with repetitive external ocular muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>Medical experts</obo:IAO_0000119>
        <rdfs:comment>https://orcid.org/0000-0003-2829-8470</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Tipo de ptosis que aparece tras el uso de la musculatura extrínseca ocular y disminuye con el reposo del grupo muscular. Es decir, se produce la aparición de ptosis con la realización repetida de movimientos de la musculatura extrínseca ocular.</owl:annotatedTarget>
        <obo:IAO_0000119>translation by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772</obo:IAO_0000119>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une fatigabilité des muscles extra-occulaires qui provoque une ptose</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Fatigabilité des muscles extra-occulaires provoquant une ptose</owl:annotatedTarget>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
