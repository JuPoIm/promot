    <!-- http://purl.obolibrary.org/obo/PROMOT_0032021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003473"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032065"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A type of weakness of the ocular muscles that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the ocular muscles with repetitive muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una debilidad del músculo oculares que se manifiesta cuando un grupo muscular ocular está bajo presión y que disminuye después de que el grupo en cuestión ha sido puesto en reposo. En resumen, se trata de una disminución de la fuerza del músculo oculares como resultado de una carga repetida.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse des muscles occulaires qui se manifeste quand un groupe musculaire occulaire est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles occulaires à la suite d’une sollicitation répêtée.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[Congenital myasthenic syndrom Scoping review] &quot;Performing a Rare Disease-Oriented Master Observational Trial&quot; initiative, European Joint Programme on Rare Diseases, https://www.promotinitiative.com/</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[Congenital myopathy Scoping review] &quot;Performing a Rare Disease-Oriented Master Observational Trial&quot; initiative, European Joint Programme on Rare Diseases, https://www.promotinitiative.com/</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Debilidad fatigable del músculo oculares</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigabilité des muscles occulaires</rdfs:label>
        <rdfs:label xml:lang="en">Fatigable weakness of the ocular muscles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of weakness of the ocular muscles that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the ocular muscles with repetitive muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0003473</obo:IAO_0000119>
        <rdfs:comment>[PROMOT project] Mansoore Gholizade (definition reviewer)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
