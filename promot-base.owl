    <!-- http://purl.obolibrary.org/obo/PROMOT_2000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000001">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0000025"/>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label>is used by</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>is used by</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">A relation between an assistive device and a patient, where the patient uses the device in order to move or to accomplish something, such as a task or an activity.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un dispositivo y un paciente donde el paciente utiliza el dispositivo para moverse, realizar una acción o una actividad.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre un appareil et un patient où le patient utilise l’appareil pour se déplacer, effectuer une action ou une activité.</obo:IAO_0000115>
        <rdfs:label xml:lang="es">es utilizado por</rdfs:label>
        <rdfs:label xml:lang="fr">est utilisé par</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000002">
        <rdfs:domain rdf:resource="http://snomed.info/id/128927009"/>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:comment>JP: Translated to spanish using Bing Translator</rdfs:comment>
        <rdfs:label>assesses</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>assesses</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and a patient, where the patient is assessed by an evaluation procedure, such as a test, a questionnaire or a scale.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una relación entre un procedimiento y un paciente donde el procedimiento evalúa al paciente mediante, por ejemplo, una prueba, un cuestionario o una escala.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une relation entre une procédure et un patient où la procédure évalue le patient au moyen, par exemple, d’un test, d’un questionnaire ou d’une échelle.</obo:IAO_0000115>
        <rdfs:label xml:lang="es">evalúa</rdfs:label>
        <rdfs:label xml:lang="fr">évalue</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000003">
        <rdfs:label>measures</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>measures</owl:annotatedTarget>
        <obo:IAO_0000115 xml:lang="en">A relation between an evaluation procedure and the entity measured by the procedure, such as a structure, a function, an activity or a participation.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">mesure</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_2000004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/PROMOT_2000004">
