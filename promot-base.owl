    <!-- http://purl.obolibrary.org/obo/PROMOT_0032019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0032019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030197"/>
        <obo:IAO_0000115 xml:lang="en">A type of weakness of the axial muscles (i.e., of the muscles of the head and neck, vertebral column, and intercostal muscles) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the axial muscles with repetitive muscle actions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Una debilidad del músculo axiales, es decir, los músculos de la cabeza y el cuello, la columna vertebral y las costillas, que se manifiesta cuando un grupo muscular axial está bajo presión y que disminuye después de que el grupo en cuestión ha sido puesto en reposo. En resumen, se trata de una disminución de la fuerza del músculo axiales como resultado de una carga repetida.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Une faiblesse des muscles axiaux, c.à.d. des muscles de la tête et du cou, de la colonne vertébrale et des côtes, qui se manifeste quand un groupe musculaire axial est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles axiaux à la suite d’une sollicitation répêtée.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <obo:PROMOT_1000001>[Congenital myasthenic syndrom Scoping review] &quot;Performing a Rare Disease-Oriented Master Observational Trial&quot; initiative, European Joint Programme on Rare Diseases, https://www.promotinitiative.com/</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>[Congenital myopathy Scoping review] &quot;Performing a Rare Disease-Oriented Master Observational Trial&quot; initiative, European Joint Programme on Rare Diseases, https://www.promotinitiative.com/</obo:PROMOT_1000001>
        <rdfs:label xml:lang="es">Debilidad fatigable muscular axial</rdfs:label>
        <rdfs:label xml:lang="fr">Fatigabilité des muscles axiaux</rdfs:label>
        <rdfs:label xml:lang="en">Fatigable weakness of axial muscles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A type of weakness of the axial muscles (i.e., of the muscles of the head and neck, vertebral column, and intercostal muscles) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of the strength of the axial muscles with repetitive muscle actions.</owl:annotatedTarget>
        <obo:IAO_0000119>HP:0003473</obo:IAO_0000119>
        <rdfs:comment>[PROMOT project] Mansoore Gholizade (definition reviewer)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una debilidad del músculo axiales, es decir, los músculos de la cabeza y el cuello, la columna vertebral y las costillas, que se manifiesta cuando un grupo muscular axial está bajo presión y que disminuye después de que el grupo en cuestión ha sido puesto en reposo. En resumen, se trata de una disminución de la fuerza del músculo axiales como resultado de una carga repetida.</owl:annotatedTarget>
        <obo:IAO_0000119>Translated from French using Reverso. translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772</obo:IAO_0000119>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une faiblesse des muscles axiaux, c.à.d. des muscles de la tête et du cou, de la colonne vertébrale et des côtes, qui se manifeste quand un groupe musculaire axial est sollicité et qui diminue après que le groupe en question a été mis au repos. En résumé, il s’agit d’une diminution de la force des muscles axiaux à la suite d’une sollicitation répêtée.</owl:annotatedTarget>
        <obo:IAO_0000119>translated from English by https://orcid.org/0009-0000-5160-7927 reviewed by https://orcid.org/0000-0003-2829-847</obo:IAO_0000119>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PROMOT_0032019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="es">Debilidad fatigable muscular axial</owl:annotatedTarget>
        <rdfs:comment>translation reviewed by https://orcid.org/0000-0001-7764-2085 and https://orcid.org/0000-0002-3391-9772</rdfs:comment>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
