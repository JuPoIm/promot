    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0120002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A participation is an involvement in a life situation. Participation restrictions are problems an individual may experience in involvement in life situations.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">La participation signifie le fait de prendre part à une situation de la vie réelle. Les restrictions de participation désignent les problèmes qu&apos;une personne peut rencontrer pour participer à une situation réelle.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="es">Participación es involucrarse en una situación de la vida cotidiana. Las restricciones en la participación son problemas que una persona puede experimentar al involucrarse en situaciones de la vida cotidiana.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0009-0000-5160-7927</obo:IAO_0000117>
        <rdfs:label xml:lang="es">Participación</rdfs:label>
        <rdfs:label xml:lang="en">Participation</rdfs:label>
        <rdfs:label xml:lang="fr">Participation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://id.who.int/icd/entity/1394728112"/>
    </owl:Class>
    <owl:Axiom>
