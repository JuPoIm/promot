    <!-- http://purl.obolibrary.org/obo/PROMOT_0100002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012378"/>
        <obo:IAO_0000115 xml:lang="en">A fatigue that occurs when the subject is eating</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Fatigue corrélée au fait de manger</rdfs:label>
        <rdfs:label xml:lang="en">Fatigue while eating</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0100003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001288"/>
        <obo:IAO_0000115 xml:lang="en">A difficulty to walk short distance. E.g. a difficulty to  walk inside a building such as a house.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Difficulty walking short distance</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à marcher sur de courtes distances</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0100004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <obo:IAO_0000115 xml:lang="en">A difficulty to change basic position. E.g. a difficulty to go from a sitting position to a standing position.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Difficulty changing basic position</rdfs:label>
        <rdfs:label xml:lang="fr">Difficulté à passer d’une position de base à une autre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PROMOT_0100005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PROMOT_0100005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012154"/>
        <obo:IAO_0000115 xml:lang="en">A mild anhedonia that occurs when the subject is eating</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anhédonie légère corrélée au fait de manger</rdfs:label>
        <rdfs:label xml:lang="en">Mild anhedonia while eating</rdfs:label>
    </owl:Class>
    


