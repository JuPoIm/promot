        <oboInOwl:hasExactSynonym>Drooping upper eyelid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Eyelid ptosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Palpebral ptosis</oboInOwl:hasExactSynonym>
