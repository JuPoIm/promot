    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030878"/>
        <obo:IAO_0000115>An abnormal reduction in the amount of air a person can forcefully expel in one second.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-21T12:54:07Z</dc:date>
