    <!-- http://purl.obolibrary.org/obo/HP_0000508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115>The upper eyelid margin is positioned 3 mm or more lower than usual and covers the superior portion of the iris (objective); or, the upper lid margin obscures at least part of the pupil (subjective).</obo:IAO_0000115>
