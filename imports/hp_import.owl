    <!-- http://purl.obolibrary.org/obo/HP_0001315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031826"/>
        <obo:IAO_0000115>Diminution of tendon reflexes, which is an invariable sign of peripheral nerve disease.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001316</oboInOwl:hasAlternativeId>
