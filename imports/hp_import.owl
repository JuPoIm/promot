        <obo:IAO_0000115>Reduced ability to desscend stairs.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-31T13:07:11Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasExactSynonym>Difficulty walking down stairs</oboInOwl:hasExactSynonym>
        <rdfs:label>Difficulty descending stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003749"/>
        <obo:IAO_0000115>Reduced ability to bring the leg toward the midline of the body.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-09T16:43:25Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Hip adductor weakness</rdfs:label>
    </owl:Class>
    <owl:Axiom>
