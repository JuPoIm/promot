    <!-- http://purl.obolibrary.org/obo/HP_0000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000602"/>
        <obo:IAO_0000115>Paralysis of the external ocular muscles.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007762</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:19373007</oboInOwl:hasDbXref>
