    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032342"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Reduced FEV1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#abbreviation"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An anomaly of the musculoskeletal system, which consists of the bones of the skeleton, muscles, cartilage, tendons, ligaments, joints, and other connective tissue. The musculoskeletal system supports the weight of the body, maintains body position and produces movements of the body or of parts of the body.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-05T13:35:03Z</dc:date>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:label>Abnormality of the musculoskeletal system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033235">
