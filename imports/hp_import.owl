    <!-- http://purl.obolibrary.org/obo/HP_0004878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001324"/>
