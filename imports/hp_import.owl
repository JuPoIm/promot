        <oboInOwl:hasDbXref>UMLS:C0162292</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0162674</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CPEO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic progressive external ophthalmoplegia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ophthalmoplegia externa</oboInOwl:hasExactSynonym>
